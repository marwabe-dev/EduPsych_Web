@model EduPsych_Web.Models.Parent

@{
    Layout = "_Layout";
    ViewData["Title"] = "لوحة تحكم ولي الأمر";
}

<link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;900&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.2/font/bootstrap-icons.min.css">

<style>
    :root {
        --brand-teal: #1eb2a6;
        --brand-dark: #0f172a;
        --brand-orange: #f97316;
    }

    body {
        background-color: #f8fafc;
        font-family: 'Cairo', sans-serif;
    }

    /* تنسيق الكروت */
    .modern-card {
        border: none;
        border-radius: 24px;
        background: #ffffff;
        box-shadow: 0 15px 35px rgba(0,0,0,0.05);
        overflow: hidden;
    }

    .header-gradient {
        background: linear-gradient(135deg, #f0fdfa 0%, #e6f7f6 100%);
        padding: 2.5rem;
    }

    .btn-connect {
        background: var(--brand-teal);
        color: white;
        border-radius: 15px;
        padding: 12px;
        font-weight: 700;
        transition: 0.3s;
        border: none;
    }

        .btn-connect:hover {
            background: #149187;
            color: white;
            transform: translateY(-2px);
        }

    .student-info-box {
        background: var(--brand-dark);
        color: white;
        border-radius: 20px;
        padding: 20px;
        margin-top: -30px;
        position: relative;
        z-index: 2;
    }
</style>

<div class="container py-5 mt-lg-4" dir="rtl">

    @if (Model.student_id == null)
    {
        @* --- الحالة الأولى: لم يتم ربط ابن بعد (عرض نموذج الربط) --- *@
        <div class="row justify-content-center">
            <div class="col-md-6 col-lg-5">
                <div class="card modern-card">
                    <div class="header-gradient text-center">
                        <div class="icon-wrapper mb-3">
                            <i class="bi bi-person-badge-fill fs-1 text-teal" style="color: var(--brand-teal)"></i>
                        </div>
                        <h3 class="fw-900 text-dark">ربط حساب الابن</h3>
                        <p class="text-muted small">يرجى إدخال البريد الإلكتروني الخاص بابنك للمتابعة</p>
                    </div>

                    <div class="card-body p-4 p-lg-5 pt-0">
                        @if (TempData["Error"] != null)
                        {
                            <div class="alert alert-danger border-0 rounded-4 mb-4 small fw-bold">
                                <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["Error"]
                            </div>
                        }

                        <form asp-action="LinkStudentByEmail" asp-controller="Parent" method="post">
                            @Html.AntiForgeryToken()
                            <div class="mb-4">
                                <label class="form-label text-dark fw-bold small">بريد الابن الإلكتروني</label>
                                <div class="position-relative">
                                    <i class="bi bi-envelope text-muted position-absolute" style="top: 12px; right: 15px;"></i>
                                    <input type="email" name="studentEmail" class="form-control rounded-4 ps-3 pe-5"
                                           style="padding: 12px" placeholder="example@test.com" required>
                                </div>
                            </div>
                            <button type="submit" class="btn btn-connect w-100 shadow-lg">
                                <i class="bi bi-link-45deg fs-5"></i> تفعيل المتابعة الآن
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        @* --- الحالة الثانية: تم الربط بنجاح (عرض لوحة المتابعة) --- *@
        <div class="row justify-content-center">
            <div class="col-lg-10">
                
                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success border-0 rounded-4 mb-4 fw-bold text-center">
                        <i class="bi bi-check-circle-fill me-2"></i> @TempData["Success"]
                    </div>
                }

                <div class="modern-card">
                    <div class="header-gradient">
                        <h2 class="fw-900 text-dark mb-0">لوحة المتابعة التربوية</h2>
                        <p class="text-muted">مرحباً بك، يمكنك الآن مراقبة أداء ابنك وجلساته الاستشارية.</p>
                    </div>
                    
                    <div class="container px-4">
                        <div class="student-info-box shadow-lg d-flex align-items-center justify-content-between flex-wrap gap-3">
                            <div class="d-flex align-items-center">
                                <div class="avatar bg-white text-teal rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 60px; height: 60px;">
                                    <i class="bi bi-person-fill fs-2" style="color: var(--brand-teal)"></i>
                                </div>
                                <div>
                                    <h4 class="mb-0 fw-bold">@Model.Student?.User?.first_name @Model.Student?.User?.last_name</h4>
                                    <span class="opacity-75 small">طالب مسجل في المنصة</span>
                                </div>
                            </div>
                            <div class="text-md-end">
                                <div class="small opacity-75">البريد الإلكتروني للابن:</div>
                                <div class="fw-bold">@Model.Student?.User?.email</div>
                            </div>
                        </div>

                        <div class="row g-4 py-5">
                            <div class="col-md-6">
                                <div class="p-4 border rounded-4 bg-light text-center">
                                    <i class="bi bi-journal-text display-5 text-teal mb-3" style="color: var(--brand-teal)"></i>
                                    <h5>النتائج الدراسية</h5>
                                    <p class="text-muted small">سيتم عرض نتائج الامتحانات والتقارير الدورية هنا.</p>
                                    <button class="btn btn-outline-dark btn-sm rounded-pill px-4">قريباً</button>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="p-4 border rounded-4 bg-light text-center">
                                    <i class="bi bi-chat-heart display-5 text-orange" style="color: var(--brand-orange)"></i>
                                    <h5>الجلسات الاستشارية</h5>
                                    <p class="text-muted small">تابع مواعيد الجلسات النفسية التي حضرها ابنك.</p>
                                    <button class="btn btn-outline-dark btn-sm rounded-pill px-4">عرض السجل</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                
                <div class="text-center mt-4">
                    <form asp-action="LinkStudentByEmail" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="studentEmail" value="" />
                        <button type="submit" class="btn btn-link text-muted text-decoration-none small">
                            <i class="bi bi-arrow-repeat"></i> تغيير حساب الابن المرتبط
                        </button>
                    </form>
                </div>

            </div>
        </div>
    }
</div>