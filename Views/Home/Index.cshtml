@{
    ViewData["Title"] = "EducPsycho - المنصة الأولى للتعليم والدعم النفسي";
}

<link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;700;900&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.2/font/bootstrap-icons.min.css">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" />
<script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>

<div class="container-fluid p-0" dir="rtl">
    <section class="hero-luxury">
        <div class="container hero-container">
        
            <div class="hero-text-side">
                <span class="platform-brand">EducPsycho</span>
                <div class="audience-badges">
                    <span class="badge-item"><i class="bi bi-mortarboard"></i> للتلاميذ</span>
                    <span class="badge-item"><i class="bi bi-person-workspace"></i> للأساتذة</span>
                    <span class="badge-item"><i class="bi bi-shield-check"></i> للأولياء</span>
                </div>
                <h1 class="hero-title">
                    المنصة الأولى في الجزائر <br>
                    التي تجمع بين <span class="highlight">التعليم ذو جودة عالية </span> و <span class="highlight">الدعم النفسي</span>
                </h1>
                <p>
                    تحت إشراف أساتذة ذوي خبرة وخريجي المدرسة العليا للأساتذة، ومجموعة من الأخصائيين النفسيين المختارين بعناية. ابدأ رحلتك الآن بالتسجيل في المنصة.
                </p>
                <div class="cta-group">
                    <a asp-controller="Account" asp-action="Register" class="btn-register-now">
                        ابدأ الآن - سجل مجاناً
                    </a>
                </div>
            </div>

            <div class="hero-image-side">
                <img src="/images/hero-educ.jpg" class="main-hero-img" alt="EducPsycho Illustration" />
            </div>

        </div>
    </section>
    

    <section class="unified-dz-section">
        <div class="container">
            <div class="unified-header">
                <span class="level-badge">من أولى ثانوي إلى البكالوريا</span>
                <h2 class="unified-title">رفيقك من <span class="highlight-dark">أول خطوة</span> حتى حلم الجامعة</h2>
            </div>

            <div class="flow-list-container">
                <div class="unified-item turquoise-card" style="--i: 1">
                    <div class="item-icon-white"><i class="bi bi-compass"></i></div>
                    <div class="item-text">
                        <h3>بناء القاعدة (1 و 2 ثانوي)</h3>
                        <p>نتجاوز معاً عقبة التشتت الدراسي ونبني أساساً علمياً متيناً يمهد لك طريق التخصص بنجاح.</p>
                    </div>
                </div>

                <div class="unified-item turquoise-card" style="--i: 2">
                    <div class="item-icon-white"><i class="bi bi-mortarboard-fill"></i></div>
                    <div class="item-text">
                        <h3>تحدي البكالوريا (3 ثانوي)</h3>
                        <p> دروس منهجية مركزة من أساتذة ENS تضمن لك استغلال كل دقيقة في المراجعة.</p>
                    </div>
                </div>

                <div class="unified-item turquoise-card" style="--i: 3">
                    <div class="item-icon-white"><i class="bi bi-heart-pulse-fill"></i></div>
                    <div class="item-text">
                        <h3>الصحة النفسية والإرادة</h3>
                        <p>نتحرر من القلق والتوتر ببرامج تحفيزية وعلاجية تعيد لك شغفك وتقوي عزيمتك للوصول لهدفك.</p>
                    </div>
                </div>

                <div class="unified-item turquoise-card" style="--i: 4">
                    <div class="item-icon-white"><i class="bi bi-clock-history"></i></div>
                    <div class="item-text">
                        <h3>إدارة الوقت والمنهجية</h3>
                        <p>نتعلم أسرار تنظيم الوقت وكيفية الإجابة النموذجية التي يبحث عنها المصحح في شهادة البكالوريا.</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="pro-community-section">
        <div class="container">
            <div class="pro-grid-layout">
            
                <div class="pro-text-box">
                    <div class="mini-label">شراكة النجاح</div>
                    <h2 class="pro-main-heading">كن جزءاً من <span class="cyan-gradient-text">عائلة EducPsycho</span></h2>
                    <p class="pro-description">
                        ترحب أول منصة تعليمية-نفسية في الجزائر بالأساتذة المتميزين والمستشارين النفسيين للانضمام إليها كموظفين. معنا، تساهم في بناء منظومة تعليمية متكاملة تضع جودة التعلم والصحة النفسية في المقام الأول.
                    </p>
                
                    <ul class="pro-features-list">
                        <li><i class="bi bi-rocket-takeoff-fill"></i> منصة تقنية هي الأحدث والأسهل استخداماً</li>
                        <li><i class="bi bi-people-fill"></i> مجتمع تعليمي متكامل يجمع آلاف التلاميذ</li>
                        <li><i class="bi bi-patch-check-fill"></i> بيئة عمل احترافية تقدّر خبرتك وتدعم إبداعك</li>
                    </ul>

                    <div class="pro-btn-wrapper">
                        <a href="#" class="apply-glow-btn">التحق بالطاقم الآن <i class="bi bi-chevron-left"></i></a>
                    </div>
                </div>

                <div class="pro-visual-box">
                    <div class="floating-circle main-circle">
                        <div class="circle-icon"><i class="bi bi-briefcase-fill"></i></div>
                        <span>للأساتذة</span>
                    </div>
                    <div class="floating-circle sub-circle">
                        <div class="circle-icon"><i class="bi bi-heart-pulse-fill"></i></div>
                        <span>للمرشدين النفسيين</span>
                    </div>
                    <div class="decoration-dots"></div>
                </div>

            </div>
        </div>
    </section>

    <section class="elite-section">
        <div class="features-header text-center">
            <h3 class="elite-main-title">نخبة <span class="text-turquoise">الأساتذة والمختصين النفسيين </span></h3>
            <p class="elite-sub-title">نخبة الكفاءات الجزائرية بين يديك</p>
        </div>

        <div class="swiper elite-swiper">
            <div class="swiper-wrapper" id="expertsWrapper">
            </div>
            <div class="swiper-pagination"></div>
        </div>
    </section>
    <section class="review-section-wrapper">
        <div class="container">
            <div class="review-header-action mb-4">
                <button class="btn-review-outline" onclick="openReviewModal()">
                    <i class="bi bi-plus-lg me-2"></i> أضف تقييمك
                </button>
               
            </div>

            <div class="glass-review-card shadow-sm">
                <div class="card-top-row mb-4">
                    <div class="user-info-area">
                        <div class="user-avatar-wrapper">
                            <div class="avatar-ring"><span class="user-initials" id="revInitials">ZA</span></div>
                            <div class="verified-badge"><i class="bi bi-star-fill"></i></div>
                        </div>
                        <div class="user-text-stars ms-3 text-end">
                            <h6 class="blurred-text mb-1" id="revName">اسم المستخدم</h6>
                            <p class="small text-muted mb-2" id="revDate">17 أبريل 2026</p>
                            <div class="stars-rating text-turquoise" id="revStars">
                            </div>
                        </div>
                    </div>
                    <div class="rating-badge-xl">
                        <h1 class="mb-0" id="revNumber">5</h1>
                        <p class="mb-0 small">من 5</p>
                    </div>
                </div>
                <hr class="opacity-25 mb-4">
                <div class="review-text-content mb-5 text-end">
                    <h5 class="fw-bold text-dark" id="revText">"تجربة رائعة"</h5>
                </div>
                <div class="card-footer-navigation">
                    <div class="pagination-dots" id="revDots">
                    </div>
                    <div class="navigation-arrows d-flex gap-2">
                        <button class="nav-arrow-btn" onclick="prevReview()"><i class="bi bi-chevron-right"></i></button>
                        <button class="nav-arrow-btn" onclick="nextReview()"><i class="bi bi-chevron-left"></i></button>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <div id="addReviewModal" class="custom-modal" style="display:none;">
        <div class="modal-content text-end">
            <h4>أضف رأيك الخاص</h4>
            <input type="text" id="newUserName" placeholder="اسمك الكامل" class="form-control mb-2">
            <textarea id="newUserReview" placeholder="اكتب تجربتك هنا..." class="form-control mb-2"></textarea>
            <select id="newUserRating" class="form-control mb-3">
                <option value="5">5 نجوم</option>
                <option value="4">4 نجوم</option>
                <option value="3">3 نجوم</option>
            </select>
            <div class="d-flex gap-2">
                <button onclick="submitReview()" class="btn-review-solid w-100">نشر التقييم</button>
                <button onclick="closeReviewModal()" class="btn-review-outline w-100">إلغاء</button>
            </div>
        </div>
    </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>

<script>
    // مصفوفة البيانات كما هي
    const experts = [
    ["علي", "بن عيسى", "الرياضيات", "male", 5],
    ["سارة", "حداد", "الفيزياء", "female", 4],
    ["يوسف", "قاسم", "علوم الحياة", "male", 5],
    ["سارة", "محمد", "صعوبات التعلم", "female", 5],
    ["يوسف", "كريم", "تطوير الذات", "male", 5]
    ];

    function generateStars(rating) {
    let stars = '';
    for (let i = 1; i <= 5; i++) {
    stars += i <= rating ? '<i class="bi bi-star-fill"></i>' : '<i class="bi bi-star"></i>';
    }
    return stars;
    }

    document.addEventListener("DOMContentLoaded", () => {
    const wrapper = document.getElementById("expertsWrapper");
        
    experts.forEach((e, i) => {
    const slide = document.createElement("div");
    slide.className = "swiper-slide";
            
    // تغيير رابط الصور لمصدر أكثر وقاراً وهدوءاً (UI Avatars أو الصور الرسمية)
    // الرابط الجديد يعطي صوراً بملامح جادة ومناسبة للتعليم
    const imageUrl = `https://xsgames.co/randomusers/assets/avatars/${e[3]}/${i + 10}.jpg`;

    slide.innerHTML = `
    <div class="expert-circle-item">
    <div class="expert-avatar-wrapper">
    <img src="${imageUrl}" class="expert-img-circle" alt="Expert">
    </div>
    <div class="expert-details">
    <div class="expert-rating">${generateStars(e[4])}</div>
    <h5 class="expert-name">${e[0]} ${e[1]}</h5>
    <span class="expert-specialty">${e[2]}</span>
    </div>
    </div>`;
    wrapper.appendChild(slide);
    });

    // تحديث إعدادات Swiper لتقليص المسافات وزيادة العناصر المعروضة
    new Swiper(".elite-swiper", {
    slidesPerView: 2,      // إظهار عنصرين في الجوال بدلاً من واحد لتقليل الفراغ
    spaceBetween: 10,     // تقليل المسافة بين الكروت
    loop: true,
    autoplay: { delay: 3000 },
    pagination: { el: ".swiper-pagination", clickable: true },
    breakpoints: {
    640: { slidesPerView: 3, spaceBetween: 15 },
    1024: { slidesPerView: 4, spaceBetween: 20 },
    1400: { slidesPerView: 6, spaceBetween: 20 } // عرض عناصر أكثر في الشاشات الكبيرة
    }
    });
    });




    // 1. مصفوفة التقييمات الأولية
    let allReviews = [
    { name: "أحمد بن علي", text: "المنصة غيرت طريقتي في الدراسة تماماً، الأساتذة قمة في الاحترافية.", rating: 5, date: "15 أبريل 2026", initials: "أب" },
    { name: "سارة محمود", text: "شكراً EducPsycho على الدعم النفسي قبل الامتحانات، شعرت براحة كبيرة.", rating: 5, date: "10 أبريل 2026", initials: "سم" },
    { name: "ياسين جبار", text: "تنظيم الوقت كان أكبر عائق لي، وبفضل المرشدين وجدت طريقي الصحيح.", rating: 4, date: "05 أبريل 2026", initials: "يج" }
    ];

    let currentReviewIndex = 0;

    // 2. دالة عرض التقييم الحالي
    function displayReview() {
    const rev = allReviews[currentReviewIndex];
    document.getElementById('revName').innerText = rev.name;
    document.getElementById('revText').innerText = `"${rev.text}"`;
    document.getElementById('revNumber').innerText = rev.rating;
    document.getElementById('revDate').innerText = rev.date;
    document.getElementById('revInitials').innerText = rev.initials;
    
    // توليد النجوم
    let starsHtml = "";
    for(let i=0; i<5; i++) {
    starsHtml += i < rev.rating ? '<i class="bi bi-star-fill"></i>' : '<i class="bi bi-star"></i>';
    }
    document.getElementById('revStars').innerHTML = starsHtml;

    // تحديث النقاط (Dots)
    updateDots();
    }

    function updateDots() {
    let dotsHtml = "";
    allReviews.forEach((_, index) => {
    dotsHtml += `<span class="dot ${index === currentReviewIndex ? 'active' : ''}"></span>`;
    });
    document.getElementById('revDots').innerHTML = dotsHtml;
    }

    // 3. وظائف التنقل
    function nextReview() {
    currentReviewIndex = (currentReviewIndex + 1) % allReviews.length;
    displayReview();
    }

    function prevReview() {
    currentReviewIndex = (currentReviewIndex - 1 + allReviews.length) % allReviews.length;
    displayReview();
    }

    // 4. وظائف إضافة تقييم جديد
    function openReviewModal() { document.getElementById('addReviewModal').style.display = 'flex'; }
    function closeReviewModal() { document.getElementById('addReviewModal').style.display = 'none'; }

    function submitReview() {
    const name = document.getElementById('newUserName').value;
    const text = document.getElementById('newUserReview').value;
    const rating = document.getElementById('newUserRating').value;
    
    if(name && text) {
    const initials = name.split(" ").map(n => n[0]).join("").toUpperCase();
    const newEntry = {
    name: name,
    text: text,
    rating: parseInt(rating),
    date: "اليوم",
    initials: initials
    };
        
    allReviews.unshift(newEntry); // إضافة التقييم في بداية القائمة
    currentReviewIndex = 0;
    displayReview();
    closeReviewModal();
        
    // تصفير الحقول
    document.getElementById('newUserName').value = "";
    document.getElementById('newUserReview').value = "";
    } else {
    alert("يرجى ملء جميع الحقول");
    }
    }

    // تشغيل العرض الأول عند تحميل الصفحة
    document.addEventListener("DOMContentLoaded", displayReview);
</script>