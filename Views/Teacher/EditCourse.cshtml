@model EduPsych_Web.Models.Course
@{
    ViewData["Title"] = "تعديل الدورة";
    Layout = "_TeacherLayout";
}

<div class="container mt-4 text-end" dir="rtl">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-white"><h4 class="fw-bold">تعديل بيانات الدورة</h4></div>
        <div class="card-body">
            <form asp-action="EditCourse" method="post" enctype="multipart/form-data">
                <input type="hidden" asp-for="id" />
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label">عنوان الدورة</label>
                        <input asp-for="title" class="form-control" required />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">السعر</label>
                        <input asp-for="price" class="form-control" required />
                    </div>
                    <div class="col-12 mb-3">
                        <label class="form-label">الوصف</label>
                        <textarea asp-for="description" class="form-control" rows="3"></textarea>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">تغيير الصورة</label>
                        <input type="file" name="thumbnail" class="form-control" />
                    </div>
                </div>
                <button type="submit" class="btn btn-primary">حفظ التغييرات</button>
                <a asp-action="Courses" class="btn btn-secondary">عودة</a>
            </form>
        </div>
    </div>
</div>