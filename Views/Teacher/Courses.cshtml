@model IEnumerable<EduPsych_Web.Models.Course>

@{
    ViewData["Title"] = "دوراتي المدفوعة";
    Layout = "~/Views/Shared/_TeacherLayout.cshtml";
}

<div class="container mt-4 text-end" dir="rtl">
    @* عرض رسائل النجاح أو الخطأ *@
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold" style="color: #1eb2a6;">دوراتي التعليمية</h2>
        <a asp-action="CreateCourse" class="btn btn-success rounded-pill px-4">
            <i class="bi bi-plus-circle me-1"></i> إضافة دورة جديدة
        </a>
    </div>

    <div class="row">
        @if (!Model.Any())
        {
            <div class="col-12 text-center py-5">
                <i class="bi bi-journal-x display-1 text-muted"></i>
                <p class="mt-3 text-muted">لم تقم بإضافة أي دورات مدفوعة بعد.</p>
            </div>
        }
        else
        {
            @foreach (var item in Model)
            {
                <div class="col-md-4 mb-4">
                    <div class="card h-100 shadow-sm border-0" style="border-radius: 15px;">
                        <img src="@(string.IsNullOrEmpty(item.thumbnail_url) ? "/images/default-course.jpg" : item.thumbnail_url)"
                             class="card-img-top" style="border-top-left-radius: 15px; border-top-right-radius: 15px; height: 180px; object-fit: cover;">
                        
                        <div class="card-body d-flex flex-column">
                            <div class="mb-2">
                                <span class="badge bg-info bg-opacity-10 text-info px-3 py-2">@item.Subject?.name</span>
                            </div>
                            <h5 class="card-title fw-bold">@item.title</h5>
                            <p class="card-text text-muted small flex-grow-1">
                                @(item.description?.Length > 100 ? item.description.Substring(0, 100) + "..." : item.description)
                            </p>
                            
                            <div class="mt-3 pt-3 border-top">
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <span class="fw-bold text-success fs-5">@item.price دج</span>
                                </div>
                                
                                <div class="btn-group w-100">
                                    @* الزر الجديد لعرض المشتركين *@
                                    <button type="button" class="btn btn-sm btn-outline-success" 
                                            data-bs-toggle="modal" data-bs-target="#studentsModal_@item.id">
                                        <i class="bi bi-people"></i> المشتركون
                                    </button>

                                    <a asp-action="EditCourse" asp-route-id="@item.id" class="btn btn-sm btn-outline-primary">
                                        <i class="bi bi-pencil"></i> تعديل
                                    </a>
                                    
                                    <form asp-action="DeleteCourse" asp-route-id="@item.id" method="post" 
                                          onsubmit="return confirm('هل أنت متأكد من حذف هذه الدورة نهائياً؟');" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger" style="border-top-right-radius: 0; border-bottom-right-radius: 0;">
                                            <i class="bi bi-trash"></i> حذف
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="modal fade text-end" id="studentsModal_@item.id" tabindex="-1" aria-hidden="true">
                    <div class="modal-dialog modal-dialog-centered modal-lg">
                        <div class="modal-content rounded-4 border-0 shadow">
                            <div class="modal-header border-bottom-0 py-3">
                                <h5 class="modal-title fw-bold">الطلاب المشتركون في: @item.title</h5>
                                <button type="button" class="btn-close ms-0 me-auto" data-bs-dismiss="modal" aria-label="Close"></button>
                            </div>
                            <div class="modal-body p-0">
                                <div class="table-responsive">
                                    <table class="table table-hover align-middle mb-0 text-center">
                                        <thead class="bg-light">
                                            <tr>
                                                <th class="px-4">اسم الطالب</th>
                                                <th>تاريخ الشراء</th>
                                                <th>حصة الأستاذ</th>
                                                <th>الحالة</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @{
                                                var enrollments = (ViewBag.AllEnrollments as List<EduPsych_Web.Models.CourseEnrollment>)
                                                                  ?.Where(e => e.course_id == item.id).ToList();
                                            }

                                            @if (enrollments != null && enrollments.Any())
                                            {
                                                @foreach (var enrollment in enrollments)
                                                {
                                                    <tr>
                                                        <td class="px-4">@enrollment.Student?.User?.first_name @enrollment.Student?.User?.last_name</td>
                                                        <td>@enrollment.enrolled_at.ToString("yyyy/MM/dd")</td>
                                                        <td class="fw-bold text-success">@enrollment.teacher_commission دج</td>
                                                        <td><span class="badge bg-success-subtle text-success border border-success-subtle">تم الدفع</span></td>
                                                    </tr>
                                                }
                                            }
                                            else
                                            {
                                                <tr>
                                                    <td colspan="4" class="text-center py-5 text-muted">
                                                        <i class="bi bi-person-x fs-1 d-block mb-2"></i>
                                                        لا يوجد مشتركون في هذه الدورة بعد.
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>

<style>
    .btn-turquoise {
        background-color: #1eb2a6;
        border-color: #1eb2a6;
    }
    .btn-turquoise:hover {
        background-color: #14837a;
        border-color: #14837a;
    }
    .card {
        transition: transform 0.3s ease;
    }
    .card:hover {
        transform: translateY(-5px);
    }
    /* توحيد أزرار المجموعة */
    .btn-group .btn {
        padding: 8px 5px;
        font-size: 0.85rem;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 5px;
    }
    /* تحسين شكل الـ Modal */
    .modal-content {
        overflow: hidden;
    }
    .bg-success-subtle {
        background-color: #d1e7dd;
    }
</style>