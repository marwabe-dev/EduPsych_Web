@model IEnumerable<EduPsych_Web.Models.Lesson>
@{
    ViewData["Title"] = "المكتبة المجانية";
    Layout = "~/Views/Shared/_TeacherLayout.cshtml";
}

<div class="container py-4 text-end" dir="rtl">
    <div class="compact-header d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold mb-0" style="color: #0f172a">المكتبة المجانية</h4>
            <p class="text-muted mb-0 small">أنشر الدروس والتمارين مع إضافة صور غلاف حقيقية لها.</p>
        </div>
        <button class="btn btn-primary rounded-pill px-4 fw-bold" data-bs-toggle="modal" data-bs-target="#createLessonModal" style="background: #1eb2a6; border: none;">
            <i class="bi bi-plus-lg ms-1"></i> إضافة محتوى جديد
        </button>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success border-0 shadow-sm mb-4">@TempData["Success"]</div>
    }

    <div class="row g-3">
        @foreach (var item in Model)
        {
            @* 🟢 هنا تم إضافة الفلتر لتخطي الحصص المباشرة المجدولة من الـ Layout *@
            if (item.description == "حصة بث مباشر مجدولة للحجز المباشر")
            {
                continue;
            }

            <div class="col-xl-3 col-lg-4 col-md-6">
                <div class="card h-100 shadow-sm border-0" style="border-radius: 18px; overflow: hidden;">
                    <img src="@(string.IsNullOrEmpty(item.video_url) ? "/uploads/pdf/default_cover.jpg" : item.video_url)" class="card-img-top" style="height: 140px; object-fit: cover;" alt="غلاف المحتوى" />
                    
                    <div class="card-body">
                        <div class="mb-2">
                            <span class="badge bg-light text-secondary">@item.Subject?.name</span>
                            <span class="badge bg-light text-secondary">@item.Class?.name</span>
                        </div>
                        <h6 class="fw-bold text-dark">@item.title</h6>
                        <p class="text-muted small">@item.description</p>
                    </div>

                    <div class="card-footer bg-white border-0 p-3">
                        <button type="button" class="btn btn-sm btn-light w-100 fw-bold mb-2 border" data-bs-toggle="modal" data-bs-target="#editLessonModal_@item.id">
                            <i class="bi bi-pencil-square ms-1"></i> تعديل البيانات
                        </button>

                        <form asp-action="DeleteLesson" asp-route-id="@item.id" method="post" onsubmit="return confirm('هل أنت متأكد من الحذف؟');">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-outline-danger w-100 fw-bold">حذف المنشور</button>
                        </form>
                    </div>
                </div>
            </div>
            
            @* 🛠️ مودال تعديل البيانات المصحح ليعمل بنجاح ويحمل الـ ID التابع له *@
            <div class="modal fade" id="editLessonModal_@item.id" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered modal-sm">
                    <div class="modal-content border-0 rounded-4 shadow text-end">
                        <div class="modal-header border-0 bg-light p-3">
                            <h6 class="fw-bold m-0 text-dark">تعديل المحتوى الدراسي</h6>
                            <button type="button" class="btn-close ms-0 me-auto" data-bs-dismiss="modal"></button>
                        </div>
                        <form asp-action="EditLesson" asp-controller="Teacher" method="post">
                            @Html.AntiForgeryToken()
                            <div class="modal-body p-3">
                                <input type="hidden" name="id" value="@item.id" />
                                <div class="mb-2">
                                    <label class="form-label small fw-bold">العنوان المعدل</label>
                                    <input type="text" name="title" value="@item.title" class="form-control form-control-sm" required />
                                </div>
                                <div class="mb-3">
                                    <label class="form-label small fw-bold">الوصف المعدل</label>
                                    <textarea name="description" class="form-control form-control-sm" rows="2">@item.description</textarea>
                                </div>
                                <button type="submit" class="btn btn-primary w-100 py-2" style="background-color: #1eb2a6; border: none;">حفظ التغييرات الآن</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@* مودال إضافة محتوى جديد مع حقل الغلاف الحقيقي *@
<div class="modal fade" id="createLessonModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 rounded-4 shadow text-end">
            <div class="modal-header border-0 bg-dark text-white p-3">
                <h6 class="fw-bold m-0">إضافة محتوى جديد للمكتبة</h6>
                <button type="button" class="btn-close btn-close-white ms-0 me-auto" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="AddContent" asp-controller="Teacher" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <div class="modal-body p-3">
                    <div class="row g-2 mb-2">
                        <div class="col-6">
                            <label class="form-label small fw-bold">المادة</label>
                            <select name="subjectId" class="form-select form-select-sm" asp-items="ViewBag.subject_id" required>
                                <option value="">-- اختر المادة --</option>
                            </select>
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-bold">الصف الدراسي</label>
                            <select name="classId" class="form-select form-select-sm" asp-items="ViewBag.class_id" required>
                                <option value="">-- اختر الصف --</option>
                            </select>
                        </div>
                    </div>

                    <div class="mb-2">
                        <label class="form-label small fw-bold" style="color: #1eb2a6">تصنيف المحتوى</label>
                        <select name="contentType" class="form-select form-select-sm fw-bold" required>
                            <option value="Lesson">📖 درس مسجل</option>
                            <option value="Exercise">✏️ تمرين وسلسلة دعم</option>
                            <option value="Exam">📝 نموذج فرض أو اختبار</option>
                        </select>
                    </div>

                    <div class="mb-2">
                        <label class="form-label small fw-bold">العنوان</label>
                        <input type="text" name="title" class="form-control form-control-sm" required />
                    </div>
                    
                    <div class="mb-2">
                        <label class="form-label small fw-bold">الوصف</label>
                        <textarea name="description" class="form-control form-control-sm" rows="2"></textarea>
                    </div>

                    @* 💡 الحقل الجديد لرفع صورة الغلاف الحقيقية للدرس *@
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-success"><i class="bi bi-image"></i> صورة غلاف المنشور (PNG/JPG)</label>
                        <input type="file" name="coverImage" class="form-control form-control-sm" accept="image/*" />
                    </div>
                    
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-danger"><i class="bi bi-file-pdf-fill"></i> ملف المحتوى (PDF)</label>
                        <input type="file" name="pdfFile" class="form-control form-control-sm" accept=".pdf" required />
                    </div>
                    
                    <button type="submit" class="btn btn-primary w-100 py-2" style="background-color: #1eb2a6; border: none; font-weight: bold;">نشر المحتوى الآن</button>
                </div>
            </form>
        </div>
    </div>
</div>