@using Microsoft.AspNetCore.Http
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - منصة رافقني</title>

    <link rel="preload" as="image" href='@Url.Content("~/images/ReactNativeBlobUtilTmp_y5mahsvc363ohu7dec7hm.jpeg")' />

    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght=300;400;500;600;700;800;900&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght=600;700;800;900&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.rtl.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <style>
        :root {
            --primary-teal: #1eb2a6;
            --dark-teal: #0c3336; 
            --glass-bg: rgba(255, 255, 255, 0.35); 
            --glass-border: rgba(255, 255, 255, 0.55);
        }

        * {
            font-family: 'Cairo', sans-serif;
            box-sizing: border-box;
        }

        body {
            background: linear-gradient(rgba(255, 255, 255, 0.15), rgba(12, 51, 54, 0.3)), url('@Url.Content("~/images/ReactNativeBlobUtilTmp_y5mahsvc363ohu7dec7hm.jpeg")');
            background-size: cover;
            background-position: center;
            background-repeat: no-repeat;
            background-attachment: fixed;
            min-height: 100vh;
            margin: 0;
            padding: 0;
            overflow-x: hidden;
            color: var(--dark-teal);
        }

        /* الهيدر الفخم المدمج */
        .edu-header {
            background: rgba(255, 255, 255, 0.65); 
            backdrop-filter: blur(25px);
            -webkit-backdrop-filter: blur(25px);
            border: 1px solid var(--glass-border);
            padding: 10px 18px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            position: sticky;
            top: 10px;
            margin: 10px auto 20px;
            max-width: 1400px;
            width: calc(100% - 30px);
            z-index: 1050;
            border-radius: 50px;
            box-shadow: 0 6px 24px rgba(12, 51, 54, 0.06);
            transition: all 0.4s ease;
        }

        .brand-logo-text {
            font-family: 'Poppins', sans-serif;
            font-weight: 900;
            font-size: 1.6rem;
            background: linear-gradient(135deg, var(--dark-teal), #1eb2a6);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            position: relative;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-left: 10px;
        }

        .brand-logo-text .cap-icon {
            position: absolute;
            top: -3px;
            right: -4px;
            color: #1eb2a6;
            font-size: 0.7rem;
        }

        .platform-title {
            color: var(--dark-teal);
            font-weight: 800;
            font-size: 1.05rem !important;
        }

        .edu-header .btn {
            background: rgba(255, 255, 255, 0.5);
            border: 1px solid rgba(12, 51, 54, 0.08);
            color: var(--dark-teal) !important;
            border-radius: 40px;
            padding: 7px 14px;
            font-size: 0.82rem;
            font-weight: 700;
            transition: .3s;
            white-space: nowrap;
        }

        .edu-header .btn:hover {
            background: var(--primary-teal);
            border-color: var(--primary-teal);
            color: white !important;
            transform: translateY(-2px);
        }

        .profile-dropdown-container {
            position: relative;
        }

        .profile-btn {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.7);
            border: 1px solid rgba(12, 51, 54, 0.08);
            cursor: pointer;
            outline: none;
        }

        /* 🛠️ التعديل السحري: جعل القائمة تبدأ من اليسار (left: 0) وتتجه للداخل لتظهر كاملة */
        .edu-header .custom-logout-menu {
            position: absolute !important;
            top: 100% !important;
            left: 0 !important; /* محاذاة لليسار لتظهر داخل نطاق الشاشة الهيدر بالكامل */
            right: auto !important; 
            z-index: 999999 !important;
            background: rgba(255, 255, 255, 0.98) !important;
            border: 1px solid rgba(12, 51, 54, 0.15) !important;
            border-radius: 12px !important;
            min-width: 160px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.18) !important;
            padding: 6px 0 !important;
            margin-top: 10px !important;
            display: none; 
        }

        .edu-header .custom-logout-menu.show-menu {
            display: block !important;
        }

        .edu-header .dropdown-item {
            font-size: 0.9rem !important;
            color: #dc3545 !important;
            font-weight: 700;
            padding: 10px 16px !important;
            text-decoration: none;
            display: flex;
            align-items: center;
            justify-content: flex-start;
            transition: all 0.2s ease;
        }

        .edu-header .dropdown-item:hover {
            background-color: rgba(220, 53, 69, 0.08) !important;
        }

        /* المحتوى الرئيسي للمنصة والكروت */
        .main-student-content {
            padding-bottom: 70px;
            transition: all 0.4s ease;
            width: 100%;
            padding-right: 20px !important;
            padding-left: 20px !important;
        }

        .main-student-content .card,
        .main-student-content div[class*="card"],
        .main-student-content .stream-card,
        .main-student-content .glass-card,
        .main-student-content .session-card-pro,
        .main-student-content .session-creative-card {
            background: var(--glass-bg) !important; 
            backdrop-filter: blur(25px) !important; 
            -webkit-backdrop-filter: blur(25px) !important;
            border: 1px solid var(--glass-border) !important;
            box-shadow: 0 8px 28px rgba(12, 51, 54, 0.04) !important;
            border-radius: 18px !important;
            transition: all 0.3s ease;
            padding: 12px 14px !important;
            margin-bottom: 12px !important;
        }

        .main-student-content h1, .main-student-content h2, .main-student-content h3, 
        .main-student-content h4, .main-student-content h5, .main-student-content h6, 
        .main-student-content th, .main-student-content td, .main-student-content p,
        .main-student-content span, .main-student-content div {
            color: var(--dark-teal) !important;
            font-weight: 700;
            text-shadow: 0 1px 2px rgba(255, 255, 255, 0.3);
        }

        /* نافذة المساعد الذكي */
        #ai-sidebar {
            position: fixed;
            top: 20px;
            left: -450px;
            width: 400px;
            height: calc(100vh - 40px);
            background: rgba(255, 255, 255, 0.92);
            backdrop-filter: blur(30px);
            -webkit-backdrop-filter: blur(30px);
            z-index: 9999;
            transition: width 0.4s ease, left 0.4s cubic-bezier(0.05, 0.74, 0.2, 0.99);
            display: flex;
            flex-direction: column;
            box-shadow: -12px 0 35px rgba(12, 51, 54, 0.08);
            border: 1px solid var(--glass-border);
            border-radius: 26px;
        }

        .ai-bubble {
            padding: 11px 15px;
            border-radius: 18px;
            max-width: 88%;
            font-size: 0.93rem;
            line-height: 1.65;
            font-weight: 600;
        }
        .bubble-user {
            background: linear-gradient(135deg, var(--primary-teal) 0%, #148f85 100%);
            color: white !important;
            align-self: flex-end;
            border-bottom-left-radius: 5px;
        }
        .bubble-ai {
            background: white;
            color: var(--dark-teal) !important;
            align-self: flex-start;
            border-bottom-right-radius: 5px;
            border: 1px solid rgba(0,0,0,0.06);
        }
    </style>
    
    @RenderSection("Styles", required: false)
</head>
<body>
    @{
        var userName = Context.Session.GetString("UserName") ?? "تلميذنا العزيز";
    }

    <div class="container-fluid p-0 text-end" dir="rtl">

        <header id="edu-platform-header" class="edu-header">
            <div class="d-flex align-items-center">
                <div class="brand-logo-text">R<i class="bi bi-mortarboard-fill cap-icon"></i></div>
                <h4 class="m-0 platform-title" style="font-size:1.05rem; margin-right: 8px !important;">منصة <span style="color:#1eb2a6;">رافقني</span></h4>
            </div>

            <div class="d-flex gap-2">
                <a href="@Url.Action("Index", "Student")" class="btn">الرئيسية</a>
                <a href="@Url.Action("MyWallet", "Student")" class="btn">محفظتي</a>
                <a href="@Url.Action("Courses", "Student")" class="btn">متجر الدورات</a>
                <a href="@Url.Action("MyEducationalLessons", "Student")" class="btn">حصصي التعليمية  </a>
                <a href="@Url.Action("MyCounselSessions", "Student")" class="btn">جلساتي النفسية </a>
            </div>

            <div class="dropdown profile-dropdown-container">
                <button id="profileDropdownBtn" class="btn profile-btn d-flex align-items-center justify-content-center" type="button">
                    <i class="bi bi-person-fill" style="font-size:1.2rem; color: var(--dark-teal);"></i>
                </button>
                <ul id="profileDropdownMenu" class="custom-logout-menu">
                    <li>
                        <a class="dropdown-item" href="@Url.Action("Logout", "Account")">
                            <i class="bi bi-box-arrow-right ms-2"></i>
                            <span>تسجيل الخروج</span>
                        </a>
                    </li>
                </ul>
            </div>
        </header>

        <main id="main-student-area" class="main-student-content">
            <div class="container-fluid px-3">
                @RenderBody()
            </div>
        </main>

    </div>

    <div id="ai-chat-launcher" onclick="toggleAiSidebar()" style="position: fixed; bottom: 30px; left: 30px; background: linear-gradient(135deg, var(--dark-teal) 0%, var(--primary-teal) 100%); color: white; padding: 11px 22px; border-radius: 50px; cursor: pointer; z-index: 999; display: flex; align-items: center; gap: 10px; box-shadow: 0 8px 25px rgba(12, 51, 54, 0.2); transition: all 0.3s ease;">
        <i class="bi bi-robot fs-5"></i>
        <span class="fw-bold">اسأل رافقني</span>
    </div>

    <div id="ai-sidebar">
        <div style="background: linear-gradient(135deg, rgba(12, 51, 54, 0.92) 0%, rgba(30, 178, 166, 0.92) 100%); padding: 16px; color: white; display: flex; justify-content: space-between; align-items: center; border-top-left-radius: 24px; border-top-right-radius: 24px;">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-stars text-warning fs-5"></i>
                <div class="d-flex flex-column text-start" dir="rtl">
                    <span class="fw-bold" style="font-size: 0.95rem;">مساعد رافقني الذكي</span>
                    <small style="color: rgba(255,255,255,0.75); font-size: 10px;">متصل الآن</small>
                </div>
            </div>
            <div class="d-flex align-items-center gap-2">
                <button onclick="toggleMaximizeSidebar()" id="ai-maximize-btn" title="تكبير الشاشة" style="background:none; border:none; color:white; font-size:14px; cursor:pointer;"><i class="bi bi-arrows-fullscreen"></i></button>
                <button onclick="toggleAiSidebar()" style="background:none; border:none; color:white; font-size:22px; cursor:pointer; line-height: 1;">&times;</button>
            </div>
        </div>

        <div id="ai-chat-messages" style="flex: 1; padding: 16px; overflow-y: auto; display: flex; flex-direction: column; gap: 12px;">
            <div class="ai-bubble bubble-ai">
                أهلاً بك يا @userName 👋! كيف يمكنني مساعدتك في دروسك اليوم؟
            </div>
        </div>

        <div style="padding: 12px; border-top: 1px solid rgba(0,0,0,0.05); background: rgba(255,255,255,0.5); border-bottom-left-radius: 24px; border-bottom-right-radius: 24px;">
            <div style="background: white; border-radius: 45px; padding: 5px 7px; display: flex; align-items: center; border: 1px solid rgba(0,0,0,0.08);">
                <input type="text" id="ai-sidebar-input" placeholder="اكتب سؤالك هنا..." style="flex:1; border:none; background:none; outline:none; padding-right: 10px; font-size: 0.9rem;" onkeypress="if(event.key==='Enter') sendSidebarMessage()">
                <button onclick="sendSidebarMessage()" style="background: var(--primary-teal); color:white; border:none; width:34px; height:34px; border-radius:50%; display:flex; align-items:center; justify-content:center;"><i class="bi bi-send-fill" style="transform: rotate(180deg);"></i></button>
            </div>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bundle.min.js"></script>
    
    <script>
        // تفعيل تشغيل القائمة برمجياً والتحكم في ظهورها باتجاه الشاشة الداخلي
        document.addEventListener('DOMContentLoaded', function () {
            const dropdownBtn = document.getElementById('profileDropdownBtn');
            const dropdownMenu = document.getElementById('profileDropdownMenu');

            if (dropdownBtn && dropdownMenu) {
                dropdownBtn.addEventListener('click', function (e) {
                    e.stopPropagation(); 
                    dropdownMenu.classList.toggle('show-menu');
                });

                document.addEventListener('click', function (e) {
                    if (!dropdownBtn.contains(e.target) && !dropdownMenu.contains(e.target)) {
                        dropdownMenu.classList.remove('show-menu');
                    }
                });
            }
        });

        let isMaximized = false;
        function toggleAiSidebar() {
            const sidebar = document.getElementById('ai-sidebar');
            const launcher = document.getElementById('ai-chat-launcher');
            const mainContent = document.getElementById('main-student-area');

            if (sidebar.style.left === '20px') {
                sidebar.style.left = '-450px'; 
                launcher.style.opacity = '1';
                mainContent.classList.remove('content-pushed-global', 'content-pushed-large');
                sidebar.style.width = '400px';
                document.getElementById('ai-maximize-btn').innerHTML = '<i class="bi bi-arrows-fullscreen"></i>';
                isMaximized = false;
            } else {
                sidebar.style.left = '20px';
                launcher.style.opacity = '0';
            }
        }

        function toggleMaximizeSidebar() {
            const sidebar = document.getElementById('ai-sidebar');
            const mainContent = document.getElementById('main-student-area');
            const maxBtn = document.getElementById('ai-maximize-btn');

            if (!isMaximized) {
                sidebar.style.width = '500px';
                maxBtn.innerHTML = '<i class="bi bi-fullscreen-exit"></i>';
                isMaximized = true;
            } else {
                sidebar.style.width = '400px';
                maxBtn.innerHTML = '<i class="bi bi-arrows-fullscreen"></i>';
                isMaximized = false;
            }
        }

        async function sendSidebarMessage() {
            const input = document.getElementById('ai-sidebar-input');
            const msg = input.value.trim();
            if (!msg) return;

            appendLayoutMsg(msg, 'user');
            input.value = '';

            const loaderId = "loader-" + Date.now();
            appendLayoutMsg("جاري التفكير...", 'ai', loaderId);

            try {
                const response = await fetch('/api/ChatAi/ask', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ prompt: msg })
                });
                const data = await response.json();
                const loaderEl = document.getElementById(loaderId);
                if(loaderEl) loaderEl.remove();
                appendLayoutMsg(data.response, 'ai');
            } catch (err) {
                const loaderEl = document.getElementById(loaderId);
                if(loaderEl) loaderEl.innerText = "حدث خطأ بالاتصال.";
            }
        }

        function appendLayoutMsg(text, sender, id = null) {
            const area = document.getElementById('ai-chat-messages');
            const div = document.createElement('div');
            div.className = sender === 'user' ? "ai-bubble bubble-user" : "ai-bubble bubble-ai";
            if (id) div.id = id;
            div.innerText = text;
            area.appendChild(div);
            area.scrollTop = area.scrollHeight;
        }
    </script>

    @RenderSection("Scripts", required: false)
</body>
</html>