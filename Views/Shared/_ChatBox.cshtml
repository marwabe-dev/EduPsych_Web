<div class="chat-container shadow">
    <div class="chat-header text-white bg-turquoise">
        <span><i class="bi bi-robot"></i> مساعد رافقني الذكي</span>
    </div>
    <div id="messagesList" class="chat-messages p-3">
    </div>
    <div class="chat-input-area p-2">
        <input type="text" id="messageInput" placeholder="اسألني أي شيء عن دروسك..." class="form-control">
        <button id="sendButton" class="btn btn-turquoise"><i class="bi bi-send"></i></button>
    </div>
</div>