@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="ar" dir="rtl">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>تسجيل الدخول - EducPsycho</title>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

    <style>

        :root {
            --primary: #1eb2a6;
            --primary-dark: #0f766e;
            --white: #ffffff;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        body {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;

            background: linear-gradient(135deg,
                #dffcf8 0%,
                #8deee3 25%,
                #2cc7b8 60%,
                #0f766e 100%);
            position: relative;
            overflow: hidden;
        }

        /* خلفية ناعمة متحركة */
        .bg-circle {
            position: absolute;
            border-radius: 50%;
            filter: blur(40px);
            opacity: 0.4;
            animation: float 8s infinite ease-in-out;
        }

        .c1 {
            width: 250px;
            height: 250px;
            background: white;
            top: -80px;
            right: -80px;
        }

        .c2 {
            width: 200px;
            height: 200px;
            background: #ffffff;
            bottom: -60px;
            left: -60px;
            animation-delay: 2s;
        }

        @@keyframes float {
            0%, 100% { transform: translateY(0); }
            50% { transform: translateY(-20px); }
        }

        /* الكارد */
        .login-card {
            width: 100%;
            max-width: 460px;
            padding: 40px;
            border-radius: 35px;

            background: rgba(255, 255, 255, 0.18);
            backdrop-filter: blur(20px);

            border: 1px solid rgba(255,255,255,0.3);

            box-shadow: 0 20px 50px rgba(0,0,0,0.15);

            z-index: 10;
            text-align: center;
        }

        /* الأيقونة */
        .icon-box {
            width: 95px;
            height: 95px;
            margin: auto;
            border-radius: 28px;

            background: linear-gradient(135deg, var(--primary), var(--primary-dark));

            display: flex;
            align-items: center;
            justify-content: center;

            box-shadow: 0 15px 35px rgba(30,178,166,0.4);
            margin-bottom: 18px;
        }

        .icon-box i {
            font-size: 2.8rem;
            color: white;
        }

        /* العنوان */
        .title {
            font-size: 1.9rem;
            font-weight: 900;
            color: white;
            margin-bottom: 5px;
        }

        .subtitle {
            font-size: 0.95rem;
            color: rgba(255,255,255,0.9);
            margin-bottom: 25px;
        }

        /* الحقول */
        .form-control {
            border-radius: 16px;
            padding: 12px;
            border: none;
            background: rgba(255,255,255,0.85);
            text-align: right;
            transition: 0.3s;
        }

        .form-control:focus {
            box-shadow: 0 0 0 4px rgba(30,178,166,0.2);
            transform: translateY(-2px);
        }

        .form-label {
            font-size: 0.85rem;
            font-weight: 700;
            color: white;
        }

        /* الزر */
        .btn-login {
            background: linear-gradient(135deg, var(--primary), var(--primary-dark));
            border: none;
            color: white;
            font-weight: 900;
            border-radius: 16px;
            padding: 12px;
            transition: 0.3s;
        }

        .btn-login:hover {
            transform: translateY(-3px);
            box-shadow: 0 15px 30px rgba(30,178,166,0.4);
        }

        /* الرابط */
        .link {
            color: white;
            font-weight: 800;
            text-decoration: none;
        }

        .link:hover {
            text-decoration: underline;
        }
        @@media (max-width: 768px) {
            body {
                 overflow-y: auto;
                 padding: 20px;
             }
        }
        @@media (max-width: 768px) {
    .login-card {
        padding: 25px;
        border-radius: 25px;
    }

    .title {
        font-size: 1.6rem;
    }

    .icon-box {
        width: 80px;
        height: 80px;
    }
}



.btn-login {
    min-height: 52px;
    font-size: 1rem;
}

    </style>

</head>

<body>

    <!-- خلفية -->
    <div class="bg-circle c1"></div>
    <div class="bg-circle c2"></div>

    <!-- الكارد -->
    <div class="login-card">

        <!-- الأيقونة -->
        <div class="icon-box">
            <i class="bi bi-mortarboard-fill"></i>
        </div>

        <!-- العنوان -->
        <div class="title">مرحباً بك مجدداً</div>
        <div class="subtitle">سجّل الدخول إلى منصة EducPsycho</div>

        <!-- رسالة خطأ -->
        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger p-2 mb-3" style="border-radius:15px;">
                <i class="bi bi-exclamation-triangle-fill"></i>
                @ViewBag.Error
            </div>
        }

        <!-- الفورم -->
        <form asp-action="Login" method="post">

            <div class="mb-3 text-end">
                <label class="form-label">البريد الإلكتروني</label>
                <input type="email" name="email" class="form-control" placeholder="example@mail.com" required />
            </div>

            <div class="mb-4 text-end">
                <label class="form-label">كلمة المرور</label>
                <input type="password" name="password" class="form-control" placeholder="••••••••" required />
            </div>

            <button type="submit" class="btn-login w-100">
                دخول
            </button>

        </form>

        <!-- التسجيل -->
        <div class="mt-3">
            <span style="color:white;">ليس لديك حساب؟</span>
            <a asp-action="Register" class="link">إنشاء حساب</a>
        </div>

    </div>

</body>

</html>