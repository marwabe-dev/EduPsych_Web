@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>تسجيل الدخول - RAFIQNI</title>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

    <style>
        :root {
            --slate-900: #0f172a;
            --slate-800: #1e293b;
            --slate-700: #334155;
            --slate-500: #64748b;
            --slate-400: #94a3b8;
            --premium-turquoise: #0d9488; /* تركوازي ملكي */
            --premium-turquoise-light: #14b8a6; /* تركوازي مضيء */
            --premium-gold: #cca43b; /* ذهبي مطفي فاخر */
            --border-subtle: rgba(13, 148, 136, 0.08);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Cairo', sans-serif;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
            -webkit-font-smoothing: antialiased;
            position: relative;
            overflow-x: hidden;
            background-color: #111;
        }

        /* الطبقة الخلفية: صورة أكاديمية دافئة مع تعتيم وضبابية */
        .academic-bg {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-image: url('https://images.unsplash.com/photo-1521587760476-6c12a4b040da?auto=format&fit=crop&w=1920&q=80');
            background-size: cover;
            background-position: center;
            z-index: 1;
        }

        /* طبقة حماية بصرية وفنية دافئة فوق الصورة */
        .academic-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: linear-gradient(135deg, rgba(15, 23, 42, 0.85) 0%, rgba(13, 148, 136, 0.4) 60%, rgba(204, 164, 59, 0.2) 100%);
            backdrop-filter: blur(8px);
            -webkit-backdrop-filter: blur(8px);
            z-index: 2;
        }

        /* عناصر هندسية تطفو برقة في الخلفية */
        .geometric-mesh {
            position: absolute;
            top: 0; left: 0; width: 100%; height: 100%;
            background-image: 
                linear-gradient(to right, rgba(255, 255, 255, 0.02) 1px, transparent 1px),
                linear-gradient(to bottom, rgba(255, 255, 255, 0.02) 1px, transparent 1px);
            background-size: 50px 50px;
            z-index: 3;
            pointer-events: none;
        }

        /* حاوية الكارد الصافي المتزن */
        .auth-card {
            width: 100%;
            max-width: 440px;
            background: #ffffff;
            border: 1px solid rgba(255, 255, 255, 0.8);
            border-radius: 28px;
            padding: 45px 40px;
            box-shadow: 0 30px 70px -10px rgba(0, 0, 0, 0.35);
            position: relative;
            z-index: 10;
            transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
        }

        /* تفاصيل الشعار المدمج مع ملف الصورة */
        .auth-logo-wrapper {
            display: inline-flex;
            align-items: center;
            gap: 12px;
            text-decoration: none;
            margin-bottom: 25px;
        }

        .auth-logo-img {
            height: 42px;
            width: auto;
            object-fit: contain;
            transition: transform 0.3s ease;
        }

        .auth-logo-text {
            font-weight: 800;
            font-size: 1.7rem;
            letter-spacing: -0.5px;
            background: linear-gradient(135deg, var(--premium-turquoise) 30%, var(--premium-gold) 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        /* العناوين ونصوص المساعدة */
        .auth-title {
            font-size: 1.45rem;
            font-weight: 700;
            color: var(--slate-900);
            margin-bottom: 6px;
        }

        .auth-subtitle {
            font-size: 0.9rem;
            color: var(--slate-500);
            margin-bottom: 32px;
        }

        /* الحقول المصممة بمعايير هندسية متقدمة */
        .form-group-premium {
            margin-bottom: 20px;
            text-align: right;
        }

        .label-premium {
            font-size: 0.85rem;
            font-weight: 600;
            color: var(--slate-700);
            margin-bottom: 6px;
            display: block;
        }

        .input-premium {
            width: 100%;
            border-radius: 14px;
            padding: 12px 16px;
            font-size: 0.95rem;
            border: 1px solid rgba(13, 148, 136, 0.18);
            background-color: #fafafa;
            color: var(--slate-900);
            transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
            outline: none;
            text-align: right;
        }

        .input-premium::placeholder {
            color: var(--slate-400);
            font-size: 0.88rem;
        }

        .input-premium:focus {
            border-color: var(--premium-turquoise-light);
            box-shadow: 0 0 0 4px rgba(20, 184, 166, 0.12);
            background-color: #ffffff;
        }

        /* زر الإجراء الرئيسي الفاخر المدمج */
        .btn-auth-submit {
            width: 100%;
            background: linear-gradient(135deg, var(--premium-turquoise) 0%, #0f766e 100%);
            color: #ffffff;
            border: none;
            font-weight: 700;
            font-size: 0.95rem;
            padding: 14px;
            border-radius: 14px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            cursor: pointer;
            transition: all 0.25s ease;
            margin-top: 10px;
            box-shadow: 0 4px 15px rgba(13, 148, 136, 0.2);
        }

        .btn-auth-submit i {
            font-size: 0.95rem;
            color: var(--premium-gold);
            transition: transform 0.2s ease;
        }

        .btn-auth-submit:hover {
            transform: translateY(-1px);
            box-shadow: 0 8px 24px rgba(13, 148, 136, 0.35);
            filter: brightness(1.05);
        }

        .btn-auth-submit:hover i {
            transform: translateX(-4px);
        }

        /* التنبيهات ورسائل الخطأ */
        .alert-premium {
            background: rgba(239, 68, 68, 0.04);
            border: 1px solid rgba(239, 68, 68, 0.15);
            color: #dc2626;
            font-size: 0.85rem;
            font-weight: 600;
            padding: 10px 14px;
            border-radius: 10px;
            margin-bottom: 24px;
            text-align: right;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        /* روابط التنقل السفلية */
        .auth-footer {
            margin-top: 28px;
            font-size: 0.88rem;
            color: var(--slate-500);
        }

        .auth-link {
            color: var(--premium-turquoise);
            text-decoration: none;
            font-weight: 600;
            margin-right: 4px;
            transition: color 0.15s ease;
        }

        .auth-link:hover {
            color: var(--premium-gold);
            text-decoration: underline;
        }

        @@media (max-width: 480px) {
            .auth-card {
                padding: 35px 24px;
                border-radius: 20px;
                box-shadow: 0 20px 40px rgba(0,0,0,0.2);
            }
            body {
                padding: 15px;
            }
        }
    </style>
</head>
<body>

    <div class="academic-bg"></div>
    <div class="academic-overlay"></div>
    <div class="geometric-mesh"></div>

    <div class="auth-card">

        <div class="text-center">
            <a class="auth-logo-wrapper" href="/">
                <img src="/images/logo-rafqni.png" alt="RAFIQNI Logo" class="auth-logo-img" />
                <span class="auth-logo-text">RAFIQNI</span>
            </a>
            <h1 class="auth-title">مرحباً بك مجدداً</h1>
            <p class="auth-subtitle">سجل دخولك إلى منصة RAFIQNI التعليمية</p>
        </div>

        @if (ViewBag.Error != null)
        {
            <div class="alert-premium">
                <i class="bi bi-exclamation-circle-fill"></i>
                <span>@ViewBag.Error</span>
            </div>
        }

        <form asp-action="Login" method="post">

            <div class="form-group-premium">
                <label class="label-premium">البريد الإلكتروني</label>
                <input type="email" name="email" class="input-premium" placeholder="name@example.com" required autocomplete="email" />
            </div>

            <div class="form-group-premium">
                <label class="label-premium">كلمة المرور</label>
                <input type="password" name="password" class="input-premium" placeholder="••••••••" required autocomplete="current-password" />
            </div>

            <button type="submit" class="btn-auth-submit">
                <span>دخول الحساب</span>
                <i class="bi bi-arrow-left-short"></i>
            </button>

        </form>

        <div class="auth-footer text-center">
            <span>ليس لديك حساب؟</span>
            <a asp-action="Register" class="auth-link">إنشاء حساب جديد</a>
        </div>

    </div>

</body>
</html>