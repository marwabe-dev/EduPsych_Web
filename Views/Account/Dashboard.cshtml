@using StudentModel = EduPsych_Web.Models.User
@model IEnumerable<StudentModel>

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <title>لوحة التحكم - EduPsych</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        body { background-color: #f4f7f6; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }
        .sidebar { background: linear-gradient(180deg, #6f42c1 0%, #4e2a84 100%); min-height: 100vh; color: white; }
        .main-content { padding: 40px; }
        .card-table { border: none; border-radius: 15px; box-shadow: 0 0 20px rgba(0,0,0,0.08); background: white; }
        .badge-role { padding: 8px 12px; border-radius: 8px; font-size: 0.85rem; }
    </style>
</head>
<body>
    <div class="container-fluid">
        <div class="row">
            <div class="col-md-2 sidebar p-4 text-center">
                <h3 class="fw-bold mb-5">EduPsych</h3>
                <ul class="nav flex-column text-end p-0">
                    <li class="nav-item mb-3"><i class="fas fa-home ms-2"></i> الرئيسية</li>
                    <li class="nav-item mb-3 fw-bold"><i class="fas fa-users ms-2"></i> إدارة المستخدمين</li>
                </ul>
            </div>

            <div class="col-md-10 main-content">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h2 class="fw-bold">لوحة التحكم المركزية</h2>
                    <div class="text-end">
                        <span class="text-muted">مرحباً بك،</span>
                        <h5 class="text-primary fw-bold">@ViewBag.UserName 👋</h5>
                    </div>
                </div>

                <div class="card card-table p-4">
                    <h4 class="mb-4">قائمة المستخدمين</h4>
                    <div class="table-responsive">
                        <table class="table table-hover align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>الاسم الكامل</th>
                                    <th>البريد الإلكتروني</th>
                                    <th>الدور الوظيفي</th>
                                    <th class="text-center">إجراءات</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model != null)
                                {
                                    @foreach (var item in Model)
                                    {
                                        <tr>
                                            <td class="fw-bold">@item.first_name @item.last_name</td>
                                            <td>@item.email</td>
                                            <td>
                                                @if (item.Role != null)
                                                {
                                                    <span class="badge badge-role @(item.Role.name == "Administrator" ? "bg-dark" : "bg-primary")">
                                                        @item.Role.name
                                                    </span>
                                                }
                                            </td>
                                            <td class="text-center">
                                                <a href="@Url.Action("Profile", "Admin", new { id = item.id })" class="btn btn-sm btn-outline-primary">👤 ملف</a>
                                                
                                                @if (item.role_id == 2) {
                                                    <a href="@Url.Action("Details", "Student", new { id = item.id })" class="btn btn-sm btn-info text-white">🎓 دراسي</a>
                                                }
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>