@{
    Layout = null; // إلغاء أي قالب خارجي للاختبار فقط
}

<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <title>بوابة التلميذ</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
</head>
<body class="bg-light">
    <nav class="navbar navbar-dark bg-dark mb-5">
        <div class="container">
            <span class="navbar-brand">رافقني - منصة التلميذ</span>
            <a href="@Url.Action("Logout", "Account")" class="btn btn-outline-danger btn-sm">تسجيل الخروج</a>
        </div>
    </nav>

    <div class="container text-center">
        <div class="alert alert-info shadow-sm">
            <h3>مرحباً بك يا @ViewBag.UserName</h3>
            <p>لقد نجحت في تسجيل الدخول. يرجى اختيار القسم المطلوب:</p>
        </div>

        <div class="row mt-5">
            <div class="col-md-6 mb-4">
                <div class="card shadow border-primary">
                    <div class="card-body p-5">
                        <h1 class="display-1">📚</h1>
                        <h2 class="card-title text-primary">الجانب التعليمي</h2>
                        <p class="text-muted">حجز حصص، اختيار مواد، وتمارين</p>
                        <a href="@Url.Action("EducationalPath", "Student")" class="btn btn-primary btn-lg w-100 mt-3">دخول</a>
                    </div>
                </div>
            </div>

            <div class="col-md-6 mb-4">
                <div class="card shadow border-success">
                    <div class="card-body p-5">
                        <h1 class="display-1">🧠</h1>
                        <h2 class="card-title text-success">الجانب النفسي</h2>
                        <p class="text-muted">استشارات نفسية مع مرشدين متخصصين</p>
                        <a href="#" class="btn btn-success btn-lg w-100 mt-3">دخول</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>