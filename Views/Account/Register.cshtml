@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>إنشاء حساب جديد - EducPsycho</title>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

    <style>
        :root {
            --primary: #1eb2a6;
            --primary-dark: #0f766e;
            --primary-light: #e9fffc;
            --secondary: #4dd0c8;
            --white: #ffffff;
            --text: #1f2937;
            --muted: #6b7280;
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }
        html, body { height: 100%; font-family: 'Segoe UI',Tahoma,Geneva,Verdana,sans-serif; overflow: hidden; }

        body {
            display: flex; align-items: center; justify-content: center;
            background: radial-gradient(circle at top right, rgba(255,255,255,0.35), transparent 25%), 
                        radial-gradient(circle at bottom left, rgba(255,255,255,0.25), transparent 30%), 
                        linear-gradient( 135deg, #e7fffc 0%, #c7f8f3 15%, #8deee3 35%, #46d8ca 55%, #1eb2a6 75%, #0f766e 100% );
            position: relative;
        }

        .shape { position: absolute; border-radius: 50%; filter: blur(5px); animation: float 10s infinite ease-in-out; z-index: 1; }
        .shape1 { width: 260px; height: 260px; background: rgba(255,255,255,0.16); top: -60px; right: -60px; }
        .shape2 { width: 180px; height: 180px; background: rgba(255,255,255,0.12); bottom: -40px; left: -40px; animation-delay: 2s; }
        .shape3 { width: 120px; height: 120px; background: rgba(255,255,255,0.14); top: 50%; left: 10%; animation-delay: 4s; }

        @@keyframes float { 0%, 100% { transform: translateY(0px); } 50% { transform: translateY(-25px); } }

        .register-card {
            position: relative; z-index: 10; width: 95%; max-width: 720px; max-height: 95vh;
            overflow-y: auto; background: rgba(255,255,255,0.18); backdrop-filter: blur(18px);
            border: 1px solid rgba(255,255,255,0.28); border-radius: 38px; padding: 45px;
            box-shadow: 0 15px 45px rgba(0,0,0,0.10), inset 0 1px 0 rgba(255,255,255,0.25);
        }

        .register-card::-webkit-scrollbar { width: 6px; }
        .register-card::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.35); border-radius: 20px; }

        .top-badge {
            width: 110px; height: 110px; margin: auto; border-radius: 35px;
            background: linear-gradient( 135deg, #1eb2a6, #0f766e );
            display: flex; align-items: center; justify-content: center;
            box-shadow: 0 18px 40px rgba(30,178,166,0.35), inset 0 2px 10px rgba(255,255,255,0.20);
            margin-bottom: 24px;
        }
        .top-badge i { font-size: 3.4rem; color: white; }

        .main-title { font-size: 2.3rem; font-weight: 900; color: white; text-align: center; margin-bottom: 12px; line-height: 1.6; }
        .brand-name {
            background: linear-gradient( 135deg, #ffffff 0%, #dffffb 25%, #7df9ee 50%, #ffffff 100% );
            -webkit-background-clip: text; -webkit-text-fill-color: transparent;
            font-weight: 900; text-shadow: 0 5px 15px rgba(255,255,255,0.25); letter-spacing: 1px;
        }

        .main-subtitle { text-align: center; color: rgba(255,255,255,0.92); margin-bottom: 35px; font-size: 1rem; font-weight: 500; }
        .glass-box { background: rgba(255,255,255,0.55); border-radius: 28px; padding: 28px; border: 1px solid rgba(255,255,255,0.35); }

        .user-type-selector { display: grid; grid-template-columns: repeat(2,1fr); gap: 15px; margin-bottom: 32px; }
        .user-type-item input { display: none; }
        .user-type-label {
            background: rgba(255,255,255,0.82); border: 2px solid rgba(255,255,255,0.45);
            border-radius: 30px; padding: 25px 10px; min-height: 140px;
            display: flex; flex-direction: column; align-items: center; justify-content: center;
            text-align: center; transition: 0.35s ease; cursor: pointer; color: #0f9f94; font-weight: 900; font-size: 1.1rem;
            box-shadow: 0 12px 30px rgba(0,0,0,0.06);
        }
        .user-type-label i { display: block; font-size: 2.4rem; margin-bottom: 10px; color: #18b7ab; transition: 0.3s; }
        .user-type-label:hover { transform: translateY(-6px); background: white; }
        .user-type-item input:checked + .user-type-label {
            background: linear-gradient( 135deg, #1eb2a6, #0f766e ); color: white; border-color: white; transform: scale(1.05);
        }
        .user-type-item input:checked + .user-type-label i { color: white; }

        .form-label { font-size: 0.92rem; font-weight: 800; color: var(--text); margin-bottom: 8px; }
        .form-control {
            height: 54px; border: none; border-radius: 18px; background: rgba(255,255,255,0.88);
            padding: 12px 18px; font-size: 0.96rem; transition: 0.3s ease; box-shadow: none !important;
        }
        .form-control:focus { background: white; transform: translateY(-2px); box-shadow: 0 10px 25px rgba(30,178,166,0.15) !important; }

        /* الأقسام الديناميكية الجديدة */
        .dynamic-section {
            background: rgba(255,255,255,0.45); border: 2px dashed rgba(30,178,166,0.35);
            border-radius: 22px; padding: 18px; margin-bottom: 25px; display: none;
        }

        .btn-register {
            width: 100%; height: 60px; border: none; border-radius: 20px;
            background: linear-gradient( 135deg, #1eb2a6, #0f766e ); color: white;
            font-size: 1.05rem; font-weight: 900; transition: 0.35s ease;
            box-shadow: 0 18px 35px rgba(30,178,166,0.35);
        }
        .btn-register:hover { transform: translateY(-4px); box-shadow: 0 22px 45px rgba(30,178,166,0.45); }

        .login-link { text-align: center; margin-top: 28px; color: white; font-size: 1rem; }
        .login-link a { color: white; font-weight: 900; text-decoration: none; }
        .login-link a:hover { text-decoration: underline; }

        @@media(max-width:768px) {
            .register-card { padding: 25px; }
            .main-title { font-size: 1.7rem; }
            .user-type-selector { grid-template-columns: 1fr 1fr; }
        }
    </style>
</head>
<body>

    <div class="shape shape1"></div>
    <div class="shape shape2"></div>
    <div class="shape shape3"></div>

    <div class="register-card">
        <div class="top-badge">
            <i class="bi bi-mortarboard-fill"></i>
        </div>

        <h1 class="main-title">انضم معنا في منصة <span class="brand-name">EducPsycho</span></h1>
        <p class="main-subtitle">أنشئ حسابك الآن واستمتع بتجربة تعليمية احترافية وحديثة</p>

        <div id="jsError" class="alert alert-danger p-2 text-center d-none mb-3"></div>

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger p-2 text-center mb-3">@ViewBag.Error</div>
        }

        <div class="glass-box">
            <form asp-action="Register" method="post" id="registerForm">
                <label class="form-label d-block mb-3">أنا أسجل كـ:</label>

                <div class="user-type-selector">
                    <div class="user-type-item">
                        <input type="radio" name="RoleId" id="roleStudent" value="2" checked onchange="toggleFields()">
                        <label for="roleStudent" class="user-type-label"><i class="bi bi-mortarboard"></i>تلميذ</label>
                    </div>
                    <div class="user-type-item">
                        <input type="radio" name="RoleId" id="roleTeacher" value="3" onchange="toggleFields()">
                        <label for="roleTeacher" class="user-type-label"><i class="bi bi-person-video3"></i>أستاذ</label>
                    </div>
                    <div class="user-type-item">
                        <input type="radio" name="RoleId" id="roleCounselor" value="5" onchange="toggleFields()">
                        <label for="roleCounselor" class="user-type-label"><i class="bi bi-heart-pulse"></i>مرشد نفسي</label>
                    </div>
                    <div class="user-type-item">
                        <input type="radio" name="RoleId" id="roleParent" value="4" onchange="toggleFields()">
                        <label for="roleParent" class="user-type-label"><i class="bi bi-people"></i>ولي أمر</label>
                    </div>
                </div>

                <div id="studentSection" class="dynamic-section">
                    <label class="form-label">السنة الدراسية</label>
                    <select name="ClassId" class="form-control text-end">
                        <option value="">-- اختر مستواك الدراسي --</option>
                        @if (ViewBag.Classes != null) {
                            @foreach (var item in ViewBag.Classes) {
                                <option value="@item.id">@item.name</option>
                            }
                        }
                    </select>
                </div>

                <div id="teacherSection" class="dynamic-section">
                    <label class="form-label">التخصص الدراسي (المادة)</label>
                    <select name="TeacherSpecId" class="form-control text-end">
                        <option value="">-- اختر مادتك --</option>
                        @if (ViewBag.TeacherSpecs != null) {
                            @foreach (var spec in ViewBag.TeacherSpecs) {
                                <option value="@spec.id">@spec.name</option>
                            }
                        }
                    </select>
                </div>

                <div id="counselorSection" class="dynamic-section">
                    <label class="form-label">مجال الخبرة النفسية</label>
                    <select name="CounselorSpecId" class="form-control text-end">
                        <option value="">-- اختر مجال خبرتك --</option>
                        @if (ViewBag.CounselorSpecs != null) {
                            @foreach (var spec in ViewBag.CounselorSpecs) {
                                <option value="@spec.id">@spec.name</option>
                            }
                        }
                    </select>
                </div>

                <div id="parentSection" class="dynamic-section">
                    <label class="form-label">البريد الإلكتروني للابن</label>
                    <input type="email" name="StudentEmail" class="form-control text-end" placeholder="أدخل إيميل ابنك المسجل">
                    <small class="text-muted d-block mt-1">يجب أن يكون ابنك قد أنشأ حساباً مسبقاً.</small>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label">الاسم الكامل</label>
                        <input type="text" name="FullName" class="form-control text-end" placeholder="الاسم واللقب" required />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">رقم الهاتف</label>
                        <input type="tel" name="Phone" id="phoneInput" class="form-control text-end" placeholder="0XXXXXXXXX" required />
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label">البريد الإلكتروني</label>
                    <input type="email" name="Email" class="form-control text-end" required />
                </div>

                <div class="mb-4">
                    <label class="form-label">كلمة المرور</label>
                    <input type="password" name="Password" class="form-control text-end" required />
                </div>

                <button type="submit" class="btn-register">إتمام التسجيل والبدء</button>
            </form>
        </div>

        <div class="login-link">
            لديك حساب بالفعل؟ <a asp-action="Login">تسجيل الدخول</a>
        </div>
    </div>

    <script>
        function toggleFields() {
            // إخفاء كل الأقسام الديناميكية
            document.querySelectorAll('.dynamic-section').forEach(d => d.style.display = 'none');

            // إظهار القسم المناسب
            if (document.getElementById('roleStudent').checked) 
                document.getElementById('studentSection').style.display = 'block';
            else if (document.getElementById('roleTeacher').checked) 
                document.getElementById('teacherSection').style.display = 'block';
            else if (document.getElementById('roleCounselor').checked) 
                document.getElementById('counselorSection').style.display = 'block';
            else if (document.getElementById('roleParent').checked) 
                document.getElementById('parentSection').style.display = 'block';
        }

        // تنفيذ عند التحميل
        window.onload = toggleFields;

        // التحقق من رقم الهاتف الجزائري
        document.getElementById('registerForm').onsubmit = function (e) {
            const phone = document.getElementById('phoneInput').value.trim();
            const errorDiv = document.getElementById('jsError');
            if (!/^(05|06|07)[0-9]{8}$/.test(phone)) {
                e.preventDefault();
                errorDiv.textContent = "يرجى إدخال رقم هاتف جزائري صحيح.";
                errorDiv.classList.remove('d-none');
                return false;
            }
            return true;
        };
    </script>
</body>
</html>