@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>إنشاء حساب جديد - رافقني</title>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

    <style>
        :root {
            --slate-900: #0f172a;
            --slate-800: #1e293b;
            --slate-700: #334155;
            --slate-600: #475569;
            --slate-500: #64748b;
            --slate-400: #94a3b8;
            --premium-turquoise: #0d9488; /* تركوازي ملكي */
            --premium-turquoise-light: #14b8a6; /* تركوازي مضيء */
            --premium-gold: #cca43b; /* ذهبي مطفي فاخر */
            --border-subtle: rgba(13, 148, 136, 0.08);
        }

        * { 
            margin: 0; 
            padding: 0; 
            box-sizing: border-box; 
        }

        html, body { 
            min-height: 100vh; 
        }

        body {
            font-family: 'Cairo', sans-serif;
            display: flex; 
            align-items: center; 
            justify-content: center;
            padding: 40px 20px;
            -webkit-font-smoothing: antialiased;
            position: relative;
            overflow-x: hidden;
            background-color: #111;
        }

        /* الطبقة الخلفية: صورة أكاديمية دافئة مع تعتيم وضبابية (نفس صفحة الدخول) */
        .academic-bg {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-image: url('https://images.unsplash.com/photo-1521587760476-6c12a4b040da?auto=format&fit=crop&w=1920&q=80');
            background-size: cover;
            background-position: center;
            z-index: 1;
        }

        /* طبقة حماية بصرية وفنية دافئة فوق الصورة */
        .academic-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: linear-gradient(135deg, rgba(15, 23, 42, 0.85) 0%, rgba(13, 148, 136, 0.4) 60%, rgba(204, 164, 59, 0.2) 100%);
            backdrop-filter: blur(8px);
            -webkit-backdrop-filter: blur(8px);
            z-index: 2;
        }

        /* عناصر هندسية تطفو برقة في الخلفية */
        .geometric-mesh {
            position: absolute;
            top: 0; left: 0; width: 100%; height: 100%;
            background-image: 
                linear-gradient(to right, rgba(255, 255, 255, 0.02) 1px, transparent 1px),
                linear-gradient(to bottom, rgba(255, 255, 255, 0.02) 1px, transparent 1px);
            background-size: 50px 50px;
            z-index: 3;
            pointer-events: none;
        }

        /* حاوية الكارد الصافي المتزن الممتد لإنشاء الحساب */
        .register-card {
            position: relative; 
            z-index: 10; 
            width: 100%; 
            max-width: 680px;
            background: #ffffff;
            border: 1px solid rgba(255, 255, 255, 0.8); 
            border-radius: 28px; 
            padding: 45px 40px;
            box-shadow: 0 30px 70px -10px rgba(0, 0, 0, 0.35);
        }

        /* تفاصيل الشعار المدمج مع ملف الصورة */
        .auth-logo-wrapper {
            display: inline-flex;
            align-items: center;
            gap: 12px;
            text-decoration: none;
            margin-bottom: 20px;
        }

        .auth-logo-img {
            height: 45px;
            width: auto;
            object-fit: contain;
        }

        .brand-name {
            font-weight: 800;
            font-size: 1.8rem;
            letter-spacing: -0.5px;
            background: linear-gradient(135deg, var(--premium-turquoise) 30%, var(--premium-gold) 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .main-title { 
            font-size: 1.5rem; 
            font-weight: 700; 
            color: var(--slate-900); 
            text-align: center; 
            margin-bottom: 6px; 
        }

        .main-subtitle { 
            text-align: center; 
            color: var(--slate-500); 
            margin-bottom: 35px; 
            font-size: 0.92rem; 
            font-weight: 500; 
        }

        /* بوكس الحاوية الداخلي النظيف */
        .glass-box { 
            background: transparent;
        }

        /* محدد نوع الحساب بطراز شبكي فاخر ورقيق */
        .user-type-selector { 
            display: grid; 
            grid-template-columns: repeat(4, 1fr); 
            gap: 12px; 
            margin-bottom: 30px; 
        }

        .user-type-item input { 
            display: none; 
        }

        .user-type-label {
            background: #fafafa; 
            border: 1px solid rgba(13, 148, 136, 0.12);
            border-radius: 16px; 
            padding: 16px 8px; 
            min-height: 100px;
            display: flex; 
            flex-direction: column; 
            align-items: center; 
            justify-content: center;
            text-align: center; 
            transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1); 
            cursor: pointer; 
            color: var(--slate-700); 
            font-weight: 700; 
            font-size: 0.9rem;
        }

        .user-type-label i { 
            display: block; 
            font-size: 1.8rem; 
            margin-bottom: 6px; 
            color: var(--premium-turquoise); 
            transition: all 0.2s ease; 
        }

        .user-type-label:hover { 
            transform: translateY(-2px); 
            background: #ffffff;
            border-color: var(--premium-turquoise-light);
            box-shadow: 0 8px 20px rgba(13, 148, 136, 0.06);
        }

        .user-type-item input:checked + .user-type-label {
            background: linear-gradient(135deg, var(--premium-turquoise) 0%, #0f766e 100%); 
            color: #ffffff; 
            border-color: transparent; 
            box-shadow: 0 10px 20px rgba(13, 148, 136, 0.2);
        }

        .user-type-item input:checked + .user-type-label i { 
            color: var(--premium-gold); /* الأيقونة المحددة تتحول للذهبي ببريق مذهل */
        }

        /* الحقول المتطورة */
        .form-label { 
            font-size: 0.88rem; 
            font-weight: 700; 
            color: var(--slate-700); 
            margin-bottom: 8px; 
        }

        .form-control {
            height: 50px; 
            border: 1px solid rgba(13, 148, 136, 0.18); 
            border-radius: 14px; 
            background: #fafafa;
            padding: 12px 16px; 
            font-size: 0.95rem; 
            transition: all 0.25s ease; 
            box-shadow: none !important;
            color: var(--slate-900);
        }
        
        .form-control::placeholder {
            color: var(--slate-400);
            font-size: 0.88rem;
        }

        .form-control:focus { 
            background: #ffffff; 
            border-color: var(--premium-turquoise-light);
            box-shadow: 0 0 0 4px rgba(20, 184, 166, 0.12) !important; 
        }

        /* الأقسام الديناميكية المفتوحة حسب الاختيار */
        .dynamic-section {
            background: rgba(13, 148, 136, 0.02); 
            border: 1px dashed rgba(13, 148, 136, 0.3);
            border-radius: 16px; 
            padding: 20px; 
            margin-bottom: 25px; 
            display: none;
        }

        /* تصميم قسم رفع المستندات */
        .upload-box {
            border: 1px dashed var(--premium-turquoise);
            background-color: rgba(20, 184, 166, 0.04);
        }

        /* زر التسجيل الرئيسي */
        .btn-register {
            width: 100%; 
            height: 54px; 
            border: none; 
            border-radius: 14px;
            background: linear-gradient(135deg, var(--premium-turquoise) 0%, #0f766e 100%); 
            color: #ffffff;
            font-size: 1rem; 
            font-weight: 700; 
            transition: all 0.25s ease;
            box-shadow: 0 4px 15px rgba(13, 148, 136, 0.2);
        }

        .btn-register:hover { 
            transform: translateY(-1px); 
            box-shadow: 0 8px 24px rgba(13, 148, 136, 0.35);
            filter: brightness(1.05);
        }

        /* التنبيهات */
        .alert-premium {
            background: rgba(239, 68, 68, 0.04);
            border: 1px solid rgba(239, 68, 68, 0.15);
            color: #dc2626;
            font-size: 0.85rem;
            font-weight: 600;
            padding: 10px 14px;
            border-radius: 10px;
            margin-bottom: 20px;
            text-align: right;
        }

        /* روابط التنقل السفلية */
        .login-link { 
            text-align: center; 
            margin-top: 28px; 
            color: var(--slate-500); 
            font-size: 0.9rem; 
        }

        .login-link a { 
            color: var(--premium-turquoise); 
            font-weight: 700; 
            text-decoration: none; 
            margin-right: 4px;
            transition: color 0.15s ease;
        }

        .login-link a:hover { 
            color: var(--premium-gold);
            text-decoration: underline; 
        }

        @@media(max-width:768px) {
            .user-type-selector { 
                grid-template-columns: repeat(2, 1fr); 
            }
            .register-card { 
                padding: 35px 24px; 
                border-radius: 20px;
            }
        }
    </style>
</head>
<body>

    <div class="academic-bg"></div>
    <div class="academic-overlay"></div>
    <div class="geometric-mesh"></div>

    <div class="register-card">
        
        <div class="text-center">
            <a class="auth-logo-wrapper" href="/">
                <img src="/images/logo-rafqni.png" alt="RAFIQNI Logo" class="auth-logo-img" />
                <span class="brand-name">رافقني</span>
            </a>
            <h1 class="main-title">انضم معنا في منصة رافقني</h1>
            <p class="main-subtitle">أنشئ حسابك الآن واستمتع بتجربة تعليمية احترافية وحديثة</p>
        </div>

        <div id="jsError" class="alert-premium d-none"></div>

        @if (ViewBag.Error != null)
        {
            <div class="alert-premium">@ViewBag.Error</div>
        }

        <div class="glass-box">
            <form asp-action="Register" method="post" id="registerForm" enctype="multipart/form-data">
                
                <label class="form-label d-block mb-3">أنا أسجل كـ:</label>

                <div class="user-type-selector">
                    <div class="user-type-item">
                        <input type="radio" name="RoleId" id="roleStudent" value="2" checked onchange="toggleFields()">
                        <label for="roleStudent" class="user-type-label"><i class="bi bi-mortarboard"></i>تلميذ</label>
                    </div>
                    <div class="user-type-item">
                        <input type="radio" name="RoleId" id="roleTeacher" value="3" onchange="toggleFields()">
                        <label for="roleTeacher" class="user-type-label"><i class="bi bi-person-video3"></i>أستاذ</label>
                    </div>
                    <div class="user-type-item">
                        <input type="radio" name="RoleId" id="roleCounselor" value="5" onchange="toggleFields()">
                        <label for="roleCounselor" class="user-type-label"><i class="bi bi-heart-pulse"></i>مرشد نفسي</label>
                    </div>
                    <div class="user-type-item">
                        <input type="radio" name="RoleId" id="roleParent" value="4" onchange="toggleFields()">
                        <label for="roleParent" class="user-type-label"><i class="bi bi-people"></i>ولي أمر</label>
                    </div>
                </div>

                <div id="studentSection" class="dynamic-section">
                    <label class="form-label">السنة الدراسية</label>
                    <select name="ClassId" class="form-control text-end">
                        <option value="">-- اختر مستواك الدراسي --</option>
                        @if (ViewBag.Classes != null) {
                            @foreach (var item in ViewBag.Classes) {
                                <option value="@item.id">@item.name</option>
                            }
                        }
                    </select>
                </div>

                <div id="teacherSection" class="dynamic-section">
                    <label class="form-label">التخصص الدراسي (المادة)</label>
                    <select name="SpecializationId" class="form-control text-end">
                        <option value="">-- اختر مادتك --</option>
                        @if (ViewBag.TeacherSpecs != null) {
                            @foreach (var spec in ViewBag.TeacherSpecs) {
                                <option value="@spec.id">@spec.name</option>
                            }
                        }
                    </select>
                </div>

                <div id="counselorSection" class="dynamic-section">
                    <label class="form-label">مجال الخبرة النفسية</label>
                    <select name="CounselorSpecId" class="form-control text-end">
                        <option value="">-- اختر مجال خبرتك --</option>
                        @if (ViewBag.CounselorSpecs != null) {
                            @foreach (var spec in ViewBag.CounselorSpecs) {
                                <option value="@spec.id">@spec.name</option>
                            }
                        }
                    </select>
                </div>

                <div id="parentSection" class="dynamic-section">
                    <label class="form-label">البريد الإلكتروني للابن</label>
                    <input type="email" name="StudentEmail" class="form-control text-end" placeholder="أدخل إيميل ابنك المسجل">
                </div>

                <div id="uploadSection" class="dynamic-section upload-box">
                    <label class="form-label fw-bold" style="color: var(--premium-turquoise);">تحميل السيرة الذاتية أو الشهادات (PDF / صور)</label>
                    <input type="file" name="docFile" class="form-control bg-white" accept=".pdf,.jpg,.jpeg,.png" />
                    <small class="text-secondary d-block mt-2 font-weight-bold" style="color: var(--slate-600) !important;"><i class="bi bi-info-circle me-1"></i> يرجى رفع ملفاتك ليتم دراسة طلبك وتفعيل حسابك.</small>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label">الاسم الكامل</label>
                        <input type="text" name="FullName" class="form-control text-end" placeholder="الاسم واللقب" required />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">رقم الهاتف</label>
                        <input type="tel" name="Phone" id="phoneInput" class="form-control text-end" placeholder="0XXXXXXXXX" required />
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label">البريد الإلكتروني</label>
                    <input type="email" name="Email" class="form-control text-end" placeholder="name@example.com" required />
                </div>

                <div class="mb-4">
                    <label class="form-label">كلمة المرور</label>
                    <input type="password" name="Password" class="form-control text-end" placeholder="••••••••" required />
                </div>

                <button type="submit" class="btn-register">إتمام التسجيل والبدء</button>
            </form>
        </div>

        <div class="login-link">
            لديك حساب بالفعل؟ <a asp-action="Login">تسجيل الدخول</a>
        </div>
    </div>

    <script>
        function toggleFields() {
            document.querySelectorAll('.dynamic-section').forEach(d => d.style.display = 'none');

            if (document.getElementById('roleStudent').checked) {
                document.getElementById('studentSection').style.display = 'block';
            } 
            else if (document.getElementById('roleTeacher').checked) {
                document.getElementById('teacherSection').style.display = 'block';
                document.getElementById('uploadSection').style.display = 'block';
            } 
            else if (document.getElementById('roleCounselor').checked) {
                document.getElementById('counselorSection').style.display = 'block';
                document.getElementById('uploadSection').style.display = 'block';
            } 
            else if (document.getElementById('roleParent').checked) {
                document.getElementById('parentSection').style.display = 'block';
            }
        }

        window.onload = toggleFields;

        document.getElementById('registerForm').onsubmit = function (e) {
            const phone = document.getElementById('phoneInput').value.trim();
            const errorDiv = document.getElementById('jsError');
            
            if (!/^(05|06|07)[0-9]{8}$/.test(phone)) {
                e.preventDefault();
                errorDiv.textContent = "يرجى إدخال رقم هاتف جزائري صحيح.";
                errorDiv.classList.remove('d-none');
                window.scrollTo(0, 0);
                return false;
            }

            const isExpert = document.getElementById('roleTeacher').checked || document.getElementById('roleCounselor').checked;
            const fileInput = document.querySelector('input[name="docFile"]');
            if (isExpert && fileInput.files.length === 0) {
                e.preventDefault();
                errorDiv.textContent = "يرجى تحميل الشهادات أو السيرة الذاتية لإتمام الطلب.";
                errorDiv.classList.remove('d-none');
                window.scrollTo(0, 0);
                return false;
            }

            return true;
        };
    </script>
</body>
</html>