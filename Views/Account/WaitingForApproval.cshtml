@{
    Layout = null; // لا نريد إظهار أي قوائم لأن الحساب لم يفعل بعد
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <title>حسابك قيد المراجعة</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.rtl.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;700&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Cairo', sans-serif; background-color: #f8fafc; display: flex; align-items: center; justify-content: center; height: 100vh; margin: 0; }
        .card { border: none; border-radius: 20px; box-shadow: 0 10px 30px rgba(0,0,0,0.05); padding: 40px; text-align: center; max-width: 500px; }
        .icon-box { color: #1eb2a6; font-size: 80px; margin-bottom: 20px; }
        .btn-home { background-color: #1eb2a6; color: white; border-radius: 10px; padding: 10px 30px; text-decoration: none; transition: 0.3s; }
        .btn-home:hover { background-color: #148d84; color: white; }
    </style>
</head>
<body>
    <div class="card">
        <div class="icon-box">
            <i class="fas fa-user-clock"></i>
        </div>
        <h2 class="fw-bold mb-3">شكراً لتسجيلك، دكتور!</h2>
        <p class="text-muted mb-4">
            تم استلام طلب انضمامك كأستاذ/مرشد بنجاح. حسابك حالياً <strong>قيد المراجعة</strong> من قبل الإدارة للتأكد من البيانات والشهادات.
            <br><br>
            سنقوم بتفعيل حسابك خلال 24 ساعة كحد أقصى. يمكنك العودة لاحقاً لتسجيل الدخول.
        </p>
        <a href="/Home/Index" class="btn-home shadow-sm">العودة للرئيسية</a>
    </div>
</body>
</html>