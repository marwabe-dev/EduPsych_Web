@model IEnumerable<EduPsych_Web.Models.CounselSession>

@{
    Layout = "_CounselorLayout";
    ViewData["Title"] = "لوحة تحكم المرشد النفسي";
}

<link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;900&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.2/font/bootstrap-icons.min.css">
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<style>
    :root {
        --brand-teal: #1eb2a6;
        --brand-teal-dark: #148d84;
        --brand-teal-light: #f0fdfa;
        --brand-dark: #0f172a;
        --brand-bg: #f8fafc;
    }

    /* خلفية بتدرجات الفيروزي الهادئة */
    body { 
        background: linear-gradient(135deg, #f8fafc 0%, #e0f2f1 100%);
        font-family: 'Cairo', sans-serif; 
        color: var(--brand-dark);
        min-height: 100vh;
    }

    .welcome-banner {
        background: linear-gradient(135deg, var(--brand-teal) 0%, var(--brand-teal-dark) 100%);
        border-radius: 24px;
        padding: 40px;
        color: white;
        margin-bottom: 35px;
        position: relative;
        overflow: hidden;
        box-shadow: 0 10px 30px rgba(30, 178, 166, 0.2);
    }

    .stat-card {
        background: white;
        border: none;
        border-right: 5px solid var(--brand-teal);
        padding: 24px;
        border-radius: 20px;
        box-shadow: 0 8px 20px rgba(0,0,0,0.04);
        transition: 0.3s;
        height: 100%;
    }
    .stat-card:hover { transform: translateY(-5px); }

    .glass-panel {
        background: rgba(255, 255, 255, 0.9);
        backdrop-filter: blur(10px);
        border-radius: 24px;
        padding: 30px;
        box-shadow: 0 10px 40px rgba(0,0,0,0.03);
        border: 1px solid white;
    }

    .session-row {
        background: white;
        border: 1px solid #f1f5f9;
        border-radius: 18px;
        padding: 20px;
        margin-bottom: 15px;
        transition: all 0.3s ease;
    }
    .session-row:hover {
        border-color: var(--brand-teal);
        background-color: var(--brand-teal-light);
    }

    .student-avatar {
        width: 50px; height: 50px;
        background: var(--brand-teal);
        color: white;
        display: flex; align-items: center; justify-content: center;
        border-radius: 14px;
        font-weight: 900;
        font-size: 1.2rem;
    }

    .filter-input {
        border-radius: 15px; border: 1px solid #e2e8f0; padding: 12px 20px;
        background: white;
    }
    .filter-input:focus { border-color: var(--brand-teal); box-shadow: 0 0 0 4px rgba(30, 178, 166, 0.1); }
</style>

<div class="container py-4" dir="rtl">

    <div class="welcome-banner d-flex justify-content-between align-items-center">
        <div class="z-1">
            <h1 class="fw-900 mb-2">طاب يومك، د. @User.Identity?.Name</h1>
            <p class="mb-0 opacity-90 fs-5">لديك اليوم <span class="fw-bold">@(ViewBag.TodaySessions ?? 0)</span> جلسات بانتظارك.</p>
        </div>
        <i class="bi bi-heart-pulse-fill display-2 opacity-25"></i>
    </div>

    <div class="row g-4 mb-5 text-center">
        <div class="col-md-3 col-6">
            <div class="stat-card">
                <small class="text-muted fw-bold d-block mb-1">إجمالي الجلسات</small>
                <span class="h2 fw-900">@(ViewBag.TotalSessions ?? 0)</span>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="stat-card" style="border-right-color: var(--brand-orange);">
                <small class="text-muted fw-bold d-block mb-1">بانتظار التأكيد</small>
                <span class="h2 fw-900" style="color: var(--brand-orange)">@(ViewBag.PendingSessions ?? 0)</span>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="stat-card">
                <small class="text-muted fw-bold d-block mb-1">جلسات اليوم</small>
                <span class="h2 fw-900" style="color: var(--brand-teal)">@(ViewBag.TodaySessions ?? 0)</span>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="stat-card">
                <small class="text-muted fw-bold d-block mb-1">قادمة معتمدة</small>
                <span class="h2 fw-900 text-success">@(ViewBag.UpcomingSessions ?? 0)</span>
            </div>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-8">
            <div class="position-relative text-end">
                <i class="bi bi-search position-absolute top-50 start-0 translate-middle-y ms-3 text-muted"></i>
                <input type="text" id="studentSearch" class="form-control filter-input ps-5 w-100" placeholder="ابحث باسم الطالب أو نوع الجلسة...">
            </div>
        </div>
        <div class="col-md-4 text-end">
            <select id="statusFilter" class="form-select filter-input">
                <option value="">كل الحالات</option>
                <option value="قيد الانتظار">بانتظار التأكيد</option>
                <option value="مقبولة">مقبولة</option>
                <option value="مدفوعة">مدفوعة</option>
                <option value="تمت بنجاح">مكتملة</option>
                <option value="ملغاة">ملغاة</option>
            </select>
        </div>
    </div>

    <div class="glass-panel text-end">
        <h5 class="fw-900 mb-4 text-dark"><i class="bi bi-calendar-check me-2 text-teal"></i> قائمة المواعيد والطلبات</h5>
        
        <div id="sessionsList">
            @if (Model == null || !Model.Any())
            {
                <div class="text-center py-5 opacity-50">
                    <i class="bi bi-calendar2-x display-1"></i>
                    <p class="mt-3 fw-bold">لا توجد جلسات حالياً</p>
                </div>
            }
            else
            {
                @foreach (var item in Model)
                {
                    <div class="session-row session-card d-flex align-items-center justify-content-between flex-wrap gap-3">
                        <div class="d-flex align-items-center">
                            <div class="student-avatar ms-3">
                                @(item.Student?.User?.first_name?[0].ToString().ToUpper() ?? "?")
                            </div>
                            <div>
                                <h6 class="fw-bold text-dark mb-1 student-name">
                                    @(item.Student?.User != null ? $"{item.Student.User.first_name} {item.Student.User.last_name}" : $"طالب رقم {item.student_id}")
                                </h6>
                                <span class="badge bg-light text-teal border session-type-text">@item.session_type</span>
                            </div>
                        </div>

                        <div class="text-center">
                            <div class="fw-900 text-dark">@item.scheduled_at.ToString("HH:mm")</div>
                            <small class="text-muted">@item.scheduled_at.ToString("dd MMM, yyyy")</small>
                        </div>

                        <div class="status-indicator">
                            @switch (item.status)
                            {
                                case "Pending": <span class="badge bg-warning text-dark status-badge-text">قيد الانتظار</span> break;
                                case "Approved": <span class="badge bg-primary status-badge-text">مقبولة</span> break;
                                case "Paid": <span class="badge bg-info status-badge-text">مدفوعة</span> break;
                                case "Completed": <span class="badge bg-success status-badge-text">تمت بنجاح</span> break;
                                case "Cancelled": <span class="badge bg-danger status-badge-text">ملغاة</span> break;
                                default: <span class="badge bg-secondary status-badge-text">@item.status</span> break;
                            }
                        </div>

                        <div class="d-flex align-items-center gap-2">
                            @if (item.status == "Paid" || item.status == "Approved")
                            {
                                <form asp-action="UpdateCounselingLink" method="post" class="d-flex gap-1">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="sessionId" value="@item.id" />
                                    <input type="text" name="meetingLink" value="@item.meeting_link" class="form-control form-control-sm filter-input border-0 bg-light" placeholder="رابط الجلسة" style="width:130px" required />
                                    <button type="submit" class="btn btn-teal btn-sm rounded-circle"><i class="bi bi-save"></i></button>
                                </form>
                            }

                            <div class="dropdown">
                                <button class="btn btn-light btn-sm rounded-pill shadow-sm" type="button" data-bs-toggle="dropdown">
                                     الإجراءات <i class="bi bi-chevron-down ms-1"></i>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end shadow border-0 rounded-3">
                                    <li><button class="dropdown-item py-2" onclick="updateStatus(@item.id, 'Approved')"><i class="bi bi-check2 text-success me-2"></i> قبول الطلب</button></li>
                                    <li><button class="dropdown-item py-2" onclick="updateStatus(@item.id, 'Completed')"><i class="bi bi-check-all text-primary me-2"></i> إتمام الجلسة</button></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li><button class="dropdown-item py-2 text-danger" onclick="updateStatus(@item.id, 'Cancelled')"><i class="bi bi-x-circle me-2"></i> إلغاء الطلب</button></li>
                                </ul>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // دالة تحديث الحالة
        function updateStatus(sessionId, newStatus) {
            Swal.fire({
                title: 'تغيير حالة الجلسة؟',
                text: "سيتم إرسال تنبيه للطالب بالحالة الجديدة.",
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#1eb2a6',
                cancelButtonColor: '#64748b',
                confirmButtonText: 'نعم، تأكيد',
                cancelButtonText: 'تراجع'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.ajax({
                        url: '/Counselor/UpdateStatus',
                        type: 'POST',
                        data: { id: sessionId, status: newStatus },
                        success: function (response) {
                            if (response.success) {
                                Swal.fire({ icon: 'success', title: 'تم التحديث!', showConfirmButton: false, timer: 1000 })
                                .then(() => { location.reload(); });
                            }
                        }
                    });
                }
            });
        }

        // البحث الفوري - تم تعديل المسميات لتطابق الكلاسات الجديدة
        document.getElementById('studentSearch').addEventListener('input', function() {
            let filter = this.value.toLowerCase().trim();
            let cards = document.querySelectorAll('.session-card');

            cards.forEach(card => {
                let studentName = card.querySelector('.student-name').innerText.toLowerCase();
                let sessionType = card.querySelector('.session-type-text').innerText.toLowerCase();
                
                if (studentName.includes(filter) || sessionType.includes(filter)) {
                    card.style.setProperty('display', 'flex', 'important');
                } else {
                    card.style.setProperty('display', 'none', 'important');
                }
            });
        });

        // الفلترة حسب الحالة - تم تعديل المنطق ليتناسب مع النصوص العربية في السلكت والبادج
        document.getElementById('statusFilter').addEventListener('change', function() {
            let filter = this.value.trim();
            let cards = document.querySelectorAll('.session-card');

            cards.forEach(card => {
                let statusBadgeText = card.querySelector('.status-badge-text').innerText.trim();
                
                if (filter === "" || statusBadgeText === filter) {
                    card.style.setProperty('display', 'flex', 'important');
                } else {
                    card.style.setProperty('display', 'none', 'important');
                }
            });
        });
    </script>
}