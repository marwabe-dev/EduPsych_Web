@model EduPsych_Web.Models.Counselor

@{
    ViewData["Title"] = "تأكيد موعد الجلسة";
    // نجلب المعرفات من الـ ViewBag كما فعلنا مع الأستاذ
    var specId = ViewBag.SpecId; 
}

<style>
    :root {
        --psych-teal: #2d8284;
        --soft-bg: #f0f4f3;
    }
    body { background-color: var(--soft-bg); }
    .card-confirm { border: none; border-radius: 25px; box-shadow: 0 15px 35px rgba(0,0,0,0.05); }
    .header-gradient { 
        background: linear-gradient(135deg, var(--psych-teal) 0%, #57cc99 100%); 
        color: white; border-radius: 25px 25px 0 0 !important; 
    }
    .counselor-avatar-md {
        width: 90px; height: 90px; object-fit: cover;
        border: 4px solid white; box-shadow: 0 5px 15px rgba(0,0,0,0.1);
    }
    .form-label { color: #4a5568; font-weight: 600; }
</style>

<div class="container py-5" dir="rtl">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card card-confirm">
                <div class="card-header header-gradient text-center py-4">
                    <h4 class="mb-0 fw-bold"><i class="bi bi-calendar-check ms-2"></i>تأكيد موعد الجلسة</h4>
                </div>
                
                <div class="card-body p-4 text-end">
                    <div class="text-center mb-4">
                        <div class="position-relative d-inline-block">
                            <img src="@(string.IsNullOrEmpty(Model.User?.profile_picture_url) ? "/images/counselor-avatar.png" : Model.User.profile_picture_url)" 
                                 class="rounded-circle counselor-avatar-md mb-2">
                        </div>
                        <h5 class="fw-bold text-dark mt-2">أ. @Model.User?.first_name @Model.User?.last_name</h5>
                        <p class="text-muted small">المختص في: <span class="text-success fw-bold">@ViewBag.SpecName</span></p>
                        
                        <div class="badge bg-light text-teal-dark border px-4 py-2 rounded-pill shadow-sm">
                           <i class="bi bi-clock-history ms-1"></i> مدة الجلسة: 60 دقيقة
                        </div>
                    </div>

                    <form asp-action="InitiateChargilyPayment" asp-controller="Student" method="post">
                        @Html.AntiForgeryToken()
                        
                        <input type="hidden" name="counselorId" value="@Model.id" />
                        <input type="hidden" name="specId" value="@specId" />

                        <div class="mb-4">
                            <label class="form-label d-block mb-2">
                                <i class="bi bi-calendar-event ms-1 text-success"></i> اختر التاريخ والوقت المناسب لك:
                            </label>
                            <input type="datetime-local" name="scheduledAt" 
                                   class="form-control form-control-lg rounded-4 shadow-sm border-light" required
                                   min="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")">
                            <div class="form-text mt-2 text-muted">
                                <i class="bi bi-info-circle ms-1"></i> أوقات عمل المستشار: @Model.available_hours
                            </div>
                        </div>

                        <div class="bg-light rounded-4 p-3 mb-4 d-flex justify-content-between align-items-center">
                            <span class="fw-bold text-secondary">إجمالي المبلغ المطلوب:</span>
                            <span class="h4 m-0 fw-bold text-success">@Model.hourly_price <small class="fs-6">دج</small></span>
                        </div>

                        <div class="d-grid gap-3">
                            <button type="submit" class="btn btn-success btn-lg rounded-pill fw-bold py-3 shadow">
                                <i class="bi bi-credit-card-2-back ms-2"></i> الانتقال لعملية الدفع
                            </button>
                            <a href="javascript:history.back()" class="btn btn-link text-muted text-decoration-none">إلغاء والتراجع</a>
                        </div>
                    </form>
                </div>
            </div>

            <div class="text-center mt-4">
                <p class="text-muted small">
                    <i class="bi bi-lock-fill text-success"></i> دفع آمن 100% عبر بوابة <strong>Chargily</strong>
                </p>
            </div>
        </div>
    </div>
</div>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">