@model IEnumerable<EduPsych_Web.Models.Teacher>

@{
    ViewData["Title"] = "نخبة الأساتذة - إبداع";
    Layout = "_Layout";

    // جلب اسم المستخدم للهيدر
    var fullName = Context.Session.GetString("UserName") ?? "تلميذنا العزيز";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

<style>
    :root {
        --primary-teal: #1eb2a6;
        --dark-teal: #114b4d;
        --glass-white: rgba(255, 255, 255, 0.85);
    }

    body {
        background-color: #f4fdfc;
        font-family: 'Cairo', 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    /* إخفاء الهيدر الافتراضي */
    nav, .sidebar, header:not(.edu-header) {
        display: none !important;
    }

    /* --- الهيدر العائم (الكبسولة) الموحد --- */
    .edu-header {
        background: var(--glass-white);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(30, 178, 166, 0.15);
        padding: 12px 30px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        position: sticky;
        top: 15px;
        margin: 10px 20px 30px;
        z-index: 1050;
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.05);
        border-radius: 50px;
    }

        .edu-header .btn {
            border-radius: 50px !important;
            font-weight: 600;
            font-size: 0.85rem;
            transition: 0.3s;
        }

    /* بطاقة الأستاذ */
    .teacher-card-exclusive {
        background: white;
        border: none;
        border-radius: 40px;
        transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        position: relative;
        overflow: hidden;
        border: 1px solid rgba(0,0,0,0.02);
    }

        .teacher-card-exclusive:hover {
            transform: translateY(-15px);
            box-shadow: 0 30px 60px rgba(30, 178, 166, 0.15) !important;
        }

    .card-banner {
        height: 100px;
        background: linear-gradient(135deg, rgba(30, 178, 166, 0.1) 0%, rgba(21, 147, 138, 0.05) 100%);
        position: relative;
    }

    .avatar-container {
        margin-top: -50px;
        position: relative;
        z-index: 2;
    }

    .avatar-img {
        width: 110px;
        height: 110px;
        border-radius: 35px;
        object-fit: cover;
        border: 5px solid white;
        box-shadow: 0 10px 20px rgba(0,0,0,0.05);
    }

    .verify-icon {
        position: absolute;
        bottom: 5px;
        left: calc(50% - 60px);
        background: white;
        color: var(--primary-teal);
        border-radius: 50%;
        font-size: 1.2rem;
        width: 28px;
        height: 28px;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 4px 10px rgba(0,0,0,0.1);
    }

    .price-tag {
        background: #f0fdfc;
        border-radius: 20px;
        padding: 10px 15px;
    }

    .btn-reserve {
        background: var(--primary-teal);
        color: white !important;
        border-radius: 20px;
        padding: 15px;
        font-weight: 700;
        border: none;
        transition: 0.3s;
        text-decoration: none;
        display: block;
    }

        .btn-reserve:hover {
            background: var(--dark-teal);
            transform: scale(1.02);
        }

    .text-turquoise {
        color: #1eb2a6 !important;
    }
</style>

<div class="container-fluid p-0 text-end" dir="rtl">

    <header class="edu-header">
        <div class="d-flex align-items-center">
            <div class="bg-turquoise text-white p-2 rounded-3 ms-3" style="background-color: #1eb2a6;">
                <i class="bi bi-mortarboard-fill"></i>
            </div>
            <div class="d-flex flex-column">
                <h4 class="m-0 fw-bold text-dark">منصة <span class="text-turquoise">EducPsycho</span></h4>
            </div>
        </div>

        <div class="d-flex gap-2">
            <a href="@Url.Action("Index", "Student")" class="btn btn-light shadow-sm text-dark border">الرئيسية</a>
            <a href="@Url.Action("MyWallet", "Student")" class="btn btn-white shadow-sm text-dark border">محفظتي</a>
            <a href="@Url.Action("Courses", "Student")" class="btn btn-white shadow-sm text-dark border">متجر الدورات</a>
            <a href="@Url.Action("MyEducationalLessons", "Student")" class="btn btn-white shadow-sm text-dark border">حصصي التعليمية</a>
            <a href="@Url.Action("MyCounselSessions", "Student")" class="btn btn-white shadow-sm text-dark border">حصصي النفسية</a>
        </div>

        <div class="dropdown">
            <button class="btn btn-light rounded-circle shadow-sm" type="button" data-bs-toggle="dropdown">
                <i class="bi bi-person-fill text-turquoise"></i>
            </button>
            <ul class="dropdown-menu dropdown-menu-end shadow border-0 rounded-4 mt-2">
                <li><a class="dropdown-item py-3 text-danger fw-bold" href="@Url.Action("Logout", "Account")"><i class="bi bi-box-arrow-right ms-2"></i>تسجيل الخروج</a></li>
            </ul>
        </div>
    </header>

    <div class="container">
        <div class="py-5">
            <span class="badge bg-turquoise bg-opacity-10 text-turquoise px-3 py-2 rounded-pill mb-2" style="background-color: rgba(30,178,166,0.1);">طاقم التدريس</span>
            <h1 class="fw-bold text-dark">أساتذة مادة <span class="text-turquoise">@ViewBag.SubjectName</span></h1>
            <p class="text-muted fs-5">مرحباً بك @fullName، اختر أستاذك المفضل لبدء حصة مباشرة الآن</p>
        </div>

        <div class="row g-4 pb-5">
            @foreach (var teacher in Model)
            {
                <div class="col-lg-4 col-md-6">
                    <div class="teacher-card-exclusive shadow-sm h-100">
                        <div class="card-banner"></div>

                        <div class="card-body p-4 pt-0 text-center">
                            <div class="avatar-container">
                                <img src="https://ui-avatars.com/api/?name=@(teacher.User?.first_name + "+" + teacher.User?.last_name)&background=1eb2a6&color=fff&size=128"
                                     class="avatar-img" alt="Teacher">
                                <div class="verify-icon">
                                    <i class="bi bi-patch-check-fill"></i>
                                </div>
                            </div>

                            <h4 class="fw-bold text-dark mt-3 mb-1">أ. @teacher.User?.first_name @teacher.User?.last_name</h4>
                            
                            @* تم الإبقاء على التخصص هنا فقط وتنسيقه بشكل أوضح *@
                            <div class="small text-turquoise fw-bold mb-3">متخصص في مادة @ViewBag.SubjectName</div>
                            
                            <p class="text-muted small mb-4" style="min-height: 45px;">
                                @(string.IsNullOrEmpty(teacher.bio) ? "أستاذ متميز يكرس خبرته لتبسيط المفاهيم التعليمية وضمان استيعاب الطالب للمادة بأفضل الوسائل." : teacher.bio)
                            </p>

                            <div class="d-flex justify-content-between align-items-center price-tag mb-4">
                                <div class="text-end">
                                    <span class="d-block text-muted" style="font-size: 0.7rem;">سعر الساعة</span>
                                    <span class="fw-bold text-dark fs-5">@teacher.hourly_price <small>دج</small></span>
                                </div>
                                <div class="text-start">
                                    <span class="badge rounded-pill bg-success bg-opacity-10 text-success py-2 px-3">
                                        <i class="bi bi-circle-fill me-1" style="font-size: 0.5rem;"></i> متاح الآن
                                    </span>
                                </div>
                            </div>

                            <a href="@Url.Action("TeacherProfile", "Student", new { id = teacher.id, subjectId = ViewBag.SubjectId })"
                                   class="btn btn-reserve w-100 shadow-sm">
                                عرض الملف والحجز <i class="bi bi-calendar-check ms-2"></i>
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>