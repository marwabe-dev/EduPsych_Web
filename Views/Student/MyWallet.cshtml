@model EduPsych_Web.Models.StudentWallet
@{
    Layout = "~/Views/Shared/_StudentLayout.cshtml";
    var depositRequests = ViewBag.DepositRequests as IEnumerable<EduPsych_Web.Models.DepositRequest>;
}

<style>
    body { background-color: #f0f7f7; font-family: 'Cairo', sans-serif; }
    nav, .sidebar, header:not(.edu-header) { display: none !important; }

    .edu-header {
        background: rgba(255, 255, 255, 0.85); backdrop-filter: blur(10px);
        border: 1px solid rgba(30, 178, 166, 0.15); padding: 12px 30px;
        display: flex; justify-content: space-between; align-items: center;
        position: sticky; top: 15px; margin: 10px 20px 30px; z-index: 1050;
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.05); border-radius: 50px;
    }

    .wallet-card {
        background: linear-gradient(135deg, #1eb2a6 0%, #148a80 100%);
        color: white; border-radius: 25px; padding: 30px;
        box-shadow: 0 15px 35px rgba(30, 178, 166, 0.3);
    }

    .info-box {
        background: #fff; border-radius: 20px; border: 1px dashed #1eb2a6;
        padding: 20px; margin-bottom: 25px;
    }

    .status-badge { border-radius: 50px; padding: 5px 15px; font-size: 0.8rem; }
    .btn-turquoise { background-color: #1eb2a6 !important; color: white !important; }
    .text-turquoise { color: #1eb2a6 !important; }
</style>

<div class="container-fluid p-0 text-end" dir="rtl">
    

    <div class="container mt-4">

        @* 🆕 نظام التنبيهات لعرض رسائل النجاح أو الفشل القادمة من الـ Controller *@
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger rounded-4 text-center fw-bold shadow-sm mb-4 border-0 py-3">
                <i class="bi bi-exclamation-triangle-fill ms-2"></i> @TempData["Error"]
            </div>
        }
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success rounded-4 text-center fw-bold shadow-sm mb-4 border-0 py-3">
                <i class="bi bi-check-circle-fill ms-2"></i> @TempData["Success"]
            </div>
        }

        @* 🆕 صندوق تأكيد دفع الحصة المباشرة الفوري (يظهر فقط عند الضغط على دفع الرسوم من صفحة الحصص) *@
        @* 🆕 صندوق تأكيد دفع الحصة المباشرة الفوري الجديد *@
@if (Context.Request.Query.ContainsKey("paySessionId"))
{
    var sessionId = Context.Request.Query["paySessionId"].ToString();
    <div class="alert alert-info border-0 rounded-4 p-4 mb-4 shadow-sm" style="background-color: #e8f8f7; border-right: 5px solid #1eb2a6 !important;">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
            <div>
                <h5 class="fw-bold text-dark mb-1"><i class="bi bi-shield-check text-turquoise ms-2"></i> تأكيد اقتطاع ثمن الجصة النفسية</h5>
                <p class="text-muted small m-0">سيتم فحص رصيدك الحالي واقتطاع سعر الجلسة الخاص بالمرشد مباشرة فور تأكيد العملية.</p>
            </div>
            
            <form asp-action="PaySession" asp-controller="Student" method="post" class="m-0">
                <input type="hidden" name="sessionId" value="@sessionId" />
                <button type="submit" class="btn btn-dark rounded-pill px-4 py-2 fw-bold shadow-sm">
                    تأكيد الدفع والخصم الآن <i class="bi bi-credit-card ms-1"></i>
                </button>
            </form>
        </div>
    </div>
}

        <div class="row">
            <div class="col-lg-5 mb-4">
                <div class="wallet-card text-center">
                    <p class="opacity-75 mb-1">الرصيد المتاح حالياً</p>
                    <h1 class="display-4 fw-bold mb-0">@(Model?.balance ?? 0) <small class="fs-4">دج</small></h1>
                </div>

                <div class="mt-4 p-4 bg-white rounded-4 shadow-sm">
                    <h5 class="fw-bold mb-3">شحن الرصيد (CCP / بريدي موب)</h5>
                    <div class="info-box">
                        <p class="small text-muted mb-2">قم بتحويل المبلغ إلى الحساب التالي:</p>
                        <h5 class="text-dark fw-bold mb-1">0012345678 / 90</h5>
                        <p class="small fw-bold text-turquoise mb-0">الاسم: مؤسسة رافقني</p>
                    </div>

                    <form asp-action="UploadReceipt" method="post" enctype="multipart/form-data">
                        <div class="mb-3">
                            <label class="form-label small fw-bold">المبلغ الذي قمت بتحويله</label>
                            <input type="number" name="amount" class="form-control rounded-pill" placeholder="مثلاً: 2000" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label small fw-bold">صورة وصل الدفع</label>
                            <input type="file" name="receiptFile" class="form-control" required>
                        </div>
                        <button type="submit" class="btn btn-turquoise text-white w-100 rounded-pill py-2 fw-bold">إرسال الوصل للمراجعة</button>
                    </form>
                </div>
            </div>

            <div class="col-lg-7">
                <div class="bg-white rounded-4 shadow-sm p-4">
                    <h5 class="fw-bold mb-4">طلبات الشحن الأخيرة</h5>
                    <div class="table-responsive">
                        <table class="table align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>التاريخ</th>
                                    <th>المبلغ</th>
                                    <th>الحالة</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (depositRequests != null && depositRequests.Any())
                                {
                                    foreach (var req in depositRequests)
                                    {
                                        <tr>
                                            <td class="small">@req.created_at.ToString("yyyy/MM/dd")</td>
                                            <td class="fw-bold">@req.amount دج</td>
                                            <td>
                                                @if (req.status == "Pending") { <span class="badge bg-warning text-dark status-badge">قيد المراجعة</span> }
                                                else if (req.status == "Approved") { <span class="badge bg-success status-badge">تم القبول</span> }
                                                else { <span class="badge bg-danger status-badge">مرفوض</span> }
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr><td colspan="3" class="text-center py-4 text-muted">لا توجد طلبات سابقة</td></tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>