@model EduPsych_Web.Models.Student

@{
    Layout = null;

    var fullName = Model.User != null
        ? $"{Model.User.first_name} {Model.User.last_name}"
        : "تلميذنا العزيز";

    var className = Model.Class?.name ?? "غير محدد";
    var streamName = ViewBag.StreamName ?? "عام";
}

<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>منصة رافقني - RAFIKNI</title>

    <link rel="preload" as="image" href='@Url.Content("~/images/book-with-green-board-background.jpg")' fetchpriority="high" />
    <link rel="dns-prefetch" href='@Url.Content("~/images/")' />

    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@600;700;800;900&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Cairo', sans-serif;
            scrollbar-width: none; /* Firefox */
        }

        html, body {
            width: 100%;
            height: 100%;
            overflow: hidden;
            -ms-overflow-style: none; /* IE/Edge */
        }

        html::-webkit-scrollbar,
        body::-webkit-scrollbar {
            display: none; /* Chrome/Safari/Webkit */
        }

        body {
            /* تعديل لتسريع الظهور: وضع لون خلفية متناسق ومطابق للصورة الأصلية ليعمل كـ Placeholder فوري */
            background-color: #052326;
            background-image: linear-gradient(rgba(5, 35, 38, 0.1), rgba(5, 35, 38, 0.15)), url('@Url.Content("~/images/book-with-green-board-background.jpg")');
            background-size: cover;
            background-position: center;
            background-repeat: no-repeat;
            background-attachment: fixed;
            will-change: transform; /* تحسين استهلاك كرت الشاشة لتسريع الرندر */
            min-height: 100vh;
        }

        .page-overlay {
            width: 100%;
            max-width: 1400px;
            margin: 0 auto;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            justify-content: flex-start;
            padding: 12px 18px;
            overflow: hidden;
        }

        /* --- HEADER --- */
        .edu-header {
            width: 100%;
            background: rgba(255, 255, 255, 0.08);
            border: 1px solid rgba(255, 255, 255, 0.18);
            backdrop-filter: blur(8px);
            border-radius: 20px;
            padding: 12px 18px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            box-shadow: 0 6px 24px rgba(0, 0, 0, 0.15);
            flex-wrap: nowrap;
            gap: 15px;
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 12px;
            flex-shrink: 0;
        }

        .brand-logo-text {
            font-family: 'Poppins', sans-serif;
            font-weight: 900;
            font-size: 2rem;
            line-height: 1;
            background: linear-gradient(135deg, #4ff4e4, #1eb2a6);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            position: relative;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            filter: drop-shadow(0 2px 8px rgba(32, 214, 200, 0.3));
        }

        .brand-logo-text .cap-icon {
            position: absolute;
            font-size: 0.85rem;
            top: -5px;
            right: -5px;
            color: #4ff4e4;
            transform: rotate(15deg);
            -webkit-text-fill-color: initial;
        }

        .brand-info {
            flex-shrink: 0;
        }

        .brand-info h2 {
            color: white;
            font-size: 1.25rem;
            font-weight: 900;
            margin-bottom: 2px;
            white-space: nowrap;
        }

        .brand-info h2 span {
            color: #4ff4e4;
        }

        .badge-row {
            display: flex;
            gap: 6px;
            flex-wrap: nowrap;
            margin-top: 2px;
        }

        .info-badge {
            background: rgba(255, 255, 255, 0.14);
            color: white;
            padding: 3px 8px;
            border-radius: 12px;
            font-size: 0.68rem;
            font-weight: 700;
            border: 1px solid rgba(255, 255, 255, 0.2);
            white-space: nowrap;
        }

        .nav-links {
            display: flex;
            gap: 8px;
            flex-wrap: nowrap;
            align-items: center;
            overflow-x: auto;
            scrollbar-width: none;
        }

        .nav-links::-webkit-scrollbar {
            display: none;
        }

        .nav-links a {
            text-decoration: none;
            color: white;
            background: rgba(255, 255, 255, 0.08);
            padding: 8px 14px;
            border-radius: 10px;
            font-weight: 600;
            font-size: 0.82rem;
            transition: all 0.3s ease;
            border: 1px solid rgba(255, 255, 255, 0.14);
            white-space: nowrap;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            flex-shrink: 0;
        }

        .nav-links a:hover {
            transform: translateY(-2px);
            background: rgba(30, 178, 166, 0.25);
            border-color: #1eb2a6;
            box-shadow: 0 4px 12px rgba(30, 178, 166, 0.3);
        }

        .rafnki-logo {
            font-family: 'Poppins', sans-serif;
            font-weight: 900;
            font-size: 1.4rem;
            letter-spacing: 2px;
            background: linear-gradient(135deg, #4ff4e4 0%, #20d6c8 25%, #1eb2a6 50%, #2ce0d0 75%, #4ff4e4 100%);
            background-size: 200% auto;
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            animation: shine 3s linear infinite;
            text-shadow: none;
            flex-shrink: 0;
        }

        @@keyframes shine {
            to {
                background-position: 200% center;
            }
        }

        .profile-container {
            position: relative;
            flex-shrink: 0;
        }

        .profile-btn {
            width: 42px;
            height: 42px;
            border-radius: 50%;
            border: none;
            background: linear-gradient(135deg, #1eb2a6, #2ce0d0);
            color: white;
            font-size: 1.1rem;
            cursor: pointer;
            transition: all 0.3s ease;
            box-shadow: 0 4px 12px rgba(30, 178, 166, 0.3);
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .profile-btn:hover {
            transform: scale(1.08);
            box-shadow: 0 6px 18px rgba(30, 178, 166, 0.5);
        }

        .profile-dropdown {
            position: absolute;
            top: 52px;
            right: 0;
            background: white;
            border-radius: 14px;
            box-shadow: 0 8px 30px rgba(0, 0, 0, 0.2);
            min-width: 180px;
            opacity: 0;
            visibility: hidden;
            transform: translateY(-10px);
            transition: all 0.3s ease;
            z-index: 100;
        }

        .profile-container:hover .profile-dropdown {
            opacity: 1;
            visibility: visible;
            transform: translateY(0);
        }

        .profile-dropdown a {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 12px 18px;
            color: #333;
            text-decoration: none;
            font-weight: 600;
            font-size: 0.9rem;
            transition: all 0.2s ease;
        }

        .profile-dropdown a:hover {
            background: rgba(30, 178, 166, 0.1);
            color: #1eb2a6;
        }

        .profile-dropdown a i {
            color: #1eb2a6;
        }

        .profile-dropdown .logout {
            color: #dc3545;
        }

        .profile-dropdown .logout i {
            color: #dc3545;
        }

        .profile-dropdown .logout:hover {
            background: rgba(220, 53, 69, 0.1);
        }

        /* --- HERO SECTION --- */
        .hero {
            text-align: center;
            color: white;
            margin: 25px 0 15px;
            padding: 0 10px;
        }

        .hero h1 {
            font-size: 2.2rem;
            font-weight: 900;
            margin-bottom: 12px;
            text-shadow: 0 6px 20px rgba(0, 0, 0, 0.2);
        }

        .hero h1 span {
            color: #53ffee;
            text-shadow: 0 0 30px rgba(83, 255, 238, 0.4);
        }

        .hero p {
            width: 100%;
            max-width: 650px;
            margin: auto;
            line-height: 1.8;
            font-size: 0.95rem;
            color: rgba(255, 255, 255, 0.95);
        }

        /* --- CARDS SECTION --- */
        .cards-container {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 24px;
            margin-top: 20px;
            flex-wrap: wrap;
        }

        .main-card {
            width: 280px;
            height: 300px;
            border-radius: 24px;
            padding: 24px 20px;
            text-decoration: none;
            color: white;
            position: relative;
            overflow: hidden;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            text-align: center;
            transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            box-shadow: 0 12px 32px rgba(0, 0, 0, 0.2);
            border: 1px solid rgba(255, 255, 255, 0.15);
        }

        .main-card::before {
            content: '';
            position: absolute;
            inset: 0;
            background: linear-gradient(to bottom right, rgba(255, 255, 255, 0.18), transparent);
            z-index: 1;
        }

        .main-card:hover {
            transform: translateY(-12px) scale(1.02);
            box-shadow: 0 20px 45px rgba(0, 0, 0, 0.3);
        }

        .main-card i {
            font-size: 3.2rem;
            margin-bottom: 16px;
            position: relative;
            z-index: 2;
            filter: drop-shadow(0 4px 12px rgba(0, 0, 0, 0.15));
        }

        .main-card h2 {
            font-size: 1.45rem;
            font-weight: 900;
            margin-bottom: 10px;
            position: relative;
            z-index: 2;
        }

        .main-card p {
            line-height: 1.75;
            font-size: 0.88rem;
            position: relative;
            z-index: 2;
            opacity: 0.95;
            padding: 0 5px;
        }

        .card-btn {
            margin-top: 18px;
            background: white;
            color: #148d84;
            padding: 9px 26px;
            border-radius: 28px;
            font-weight: 800;
            position: relative;
            z-index: 2;
            font-size: 0.9rem;
            transition: all 0.3s ease;
        }

        .main-card:hover .card-btn {
            transform: scale(1.05);
            box-shadow: 0 4px 12px rgba(255, 255, 255, 0.3);
        }

        .bg-edu { background: linear-gradient(135deg, #3ce2cd, #17a89d); }
        .bg-shop { background: linear-gradient(135deg, #24c9bb, #11838d); }
        .bg-psych { background: linear-gradient(135deg, #0a7883, #014a63); }

        /* --- AI CHAT BUTTON --- */
        #ai-chat-launcher {
            position: fixed;
            bottom: 22px;
            left: 22px; /* 🛠️ تم التعديل إلى اليسار بنجاح */
            right: auto; /* إلغاء القيمة القديمة لمنع التداخل */
            background: linear-gradient(135deg, #1eb2a6, #2ce0d0);
            color: white;
            padding: 12px 24px;
            border-radius: 45px;
            display: flex;
            align-items: center;
            gap: 10px;
            font-weight: 800;
            cursor: pointer;
            box-shadow: 0 10px 28px rgba(30, 178, 166, 0.35);
            z-index: 1000;
            transition: all 0.3s ease;
            border: 2px solid rgba(255, 255, 255, 0.2);
            font-size: 0.95rem;
        }

        #ai-chat-launcher:hover {
            transform: translateY(-3px);
            box-shadow: 0 15px 38px rgba(30, 178, 166, 0.5);
        }

        /* --- MEDIA QUERIES --- */
        @@media (max-width: 1200px) {
            .edu-header {
                flex-wrap: wrap;
                justify-content: space-between;
                padding: 14px;
            }
            .nav-links {
                width: 100%;
                order: 3;
                justify-content: center;
                margin-top: 5px;
            }
            .rafnki-logo {
                order: 2;
                margin-left: auto;
                margin-right: 15px;
            }
            .profile-container {
                order: 2;
            }
        }

        @@media (max-width: 768px) {
            .page-overlay { padding: 10px; }
            .edu-header { padding: 12px; gap: 10px; }
            .brand-logo-text { font-size: 1.8rem; }
            .brand-logo-text .cap-icon { font-size: 0.75rem; }
            .brand-info h2 { font-size: 1.15rem; }
            .info-badge { font-size: 0.65rem; padding: 2px 6px; }
            .hero h1 { font-size: 1.8rem; }
            .hero p { font-size: 0.88rem; }
            .cards-container { gap: 16px; }
            .main-card {
                width: 100%;
                max-width: 290px;
                height: auto;
                min-height: 270px;
                padding: 22px 16px;
            }
            .nav-links a { font-size: 0.78rem; padding: 6px 11px; }
        }

        @@media (max-width: 480px) {
            .edu-header { padding: 10px; }
            .brand-logo-text { font-size: 1.6rem; }
            .brand-info h2 { font-size: 1rem; }
            .rafnki-logo { font-size: 1.15rem; margin-right: 8px; }
            .profile-btn { width: 38px; height: 38px; font-size: 1rem; }
            .hero h1 { font-size: 1.5rem; }
            .hero p { font-size: 0.82rem; }
            .nav-links a { font-size: 0.72rem; padding: 5px 9px; gap: 4px; }
            #ai-chat-launcher {
                padding: 10px 18px;
                font-size: 0.85rem;
                bottom: 15px;
                left: 15px; /* 🛠️ توازن متناسق على الهواتف */
            }
        }
    </style>
</head>

<body>
    <div class="page-overlay">
        <header class="edu-header">
            <div class="brand">
                <div class="brand-logo-text">
                    R
                    <i class="bi bi-mortarboard-fill cap-icon"></i>
                </div>

                <div class="brand-info">
                    <h2>منصة <span>رافقني</span></h2>
                    <div class="badge-row">
                        <span class="info-badge">@className</span>
                        <span class="info-badge">@streamName</span>
                    </div>
                </div>
            </div>

            <div class="nav-links">
                <a href="@Url.Action("Index", "Student")">
                    <i class="bi bi-house-door-fill"></i> الرئيسية
                </a>
                <a href="@Url.Action("MyWallet", "Student")">
                    <i class="bi bi-wallet2"></i> محفظتي
                </a>
                <a href="@Url.Action("Courses", "Student")">
                    <i class="bi bi-cart-check-fill"></i> متجر الدورات
                </a>
                <a href="@Url.Action("MyEducationalLessons", "Student")">
                    <i class="bi bi-book-fill"></i> حصصي التعليمية
                </a>
                <a href="@Url.Action("MyCounselSessions", "Student")">
                    <i class="bi bi-heart-pulse-fill"></i> جلساتي النفسية
                </a>
            </div>

            <div class="rafnki-logo">
                RAFIQNI
            </div>

            <div class="profile-container">
                <button class="profile-btn" type="button">
                    <i class="bi bi-person-fill"></i>
                </button>
                <div class="profile-dropdown">
                    <a href="@Url.Action("Logout", "Account")" class="logout">
                        <i class="bi bi-box-arrow-right"></i>
                        تسجيل الخروج
                    </a>
                </div>
            </div>
        </header>

        <section class="hero">
            <h1>
                مرحباً، <span>@fullName</span>
            </h1>
            <p>
                نحن هنا لدعم تميزك الدراسي ونفسيتك المتزنة.
                اختر شعبتك ومستواك الدراسي لاكتشاف الأساتذة
                وحجز حصص تعليمية وتوجيهات نفسية مباشرة
                في الوقت الذي يناسبك.
            </p>
        </section>

        <section class="cards-container">
            <a href="@Url.Action("EducationalPath", "Student")" class="main-card bg-edu">
                <i class="bi bi-mortarboard-fill"></i>
                <h2>المسار التعليمي</h2>
                <p>دروسك وتمارينك وفروضك وأساتذتك في مكان واحد.</p>
                <div class="card-btn">استكشف الآن</div>
            </a>

            <a href="@Url.Action("Courses", "Student")" class="main-card bg-shop">
                <i class="bi bi-cart-check-fill"></i>
                <h2>متجر الدورات</h2>
                <p>دورات احترافية ومحتوى تعليمي مميز.</p>
                <div class="card-btn">تسوق الآن</div>
            </a>

            <a href="@Url.Action("PsychologicalSupport", "Student")" class="main-card bg-psych">
                <i class="bi bi-heart-pulse-fill"></i>
                <h2>الدعم النفسي</h2>
                <p>تواصل مع مرشدك النفسي واحجز جلسات بسهولة.</p>
                <div class="card-btn">احجز حصة</div>
            </a>
        </section>
    </div>

    <div id="ai-chat-launcher">
        <i class="bi bi-robot"></i>
        <span>اسأل رافقني</span>
    </div>

    <script>
        // دالة موحدة لفتح شات الذكاء الاصطناعي بناءً على الـ ID أو العنصر البرمجي الخاص ببقية صفحاتك
        function openAiChat() {
            // يبحث عن زر الشات الأصلي المحقون من الـ Layout (تغيير السيلكتور بمطابق ملف الـ Layout لديك إذا لزم الأمر)
            const nativeAiBtn = document.querySelector('.crisp-client, #crisp-chatbox, [id*="chat"], [class*="chat"]');
            
            if (nativeAiBtn) {
                nativeAiBtn.click();
            } else {
                // إذا كان الشات يعتمد على سكريبت مخصص تم استدعاؤه باسم "اسأل رافقني"
                console.log("يتم الآن استدعاء نافذة الذكاء الاصطناعي المتصلة بالمنصة...");
            }
        }

        // 1. تشغيل المحادثة فور فتح الصفحة مباشرة
        window.addEventListener('DOMContentLoaded', (event) => {
            // مهلة زمنية قصيرة (نصف ثانية) للتأكد من اكتمال رندر عناصر الشات الأساسية بالموقع
            setTimeout(openAiChat, 500); 
        });

        // 2. تشغيل المحادثة عند ضغط الطالب يدوياً على الكبسولة العائمة باليسار
        document.getElementById('ai-chat-launcher').addEventListener('click', openAiChat);
    </script>
</body>
</html>