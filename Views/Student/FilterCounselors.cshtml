@model IEnumerable<EduPsych_Web.Models.Counselor>

@{
    ViewData["Title"] = "قائمة المختصين - إبداع";
    Layout = "~/Views/Shared/_StudentLayout.cshtml";

    // جلب اسم المستخدم للهيدر لضمان التناسق
    var fullName = Context.Session.GetString("UserName") ?? "تلميذنا العزيز";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

<style>
    :root {
        --primary-teal: #1eb2a6;
        --dark-teal: #114b4d;
        --glass-white: rgba(255, 255, 255, 0.85);
    }

    body {
        background-color: #f4fdfc;
        font-family: 'Cairo', 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    /* إخفاء الهيدر الافتراضي */
    nav, .sidebar, header:not(.edu-header) {
        display: none !important;
    }

    /* --- الهيدر العائم (الكبسولة) الموحد --- */
    .edu-header {
        background: var(--glass-white);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(30, 178, 166, 0.15);
        padding: 12px 30px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        position: sticky;
        top: 15px;
        margin: 10px 20px 30px;
        z-index: 1050;
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.05);
        border-radius: 50px;
    }

    .edu-header .btn {
        border-radius: 50px !important;
        font-weight: 600;
        font-size: 0.85rem;
        transition: 0.3s;
    }

    /* بطاقة المستشار */
    .counselor-card {
        background: white;
        border-radius: 35px;
        border: 1px solid rgba(0,0,0,0.02);
        transition: all 0.4s ease;
        position: relative;
    }

    .counselor-card:hover {
        transform: translateY(-10px);
        box-shadow: 0 20px 40px rgba(30, 178, 166, 0.1) !important;
        border-color: var(--primary-teal);
    }

    .avatar-container {
        position: relative;
        width: 100px;
        height: 100px;
        flex-shrink: 0;
    }

    .counselor-img {
        width: 100%;
        height: 100%;
        border-radius: 30px;
        object-fit: cover;
        border: 3px solid #f0fdfc;
    }

    .online-dot {
        position: absolute;
        bottom: 5px;
        right: 5px;
        width: 15px;
        height: 15px;
        background: #2ecc71;
        border: 3px solid white;
        border-radius: 50%;
    }

    .pulse {
        animation: pulse-animation 2s infinite;
    }

    @@keyframes pulse-animation {
        0% { box-shadow: 0 0 0 0 rgba(46, 204, 113, 0.4); }
        70% { box-shadow: 0 0 0 10px rgba(46, 204, 113, 0); }
        100% { box-shadow: 0 0 0 0 rgba(46, 204, 113, 0); }
    }

    .price-badge {
        background: rgba(30, 178, 166, 0.1);
        color: var(--primary-teal);
        padding: 6px 15px;
        border-radius: 12px;
        font-weight: 700;
    }

    .btn-book {
        background: linear-gradient(135deg, #1eb2a6 0%, #114b4d 100%);
        color: white !important;
        border-radius: 15px;
        padding: 10px 25px;
        font-weight: 600;
        border: none;
        transition: 0.3s;
        text-decoration: none;
    }

    .btn-book:hover {
        transform: scale(1.05);
        box-shadow: 0 8px 20px rgba(17, 75, 77, 0.2);
    }

    .text-turquoise { color: #1eb2a6 !important; }
    .bg-turquoise { background-color: #1eb2a6 !important; }
</style>

<div class="container-fluid p-0 text-end" dir="rtl">

    @* --- الهيدر العائم المستبدل --- *@
    

    <div class="container py-4">
        <div class="row mb-5 align-items-end">
            <div class="col-md-8">
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb mb-2 p-0 bg-transparent">
                        <li class="breadcrumb-item"><a href="@Url.Action("PsychologicalSupport")" class="text-turquoise text-decoration-none small">مركز الدعم</a></li>
                        <li class="breadcrumb-item active small text-muted">@ViewBag.SpecName</li>
                    </ol>
                </nav>
                <h2 class="fw-bold text-dark">نخبة <span class="text-turquoise">المستشارين النفسيين</span></h2>
                <p class="text-muted m-0">المختصون في مساعدتك يا @fullName لتجاوز: <span class="fw-bold text-dark">@ViewBag.SpecName</span></p>
            </div>
            <div class="col-md-4 text-md-start mt-3 mt-md-0">
                <div class="d-inline-block bg-white p-2 px-3 rounded-pill shadow-sm border small">
                    <i class="bi bi-shield-lock-fill text-turquoise ms-1"></i> جلسات آمنة، سرية، وموثوقة
                </div>
            </div>
        </div>

        <div class="row g-4">
            @if (Model != null && Model.Any())
            {
                @foreach (var c in Model)
                {
                    <div class="col-lg-6">
                        <div class="card counselor-card p-4 h-100">
                            <div class="d-flex flex-column flex-sm-row align-items-center align-items-sm-start text-center text-sm-end">
                                
                                <div class="avatar-container mb-3 mb-sm-0 ms-sm-4">
                                    <img src="https://ui-avatars.com/api/?name=@(c.User?.first_name)+@(c.User?.last_name)&background=f0fdfc&color=1eb2a6&size=128" 
                                         class="counselor-img" alt="Counselor">
                                    <span class="online-dot pulse"></span>
                                </div>

                                <div class="flex-grow-1 w-100">
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <h5 class="fw-bold m-0 text-dark">أ. @c.User.first_name @c.User.last_name</h5>
                                        <span class="price-badge">@c.hourly_price دج / ساعة</span>
                                    </div>
                                    
                                    <p class="text-muted small mb-3" style="line-height: 1.6;">
                                        @(string.IsNullOrEmpty(c.bio) ? "مستشار نفسي معتمد بخبرة في مرافقة الطلاب دراسياً ونفسياً لتحقيق التوازن الدراسي." : c.bio)
                                    </p>

                                    <div class="d-flex flex-wrap justify-content-between align-items-center mt-3 pt-3 border-top gap-3">
                                        <div class="small">
                                            <i class="bi bi-star-fill text-warning"></i>
                                            <span class="fw-bold">4.9</span> <span class="text-muted">(تقييم ممتاز)</span>
                                        </div>
                                        <a href="@Url.Action("CounselorProfile", new { id = c.id })" 
                                           class="btn btn-book shadow-sm">
                                            حجز جلسة <i class="bi bi-calendar-plus ms-1"></i>
                                        </a>
                                    </div>
                                </div>

                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="col-12 text-center py-5">
                    <div class="bg-white d-inline-block p-5 rounded-5 shadow-sm border">
                        <i class="bi bi-person-x text-muted display-1 opacity-25"></i>
                        <h4 class="mt-3 text-muted fw-bold">لا يوجد مستشارون متاحون حالياً</h4>
                        <p class="text-muted">يرجى المحاولة في قسم آخر أو العودة لاحقاً.</p>
                        <a href="javascript:history.back()" class="btn btn-turquoise text-white rounded-pill px-5 py-2 mt-3 fw-bold">العودة للخلف</a>
                    </div>
                </div>
            }
        </div>
    </div>
</div>