@model IEnumerable<EduPsych_Web.Models.EducationalSession>
@{
    ViewData["Title"] = "دروسي المحجوزة - إبداع";
    Layout = "~/Views/Shared/_StudentLayout.cshtml"; 
    
    var fullName = Context.Session.GetString("UserName") ?? "تلميذنا العزيز";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

<style>
    :root {
        --primary-teal: #1eb2a6;
        --dark-teal: #0c3336;
        --soft-gold: #b8860b;
    }

    /* إخفاء الهيدر الافتراضي */
    nav, .sidebar, header:not(.edu-header) {
        display: none !important;
    }

    /* --- بطاقة الحصة الزجاجية الاحترافية --- */
    .session-card-pro {
        background: rgba(255, 255, 255, 0.45) !important;
        backdrop-filter: blur(20px) !important;
        -webkit-backdrop-filter: blur(20px) !important;
        border: 1px solid rgba(255, 255, 255, 0.4) !important;
        border-radius: 35px !important;
        padding: 30px;
        margin-bottom: 25px;
        transition: all 0.4s ease;
        box-shadow: 0 10px 30px rgba(12, 51, 54, 0.05) !important;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .session-card-pro:hover {
        transform: translateY(-5px);
        box-shadow: 0 15px 35px rgba(30, 178, 166, 0.2) !important;
    }

    .icon-wrapper {
        width: 70px;
        height: 70px;
        background: linear-gradient(135deg, rgba(255,255,255,0.6) 0%, rgba(30,178,166,0.2) 100%);
        border-radius: 22px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.8rem;
        color: var(--primary-teal);
    }

    .status-pill {
        padding: 8px 20px;
        border-radius: 50px;
        font-weight: 700;
        font-size: 0.85rem;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

    .pill-pending { background: rgba(184, 134, 11, 0.15); color: var(--soft-gold); border: 1px solid rgba(184, 134, 11, 0.3); }
    .pill-accepted { background: rgba(30, 178, 166, 0.15); color: var(--primary-teal); border: 1px solid rgba(30, 178, 166, 0.3); }
    .pill-confirmed { background: rgba(40, 167, 69, 0.15); color: #28a745; border: 1px solid rgba(40, 167, 69, 0.3); }

    .time-box {
        background: rgba(255, 255, 255, 0.4);
        padding: 10px 20px;
        border-radius: 20px;
        border: 1px dashed rgba(30, 178, 166, 0.3);
    }

    .btn-pay-premium {
        background: var(--dark-teal);
        color: white !important;
        border-radius: 18px;
        padding: 10px 25px;
        font-weight: 600;
        text-decoration: none;
        box-shadow: 0 4px 15px rgba(12, 51, 54, 0.2);
    }
    
    .btn-pay-premium:hover {
        background: var(--primary-teal);
    }

    .text-turquoise { color: #1eb2a6 !important; }
    .btn-turquoise { background-color: #1eb2a6 !important; color: white !important; }

    .fade-in-slide {
        animation: revealUp 0.6s ease forwards;
        opacity: 0;
    }

    @@keyframes revealUp {
        from { opacity: 0; transform: translateY(30px); }
        to { opacity: 1; transform: translateY(0); }
    }
</style>

<div class="container pb-5">
    <div class="row mb-5 fade-in-slide">
        <div class="col-12">
            <span class="badge bg-white text-turquoise px-3 py-2 rounded-pill shadow-sm mb-3 border">الجدول الدراسي</span>
            <h1 class="display-6 fw-bold" style="color: var(--dark-teal)">أهلاً بك في <span class="text-turquoise">مساحتك التعليمية</span></h1>
            <p class="fs-5" style="color: var(--dark-teal); opacity: 0.85;">هنا تجد جميع حصصك التي قمت بحجزها، يمكنك متابعة الدفع عند الضغط على محفظتي في الأعلى والانضمام للدروس المباشرة عند إرسال الأستاذ لرابط الحصة في هذه الصفحة.</p>
        </div>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="row">
            @foreach (var (session, index) in Model.Select((s, i) => (s, i)))
            {
                <div class="col-12 fade-in-slide" style="animation-delay: @(index * 0.1)s">
                    <div class="session-card-pro">
                        
                        <div class="d-flex align-items-center gap-4">
                            <div class="icon-wrapper">
                                <i class="bi bi-lightning-charge-fill"></i>
                            </div>
                            <div>
                                <h4 class="fw-bold mb-1" style="color: var(--dark-teal)">@session.Lesson?.title</h4>
                                <div class="d-flex align-items-center gap-2">
                                    <img src="https://ui-avatars.com/api/?name=@session.Lesson?.Teacher?.User?.first_name&background=1eb2a6&color=fff" class="rounded-circle" width="25">
                                    <span style="color: var(--dark-teal); opacity: 0.8;">أ. @session.Lesson?.Teacher?.User?.first_name @session.Lesson?.Teacher?.User?.last_name</span>
                                </div>
                            </div>
                        </div>

                        <div class="time-box d-none d-lg-block">
                            <div class="d-flex align-items-center gap-3">
                                <div class="text-center border-start ps-3 ms-3">
                                    <div class="small text-muted mb-1">التاريخ</div>
                                    <div class="fw-bold" style="color: var(--dark-teal)">@session.scheduled_at.ToString("dd MMMM")</div>
                                </div>
                                <div class="text-center">
                                    <div class="small text-muted mb-1">الوقت</div>
                                    <div class="fw-bold text-turquoise">@session.scheduled_at.ToString("HH:mm")</div>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex align-items-center gap-3">
                            @if (session.status == "Pending")
                            {
                                <span class="status-pill pill-pending">
                                    <i class="bi bi-clock-history"></i> قيد المراجعة
                                </span>
                            }
                            else if (session.status == "Accepted")
                            {
                                <div class="text-start">
                                    <span class="status-pill pill-accepted mb-2">
                                        <i class="bi bi-check2-all"></i> مقبول - بانتظار الدفع
                                    </span>
                                    <br />
                                    <a href="@Url.Action("MyWallet", "Student", new { paySessionId = session.id })" class="btn btn-pay-premium mt-2">
                                        دفع الرسوم <i class="bi bi-credit-card-2-back ms-2"></i>
                                    </a>
                                </div>
                            }
                            else if (session.status == "Confirmed" || session.status == "Paid")
                            {
                                <div class="text-start text-center">
                                    <span class="status-pill pill-confirmed mb-2">
                                        <i class="bi bi-shield-check"></i> تم التأكيد والدفع
                                    </span>
                                    <br />
                                    @if (!string.IsNullOrEmpty(session.meeting_link))
                                    {
                                        <a href="@(session.meeting_link.StartsWith("http") ? session.meeting_link : "https://" + session.meeting_link)" 
                                           target="_blank" 
                                           class="btn btn-turquoise rounded-pill px-4 mt-2 fw-bold shadow-sm">
                                             دخول الحصة مباشر <i class="bi bi-camera-video ms-2"></i>
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="small d-block mt-2" style="color: var(--dark-teal)">بانتظار الرابط من الأستاذ</span>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="text-center py-5 card" style="background: rgba(255,255,255,0.45) !important;">
            <i class="bi bi-calendar-x display-1" style="color: var(--primary-teal)"></i>
            <h3 class="mt-3" style="color: var(--dark-teal)">لا توجد دروس محجوزة حالياً</h3>
            <div class="text-center">
                 <a href="/Student/Index" class="btn btn-turquoise text-white rounded-pill px-5 py-2 mt-3 fw-bold">استكشف الدروس المتاحة</a>
            </div>
        </div>
    }
</div>