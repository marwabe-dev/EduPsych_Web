@model IEnumerable<EduPsych_Web.Models.CounselSession>
@{
    ViewData["Title"] = "أرشيف الجلسات - إبداع";
    Layout = "~/Views/Shared/_StudentLayout.cshtml";

    var fullName = Context.Session.GetString("UserName") ?? "تلميذنا العزيز";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

<style>
    :root {
        --creative-teal: #1eb2a6;
        --dark-teal: #0c3336;
        --soft-teal: rgba(30, 178, 166, 0.15);
        --status-gray: #718096;
    }

    /* إخفاء الهيدر الافتراضي الزائد */
    nav, .sidebar, header:not(.edu-header) {
        display: none !important;
    }

    /* كبسولة الهيدر محذوفة تلقائياً لاعتمادها من اللايوت الموحد */

    /* --- بطاقات الجلسات الزجاجية الموحدة --- */
    .session-creative-card {
        background: rgba(255, 255, 255, 0.45) !important;
        backdrop-filter: blur(20px) !important;
        -webkit-backdrop-filter: blur(20px) !important;
        border: 1px solid rgba(255, 255, 255, 0.4) !important;
        margin-bottom: 25px;
        transition: all 0.4s ease;
        display: flex;
        overflow: hidden;
        box-shadow: 0 10px 30px rgba(12, 51, 54, 0.05) !important;
        border-radius: 30px !important;
    }

    .session-creative-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 15px 35px rgba(30, 178, 166, 0.2) !important;
        border-color: var(--creative-teal) !important;
    }

    .card-visual-zone {
        width: 110px;
        background: linear-gradient(180deg, var(--creative-teal) 0%, var(--dark-teal) 100%);
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .icon-wrapper {
        width: 60px;
        height: 60px;
        background: rgba(255, 255, 255, 0.2);
        backdrop-filter: blur(5px);
        border-radius: 20px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 1.8rem;
    }

    .card-content-zone {
        flex-grow: 1;
        padding: 25px 35px;
        display: flex;
        flex-direction: column;
        justify-content: center;
    }

    .counselor-title {
        color: var(--dark-teal) !important;
        font-weight: 800;
        font-size: 1.4rem;
        margin-bottom: 4px;
    }

    .session-badge-type {
        color: var(--creative-teal);
        font-weight: 700;
        font-size: 0.95rem;
        display: flex;
        align-items: center;
        gap: 6px;
        margin-bottom: 15px;
    }

    .info-pill-container {
        display: flex;
        gap: 15px;
    }

    .info-pill {
        background: rgba(255, 255, 255, 0.5);
        border: 1px solid rgba(12, 51, 54, 0.1);
        padding: 8px 18px;
        border-radius: 15px;
        font-size: 0.85rem;
        color: var(--dark-teal) !important;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .card-action-zone {
        width: 240px;
        background: rgba(255, 255, 255, 0.25);
        border-right: 1px solid rgba(255, 255, 255, 0.3);
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 20px;
    }

    .status-pill {
        padding: 6px 15px;
        border-radius: 50px;
        font-size: 0.75rem;
        font-weight: 700;
        margin-bottom: 15px;
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .status-pending { background: rgba(113, 128, 150, 0.15); color: var(--status-gray); }
    .status-approved { background: rgba(184, 134, 11, 0.15); color: #b8860b; }
    .status-confirmed { background: rgba(40, 167, 69, 0.15); color: #28a745; }

    .btn-main-teal {
        background: var(--creative-teal);
        color: white !important;
        border: none;
        padding: 12px 30px;
        border-radius: 15px;
        font-weight: 700;
        transition: 0.3s;
        box-shadow: 0 8px 20px rgba(30, 178, 166, 0.25);
        text-decoration: none;
        width: 100%;
        text-align: center;
    }

    .btn-main-teal:hover {
        background: var(--dark-teal);
        transform: translateY(-2px);
    }

    .reveal-item {
        animation: revealUp 0.6s ease forwards;
        opacity: 0;
    }

    @@keyframes revealUp {
        from { opacity: 0; transform: translateY(30px); }
        to { opacity: 1; transform: translateY(0); }
    }

    @@media (max-width: 992px) {
        .session-creative-card { flex-direction: column; }
        .card-visual-zone { width: 100%; height: 80px; }
        .card-action-zone { width: 100%; border-right: none; border-top: 1px solid rgba(255,255,255,0.3); }
        .info-pill-container { flex-wrap: wrap; }
    }
</style>

<div class="container py-4">
    <div class="row mb-5 reveal-item">
        <div class="col-12 text-center text-md-end">
            <h2 class="fw-bold" style="color: var(--dark-teal)">جدول الحصص <span style="color:var(--creative-teal)">النفسية</span></h2>
            <p style="color: var(--dark-teal); opacity: 0.85;">مرحباً بك @fullName. تتبع حصصك النفسية وفق الجدول التالي وانضم إلى الحصة بالضغط على الرابط بعد إتمام عملية الدفع في صفحة محفظتي الموجودة في الأعلى.</p>
        </div>
    </div>

    @if (Model != null && Model.Any())
    {
        foreach (var item in Model.Select((value, index) => new { value, index }))
        {
            var session = item.value;
            var index = item.index;
            var statusLower = session.status?.Trim().ToLower() ?? "pending";

            <div class="col-12 reveal-item" style="animation-delay: @(index * 0.1)s">
                <div class="card session-creative-card">
                    
                    <div class="card-visual-zone">
                        <div class="icon-wrapper">
                            @if (statusLower == "confirmed" || statusLower == "paid")
                            {
                                <i class="bi bi-shield-check"></i>
                            }
                            else
                            {
                                <i class="bi bi-heart-pulse-fill"></i>
                            }
                        </div>
                    </div>

                    <div class="card-content-zone">
                        <h3 class="counselor-title">أ. @(session.Counselor?.User?.first_name) @(session.Counselor?.User?.last_name)</h3>
                        <div class="session-badge-type">
                            <i class="bi bi-patch-check"></i>
                            <span>جلسة @session.session_type</span>
                        </div>

                        <div class="info-pill-container">
                            <div class="info-pill">
                                <i class="bi bi-calendar3"></i>
                                <strong>@session.scheduled_at.ToString("dd MMMM, yyyy")</strong>
                            </div>
                            <div class="info-pill">
                                <i class="bi bi-clock"></i>
                                <strong>@session.scheduled_at.ToString("HH:mm tt")</strong>
                            </div>
                        </div>
                    </div>

                    <div class="card-action-zone">
                        @{
                            string statusClass = "status-pending";
                            string statusText = "قيد المراجعة";

                            if (statusLower == "approved") { statusClass = "status-approved"; statusText = "بانتظار الدفع"; }
                            else if (statusLower == "confirmed" || statusLower == "paid") { statusClass = "status-confirmed"; statusText = "تم التأكيد"; }
                            else if (statusLower == "cancelled") { statusClass = "status-pending"; statusText = "ملغاة"; }
                        }

                        <div class="status-pill @statusClass">
                            <i class="bi bi-record-circle-fill"></i>
                            @statusText
                        </div>

                       @if (statusLower == "approved")
{
    <a href="@Url.Action("MyWallet", "Student", new { paySessionId = session.id })" class="btn btn-main-teal">
        تأكيد ودفع <i class="bi bi-arrow-left ms-1"></i>
    </a>
}
                        else if (statusLower == "confirmed" || statusLower == "paid")
                        {
                            <div class="text-center w-100 px-3">
                                <span class="text-success small fw-bold d-block mb-2">
                                    <i class="bi bi-check-all"></i> موعد محجوز ومؤكد
                                </span>
                                
                                @if (!string.IsNullOrEmpty(session.meeting_link))
                                {
                                    <a href="@(session.meeting_link.StartsWith("http") ? session.meeting_link : "https://" + session.meeting_link)" target="_blank" class="btn btn-main-teal">
                                        دخول الجلسة المباشرة <i class="bi bi-camera-video ms-1"></i>
                                    </a>
                                }
                                else
                                {
                                    <span class="badge bg-light text-dark border px-3 py-2 rounded-pill w-100" style="background: rgba(255,255,255,0.6) !important;">
                                        بانتظار الرابط من المرشد...
                                    </span>
                                }
                            </div>
                        }
                        else
                        {
                            <span class="small text-center" style="color: var(--dark-teal)">بانتظار موافقة المستشار</span>
                        }
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="text-center py-5 card" style="background: rgba(255,255,255,0.45) !important;">
            <i class="bi bi-folder2-open display-1" style="color: var(--creative-teal)"></i>
            <h4 class="mt-3" style="color: var(--dark-teal)">لا يوجد سجل جلسات في الوقت الحالي</h4>
        </div>
    }
</div>