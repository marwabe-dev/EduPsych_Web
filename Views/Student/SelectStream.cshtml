@model IEnumerable<EduPsych_Web.Models.Stream>

@{
    ViewData["Title"] = "المسار التعليمي - اختيار الشعبة";
    Layout = "_Layout";
    
    // جلب الاسم من السيشن للهيدر
    var fullName = Context.Session.GetString("UserName") ?? "تلميذنا العزيز";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

<style>
    :root {
        --primary-teal: #1eb2a6;
        --dark-teal: #114b4d;
        --glass-white: rgba(255, 255, 255, 0.85);
    }

    body {
        background-color: #f0f7f7;
        font-family: 'Cairo', 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    /* إخفاء الهيدر الافتراضي */
    nav, .sidebar, header:not(.edu-header) {
        display: none !important;
    }

    /* --- الهيدر العائم (الكبسولة) الموحد --- */
    .edu-header {
        background: var(--glass-white);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(30, 178, 166, 0.15);
        padding: 12px 30px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        position: sticky;
        top: 15px;
        margin: 10px 20px 30px;
        z-index: 1050;
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.05);
        border-radius: 50px;
    }

    .edu-header .btn {
        border-radius: 50px !important;
        font-weight: 600;
        font-size: 0.85rem;
        transition: 0.3s;
    }

    /* تصميم بطاقات الشعب */
    .stream-card {
        border: none;
        border-radius: 40px;
        background: white;
        transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        overflow: hidden;
        border: 1px solid transparent;
    }

    .stream-card:hover {
        transform: translateY(-15px);
        box-shadow: 0 30px 60px rgba(30, 178, 166, 0.15) !important;
    }

    .icon-box {
        width: 100px;
        height: 100px;
        background: #f0fdfc;
        border-radius: 30px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 25px;
        font-size: 3rem;
        color: var(--primary-teal);
        transition: 0.4s;
    }

    .stream-card:hover .icon-box {
        background: var(--primary-teal);
        color: white;
        transform: rotateY(180deg);
    }

    .btn-stream {
        background: var(--primary-teal);
        color: white !important;
        border: none;
        padding: 15px;
        font-weight: 700;
        border-radius: 20px;
        transition: 0.3s;
        text-decoration: none;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
    }

    .btn-stream:hover {
        background: var(--dark-teal);
        transform: scale(1.02);
    }

    .text-turquoise { color: #1eb2a6 !important; }
    .bg-turquoise { background-color: #1eb2a6 !important; }
</style>

<div class="container-fluid p-0 text-end" dir="rtl">

    @* --- الهيدر العائم المستبدل --- *@
    <header class="edu-header">
        <div class="d-flex align-items-center">
            <div class="bg-turquoise text-white p-2 rounded-3 ms-3">
                <i class="bi bi-mortarboard-fill"></i>
            </div>
            <div class="d-flex flex-column">
                <h4 class="m-0 fw-bold text-dark">منصة <span class="text-turquoise">إبداع</span></h4>
            </div>
        </div>

        <div class="d-flex gap-2">
            <a href="@Url.Action("Index", "Student")" class="btn btn-light shadow-sm text-dark border">الرئيسية</a>
            <a href="@Url.Action("MyWallet", "Student")" class="btn btn-white shadow-sm text-dark border">محفظتي</a>
            <a href="@Url.Action("Courses", "Student")" class="btn btn-white shadow-sm text-dark border">متجر الدورات</a>
            <a href="@Url.Action("MyEducationalLessons", "Student")" class="btn btn-white shadow-sm text-dark border">حصصي التعليمية</a>
            <a href="@Url.Action("MyCounselSessions", "Student")" class="btn btn-white shadow-sm text-dark border">حصصي النفسية</a>
        </div>

        <div class="dropdown">
            <button class="btn btn-light rounded-circle shadow-sm" type="button" data-bs-toggle="dropdown">
                <i class="bi bi-person-fill text-turquoise"></i>
            </button>
            <ul class="dropdown-menu dropdown-menu-end shadow border-0 rounded-4 mt-2">
                <li><a class="dropdown-item py-3 text-danger fw-bold" href="@Url.Action("Logout", "Account")"><i class="bi bi-box-arrow-right ms-2"></i>تسجيل الخروج</a></li>
            </ul>
        </div>
    </header>

    <div class="container">
        <div class="text-center py-5">
            <h1 class="fw-bold text-dark">اختر تخصصك الدراسي</h1>
            <p class="text-muted fs-5">مرحباً بك يا @fullName، حدد الشعبة للوصول إلى المحتوى المخصص لك</p>
            <div style="width: 60px; height: 5px; background: #1eb2a6; margin: 15px auto; border-radius: 10px;"></div>
        </div>

        <div class="row g-4 justify-content-center pb-5">
            @if (Model != null && Model.Any())
            {
                @foreach (var item in Model)
                {
                    <div class="col-lg-4 col-md-6">
                        <div class="card h-100 stream-card shadow-sm p-3">
                            <div class="card-body text-center p-4">
                                <div class="icon-box shadow-sm">
                                    <i class="bi bi-layers-half"></i>
                                </div>
                                
                                <h3 class="fw-bold mb-3 text-dark">@item.name</h3>
                                
                                <p class="text-muted mb-4 px-2">
                                    استكشف عالم المواد الدراسية، الاختبارات، والمحتوى التفاعلي الخاص بشعبة <b>@item.name</b>.
                                </p>
                                
                                <a href="@Url.Action("SelectSubject", "Student", new { streamId = item.id })"
                                   class="btn-stream shadow-sm">
                                    <span>استعرض المواد</span>
                                    <i class="bi bi-arrow-left-circle"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="col-12 text-center py-5">
                    <div class="p-5 bg-white rounded-5 shadow-sm d-inline-block" style="border: 2px dashed #1eb2a6;">
                        <i class="bi bi-emoji-neutral text-turquoise display-1 mb-3"></i>
                        <h4 class="text-dark fw-bold">قيد التجهيز...</h4>
                        <p class="text-muted">لم نقم بإضافة شعب دراسية لهذا الصف بعد.</p>
                        <a href="/Student/EducationalPath" class="btn btn-turquoise text-white rounded-pill px-5 mt-3 fw-bold">العودة للخلف</a>
                    </div>
                </div>
            }
        </div>
    </div>
</div>