@model IEnumerable<EduPsych_Web.Models.Course>
@{
    Layout = "_Layout";
    var userName = Context.Session.GetString("UserName") ?? "تلميذنا";
}

<style>
    body { background-color: #f0f7f7; font-family: 'Cairo', sans-serif; }
    nav, .sidebar, header:not(.edu-header) { display: none !important; }
    
    .edu-header {
        background: rgba(255, 255, 255, 0.85); backdrop-filter: blur(10px);
        border: 1px solid rgba(30, 178, 166, 0.15); padding: 12px 30px;
        display: flex; justify-content: space-between; align-items: center;
        position: sticky; top: 15px; margin: 10px 20px 30px; z-index: 1050;
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.05); border-radius: 50px;
    }

    .course-card {
        border-radius: 30px; border: none; transition: 0.3s;
        overflow: hidden; background: white;
    }
    .course-card:hover { transform: translateY(-10px); box-shadow: 0 15px 30px rgba(0,0,0,0.1) !important; }
    
    .progress-bar-custom {
        height: 8px; border-radius: 10px; background-color: #e9ecef;
    }
    .progress-fill {
        height: 100%; border-radius: 10px; background: linear-gradient(90deg, #1eb2a6, #2bd2c5);
    }
</style>

<div class="container-fluid p-0 text-end" dir="rtl">
    <header class="edu-header">
        <div class="d-flex align-items-center">
            <div class="bg-turquoise text-white p-2 rounded-3 ms-3">
                <i class="bi bi-book-half"></i>
            </div>
            <h4 class="m-0 fw-bold text-dark">دوراتي <span style="color:#1eb2a6">التعليمية</span></h4>
        </div>
        <div class="d-flex gap-2">
            <a href="@Url.Action("Index", "Student")" class="btn btn-light rounded-pill px-3 border shadow-sm fw-bold">
                <i class="bi bi-house-door ms-1"></i> الرئيسية
            </a>
            <a href="@Url.Action("Courses", "Student")" class="btn btn-white rounded-pill px-3 border shadow-sm fw-bold text-dark">
                <i class="bi bi-shop ms-1 text-warning"></i> متجر الدورات
            </a>
        </div>
    </header>

    <div class="container mt-4">
        <div class="row">
            @if (Model == null || !Model.Any())
            {
                <div class="col-12 text-center py-5">
                    <div class="mb-4">
                        <i class="bi bi-journal-x text-muted" style="font-size: 5rem;"></i>
                    </div>
                    <h4 class="text-muted">لم تشترك في أي دورة بعد.</h4>
                    <p class="text-secondary">استكشف المتجر وابدأ رحلة تعلمك الآن!</p>
                    <a href="@Url.Action("Courses", "Student")" class="btn btn-turquoise text-white rounded-pill px-5 mt-3">انتقل للمتجر</a>
                </div>
            }
            else
            {
                @foreach (var course in Model)
                {
                    <div class="col-md-4 mb-4">
                        <div class="card course-card shadow-sm h-100">
                            <img src="@(string.IsNullOrEmpty(course.thumbnail_url) ? "/images/default.jpg" : course.thumbnail_url)" class="card-img-top" style="height:180px; object-fit:cover;">
                            <div class="card-body d-flex flex-column">
                                <h5 class="fw-bold mb-2">@course.title</h5>
                                <p class="text-muted small flex-grow-1">@course.description</p>
                                
                                <div class="mt-3">
                                    <div class="d-flex justify-content-between mb-1">
                                        <span class="small text-muted">تقدمك</span>
                                        <span class="small fw-bold text-turquoise">0%</span>
                                    </div>
                                    <div class="progress-bar-custom">
                                        <div class="progress-fill" style="width: 0%"></div>
                                    </div>
                                </div>

                                <a href="@Url.Action("ViewCourse", "Student", new { id = course.id })" class="btn btn-turquoise text-white rounded-pill w-100 mt-4 shadow-sm">
                                    <i class="bi bi-play-circle-fill ms-2"></i> متابعة التعلم
                                </a>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</div>