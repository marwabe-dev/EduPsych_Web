@model EduPsych_Web.Models.Subject
@{
    Layout = "~/Views/Shared/_StudentLayout.cshtml";
    ViewData["Title"] = "محتوى المادة - " + Model.name;
    
    // تحويل البيانات صراحةً إلى قوائم لضمان استقرار محرك Razor واختفاء الأخطاء
    var lessons = ViewBag.Lessons as List<EduPsych_Web.Models.Lesson> ?? new List<EduPsych_Web.Models.Lesson>();
    var exercises = ViewBag.Exercises as List<EduPsych_Web.Models.Exercise> ?? new List<EduPsych_Web.Models.Exercise>();
    var exams = ViewBag.Exams as List<EduPsych_Web.Models.Exam> ?? new List<EduPsych_Web.Models.Exam>();
}

<style>
    body { background-color: #f4fdfc; font-family: 'Cairo', sans-serif; }
    nav, .sidebar, header:not(.edu-header) { display: none !important; }

    .edu-header {
        background: rgba(255, 255, 255, 0.9); backdrop-filter: blur(10px);
        border: 1px solid rgba(30, 178, 166, 0.15); padding: 12px 30px;
        display: flex; justify-content: space-between; align-items: center;
        position: sticky; top: 15px; margin: 10px 20px 30px; z-index: 1050;
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.05); border-radius: 50px;
    }

    .content-section { background: white; border-radius: 30px; padding: 30px; margin-bottom: 30px; box-shadow: 0 10px 30px rgba(30,178,166,0.03); }
    .section-title { color: #1eb2a6; font-weight: 800; margin-bottom: 25px; display: flex; align-items: center; gap: 10px; }
    
    /* الكروت المطورة بوجود الغلاف البصري المرفوع حقيقياً */
    .visual-card {
        background: white; border-radius: 24px; overflow: hidden;
        border: 1px solid #eef7f6; transition: 0.3s; height: 100%;
        display: flex; flex-direction: column; box-shadow: 0 4px 15px rgba(0,0,0,0.01);
    }
    .visual-card:hover { transform: translateY(-7px); border-color: #1eb2a6; box-shadow: 0 12px 25px rgba(30,178,166,0.08); }

    /* تنسيق أغطية الصور الحقيقية المستقرة */
    .card-real-cover {
        height: 150px; width: 100%; object-fit: cover; border-bottom: 1px solid #eef7f6;
    }

    .card-body-custom { padding: 18px; flex-grow: 1; }
    .btn-turquoise { background-color: #1eb2a6 !important; color: white !important; border-radius: 50px; font-weight: 600; padding: 8px 20px; text-decoration: none; }
</style>

<div class="container-fluid p-0 text-end" dir="rtl">
    
    

    <div class="container">
        
        @* 1. قسم الدروس المسجلة *@
        <div class="content-section">
            <h4 class="section-title"><i class="bi bi-collection-play-fill"></i> الدروس المسجلة ومذكرات المراجعة</h4>
            @if (lessons != null && lessons.Any())
            {
                <div class="row g-4">
                    @foreach (var lesson in lessons)
                    {
                        <div class="col-md-6 col-lg-4">
                            <div class="visual-card">
                                <div class="position-relative">
                                    <img src="@(string.IsNullOrEmpty(lesson.video_url) ? "/uploads/pdf/default_cover.jpg" : lesson.video_url)" class="card-real-cover" alt="غلاف الدرس" />
                                    <span class="position-absolute top-0 start-0 m-3 badge bg-success shadow-sm">FREE LESSON</span>
                                </div>
                                <div class="card-body-custom d-flex flex-column h-100">
                                    <h5 class="fw-bold text-dark mb-2">@lesson.title</h5>
                                    <p class="text-muted small mb-4">@lesson.description</p>
                                    <div class="mt-auto pt-2">
                                        @* 🛠️ قفل الثغرة نهائياً عبر فحص المسار الموحد المكتوب بجدول الـ database الفعلي *@
                                        @if (!string.IsNullOrEmpty(lesson.pdf_url))
                                        {
                                            <a href="@lesson.pdf_url" target="_blank" class="btn btn-turquoise btn-sm rounded-pill w-100 text-center fw-bold">تحميل ملخص PDF</a>
                                        }
                                        else if (!string.IsNullOrEmpty(lesson.pdf_summary_url))
                                        {
                                            <a href="@lesson.pdf_summary_url" target="_blank" class="btn btn-turquoise btn-sm rounded-pill w-100 text-center fw-bold">تحميل ملخص PDF</a>
                                        }
                                        else
                                        {
                                            <button class="btn btn-outline-secondary btn-sm rounded-pill w-100 text-center" disabled><i class="bi bi-file-lock me-1"></i> لا يوجد ملف مرفق</button>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <p class="text-center text-muted py-4">لا توجد دروس مسجلة متاحة حالياً.</p>
            }
        </div>

        @* 2. قسم التمارين الملونة *@
        <div class="content-section">
            <h4 class="section-title"><i class="bi bi-pencil-square"></i> سلاسل التمارين والدعم البيداغوجي</h4>
            @if (exercises != null && exercises.Any())
            {
                <div class="row g-4">
                    @foreach (var exercise in exercises)
                    {
                        <div class="col-md-6 col-lg-4">
                            <div class="visual-card">
                                <div class="position-relative">
                                    <img src="@(string.IsNullOrEmpty(exercise.Lesson?.video_url) ? "/uploads/pdf/default_cover.jpg" : exercise.Lesson.video_url)" class="card-real-cover" alt="غلاف التمرين" />
                                    <span class="position-absolute top-0 start-0 m-3 badge bg-warning text-dark shadow-sm fw-bold">EXERCISE</span>
                                </div>
                                <div class="card-body-custom d-flex flex-column h-100">
                                    <h5 class="fw-bold text-dark mb-1">@exercise.title</h5>
                                    <p class="text-muted small mb-4">@exercise.description</p>
                                    <div class="mt-auto">
                                        @if (!string.IsNullOrEmpty(exercise.file_url))
                                        {
                                            <a href="@exercise.file_url" target="_blank" class="btn btn-dark btn-sm rounded-pill w-100 text-center fw-bold">تحميل السلسلة <i class="bi bi-download ms-1"></i></a>
                                        }
                                        else
                                        {
                                            <button class="btn btn-sm btn-light rounded-pill w-100 text-center" disabled>لا يوجد ملف مرفق</button>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <p class="text-center text-muted py-4">لا توجد تمارين متاحة لهذه المادة حالياً.</p>
            }
        </div>

        @* 3. قسم الاختبارات والفروض *@
        <div class="content-section mb-5">
            <h4 class="section-title"><i class="bi bi-file-earmark-ruled"></i> نماذج الفروض والامتحانات الفصلية</h4>
            @if (exams != null && exams.Any())
            {
                <div class="row g-4">
                    @foreach (var exam in exams)
                    {
                        <div class="col-md-6 col-lg-4">
                            <div class="visual-card">
                                <div class="position-relative">
                                    <img src="@(string.IsNullOrEmpty(exam.exam_type) || exam.exam_type.Contains("فصلي") || exam.exam_type.Contains("Term") ? "/uploads/pdf/default_cover.jpg" : exam.exam_type)" class="card-real-cover" alt="غلاف الاختبار" />
                                    <span class="position-absolute top-0 start-0 m-3 badge bg-danger shadow-sm">EXAM</span>
                                </div>
                                <div class="card-body-custom text-center d-flex flex-column h-100">
                                    <h6 class="fw-bold text-dark mb-1">@exam.title</h6>
                                    <span class="badge bg-light text-secondary border my-2 mx-auto small">نموذج فصلي للتدريب</span>
                                    <div class="mt-auto pt-3">
                                        <a href="@exam.file_url" target="_blank" class="btn btn-outline-primary btn-sm rounded-pill w-100 fw-bold">عرض النموذج والحل</a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            } 
            else
            {
                <p class="text-center text-muted py-4">لم يتم رفع نماذج اختبارات بعد.</p>
            }
        </div>
    </div>
</div>