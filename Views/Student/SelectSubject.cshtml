@model IEnumerable<EduPsych_Web.Models.Subject>

@{
    ViewData["Title"] = "المواد الدراسية - إبداع";
    Layout = "_Layout";

    // جلب الاسم من السيشن للهيدر لضمان التناسق
    var fullName = Context.Session.GetString("UserName") ?? "تلميذنا العزيز";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

<style>
    :root {
        --primary-teal: #1eb2a6;
        --dark-teal: #114b4d;
        --glass-white: rgba(255, 255, 255, 0.85);
    }

    body {
        background-color: #f4fdfc;
        font-family: 'Cairo', 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    /* إخفاء الهيدر الافتراضي لفرض التصميم الجديد */
    nav, .sidebar, header:not(.edu-header) {
        display: none !important;
    }

    /* --- الهيدر العائم (الكبسولة) الموحد --- */
    .edu-header {
        background: var(--glass-white);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(30, 178, 166, 0.15);
        padding: 12px 30px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        position: sticky;
        top: 15px;
        margin: 10px 20px 30px;
        z-index: 1050;
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.05);
        border-radius: 50px;
    }

    .edu-header .btn {
        border-radius: 50px !important;
        font-weight: 600;
        font-size: 0.85rem;
        transition: 0.3s;
    }

    /* تصميم كروت المواد */
    .subject-card {
        background: white;
        border: none;
        border-radius: 40px;
        padding: 30px;
        transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        position: relative;
        overflow: hidden;
        border: 1px solid rgba(0,0,0,0.02);
    }

    .subject-card:hover {
        transform: translateY(-12px);
        box-shadow: 0 25px 50px rgba(30, 178, 166, 0.12) !important;
    }

    .icon-box-subject {
        width: 75px;
        height: 75px;
        background: #f0fdfc;
        border-radius: 25px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 20px;
        font-size: 2.2rem;
        color: var(--primary-teal);
        transition: 0.3s;
    }

    .subject-card:hover .icon-box-subject {
        background: var(--primary-teal);
        color: white;
    }

    .btn-main {
        background: var(--primary-teal);
        color: white !important;
        border-radius: 18px;
        padding: 12px;
        font-weight: 700;
        transition: 0.3s;
        border: none;
        text-decoration: none;
    }

    .btn-main:hover {
        background: var(--dark-teal);
        transform: scale(1.02);
    }

    .btn-details {
        background: #f8fbfb;
        color: var(--primary-teal);
        border: 1px solid #eef7f6;
        border-radius: 18px;
        padding: 10px;
        font-weight: 600;
        text-decoration: none;
        transition: 0.3s;
    }

    .btn-details:hover {
        background: #eef7f6;
    }

    .text-turquoise { color: #1eb2a6 !important; }
    .bg-turquoise { background-color: #1eb2a6 !important; }
</style>

<div class="container-fluid p-0 text-end" dir="rtl">

    @* --- الهيدر العائم المستبدل --- *@
    <header class="edu-header">
        <div class="d-flex align-items-center">
            <div class="bg-turquoise text-white p-2 rounded-3 ms-3">
                <i class="bi bi-mortarboard-fill"></i>
            </div>
            <div class="d-flex flex-column">
                <h4 class="m-0 fw-bold text-dark">منصة <span class="text-turquoise">إبداع</span></h4>
            </div>
        </div>

        <div class="d-flex gap-2">
            <a href="@Url.Action("Index", "Student")" class="btn btn-light shadow-sm text-dark border">الرئيسية</a>
            <a href="@Url.Action("MyWallet", "Student")" class="btn btn-white shadow-sm text-dark border">محفظتي</a>
            <a href="@Url.Action("Courses", "Student")" class="btn btn-white shadow-sm text-dark border">متجر الدورات</a>
            <a href="@Url.Action("MyEducationalLessons", "Student")" class="btn btn-white shadow-sm text-dark border">حصصي التعليمية</a>
            <a href="@Url.Action("MyCounselSessions", "Student")" class="btn btn-white shadow-sm text-dark border">حصصي النفسية</a>
        </div>

        <div class="dropdown">
            <button class="btn btn-light rounded-circle shadow-sm" type="button" data-bs-toggle="dropdown">
                <i class="bi bi-person-fill text-turquoise"></i>
            </button>
            <ul class="dropdown-menu dropdown-menu-end shadow border-0 rounded-4 mt-2">
                <li><a class="dropdown-item py-3 text-danger fw-bold" href="@Url.Action("Logout", "Account")"><i class="bi bi-box-arrow-right ms-2"></i>تسجيل الخروج</a></li>
            </ul>
        </div>
    </header>

    <div class="container">
        <div class="text-center py-5">
            <span class="badge bg-turquoise text-white mb-2 px-3 py-2 rounded-pill">القسم التعليمي</span>
            <h1 class="fw-bold text-dark mb-2">المواد الدراسية</h1>
            <p class="text-muted fs-5">مرحباً بك يا @fullName، اختر المادة التي ترغب في مراجعتها الآن</p>
        </div>

        <div class="row g-4 pb-5">
            @foreach (var item in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="subject-card shadow-sm h-100 d-flex flex-column">
                        
                        <div class="icon-box-subject">
                            <i class="bi bi-journal-bookmark-fill"></i>
                        </div>

                        <div class="mb-4 text-center text-md-end">
                            <h3 class="fw-bold text-dark mb-2">@item.name</h3>
                            <div class="d-flex align-items-center justify-content-center justify-content-md-start gap-2">
                                <span class="small text-muted"><i class="bi bi-check2-circle text-turquoise"></i> دروس دعم</span>
                                <span class="small text-muted"><i class="bi bi-check2-circle text-turquoise"></i> تمارين</span>
                            </div>
                        </div>

                        <div class="mt-auto">
                            <div class="d-grid gap-2">
                                <a href="@Url.Action("ExploreTeachers", "Student", new { subjectId = item.id })" 
                                   class="btn btn-main d-flex align-items-center justify-content-center gap-2">
                                    <span>اكتشف الأساتذة</span>
                                    <i class="bi bi-person-badge"></i>
                                </a>
                                
                                <a href="@Url.Action("SubjectDetails", "Student", new { subjectId = item.id })" 
                                   class="btn btn-details d-flex align-items-center justify-content-center gap-2">
                                    <span>محتوى المادة</span>
                                    <i class="bi bi-folder2-open"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>