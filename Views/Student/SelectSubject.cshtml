@model IEnumerable<EduPsych_Web.Models.Subject>

@{
    ViewData["Title"] = "المواد الدراسية - إبداع";
    Layout = "~/Views/Shared/_StudentLayout.cshtml";
    // جلب الاسم من السيشن للهيدر لضمان التناسق
    var fullName = Context.Session.GetString("UserName") ?? "تلميذنا العزيز";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

<style>
    :root {
        --primary-teal: #1eb2a6;
        --dark-teal: #0c3336; 
        --glass-bg: rgba(255, 255, 255, 0.45); 
        --glass-border: rgba(255, 255, 255, 0.6);
    }

    body {
        font-family: 'Cairo', 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    /* إخفاء الهيدر الافتراضي لفرض التصميم الجديد */
    nav, .sidebar, header:not(.edu-header) {
        display: none !important;
    }

    /* حاوية الصفحة وتأثير الحركة */
    .subject-page-wrapper {
        padding: 30px 0;
        animation: fadeInPage 0.5s ease-in-out;
    }

    /* تصميم كروت المواد المصغرة والمكثفة (Glassmorphism) */
    .compact-subject-card {
        background: var(--glass-bg) !important;
        backdrop-filter: blur(20px) !important;
        -webkit-backdrop-filter: blur(20px) !important;
        border: 1px solid var(--glass-border) !important;
        border-radius: 22px !important;
        padding: 20px !important;
        box-shadow: 0 8px 24px rgba(12, 51, 54, 0.04) !important;
        transition: all 0.35s cubic-bezier(0.165, 0.84, 0.44, 1) !important;
        position: relative;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        height: 100%;
    }

    /* تأثيرات الحركة الرشيقة عند تمرير الماوس */
    .compact-subject-card:hover {
        transform: translateY(-6px);
        background: rgba(255, 255, 255, 0.8) !important;
        border-color: rgba(30, 178, 166, 0.3) !important;
        box-shadow: 0 15px 35px rgba(12, 51, 54, 0.08) !important;
    }

    /* 🛠️ تعديل: صندوق الأيقونة يظهر باللون التركوازي الرئيسي من البداية */
    .icon-box-subject-mini {
        width: 52px;
        height: 52px;
        background: linear-gradient(135deg, var(--primary-teal) 0%, #148f85 100%);
        border: 1px solid rgba(30, 178, 166, 0.2);
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
        color: white; /* أيقونة بيضاء واضحة */
        transition: all 0.3s ease;
        box-shadow: 0 4px 12px rgba(30, 178, 166, 0.2);
    }

    /* عند تمرير الماوس يتحول صندوق الأيقونة إلى تباين داكن وجذاب */
    .compact-subject-card:hover .icon-box-subject-mini {
        background: linear-gradient(135deg, var(--dark-teal) 0%, #114246 100%);
        color: white;
        transform: scale(1.05);
        box-shadow: 0 4px 12px rgba(12, 51, 54, 0.15);
    }

    /* نصوص الكرت المصغرة */
    .subject-mini-title {
        font-size: 1.15rem !important;
        font-weight: 800 !important;
        color: var(--dark-teal) !important;
        margin: 0;
        text-shadow: none !important;
    }

    .feature-tag {
        font-size: 0.78rem !important;
        font-weight: 700;
        color: rgba(12, 51, 54, 0.65) !important;
        background: rgba(30, 178, 166, 0.06);
        padding: 3px 10px;
        border-radius: 30px;
        display: inline-flex;
        align-items: center;
        gap: 4px;
    }

    /* صف أزرار التحكم مصفوفة أفقياً */
    .subject-actions-row {
        display: flex;
        gap: 10px;
        margin-top: 15px;
    }

    /* 🛠️ تعديل: زر "اكتشف الأساتذة" يظهر باللون التركوازي الرئيسي من البداية */
    .btn-action-discover {
        flex: 2;
        background: linear-gradient(135deg, var(--primary-teal) 0%, #148f85 100%);
        color: white !important;
        border: none;
        padding: 9px 12px;
        border-radius: 14px;
        font-size: 0.82rem;
        font-weight: 700;
        transition: all 0.25s ease;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        text-decoration: none;
        box-shadow: 0 4px 12px rgba(30, 178, 166, 0.15);
    }

    /* عند تمرير الماوس على الكرت، يتحول الزر إلى اللون الداكن ليعطي حركة تفاعلية رشيقة */
    .compact-subject-card:hover .btn-action-discover {
        background: linear-gradient(135deg, var(--dark-teal) 0%, rgba(12, 51, 54, 0.88) 100%);
        box-shadow: 0 4px 12px rgba(12, 51, 54, 0.2);
    }

    /* زر تفاصيل المحتوى */
    .btn-action-details {
        flex: 1;
        background: rgba(255, 255, 255, 0.6);
        color: var(--primary-teal) !important;
        border: 1px solid rgba(30, 178, 166, 0.25);
        padding: 9px 10px;
        border-radius: 14px;
        font-size: 0.82rem;
        font-weight: 700;
        transition: all 0.25s ease;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 4px;
        text-decoration: none;
    }

    .btn-action-details:hover {
        background: rgba(30, 178, 166, 0.08);
        border-color: var(--primary-teal);
    }

    .text-turquoise { color: #1eb2a6 !important; }
    .bg-turquoise { background-color: #1eb2a6 !important; }

    @@keyframes fadeInPage {
        from { opacity: 0; transform: translateY(10px); }
        to { opacity: 1; transform: translateY(0); }
    }
</style>

<div class="container-fluid p-0 text-end subject-page-wrapper" dir="rtl">
    <div class="container">
        <div class="text-center py-4">
            <span class="badge bg-turquoise text-white mb-2 px-3 py-2 rounded-pill" style="font-weight:700; font-size:0.78rem;">القسم التعليمي</span>
            <h1 class="fw-bold text-dark mb-2" style="font-size: 1.8rem;">المواد الدراسية</h1>
            <p class="text-muted fs-6">مرحباً بك يا @fullName، اختر المادة التي ترغب في مراجعتها الآن</p>
            <div style="width: 40px; height: 3.5px; background: var(--primary-teal); margin: 12px auto; border-radius: 10px;"></div>
        </div>

        <div class="row g-3 pb-5">
            @foreach (var item in Model)
            {
                <div class="col-xl-4 col-md-6 col-sm-12">
                    <div class="compact-subject-card">
                        
                        <div class="d-flex align-items-center gap-3 mb-3">
                            <div class="icon-box-subject-mini">
                                <i class="bi bi-journal-bookmark-fill"></i>
                            </div>
                            <div>
                                <h3 class="subject-mini-title">@item.name</h3>
                                <div class="d-flex gap-1.5 mt-1">
                                    <span class="feature-tag"><i class="bi bi-check2 text-turquoise"></i> دروس دعم</span>
                                    <span class="feature-tag"><i class="bi bi-check2 text-turquoise"></i> تمارين</span>
                                </div>
                            </div>
                        </div>

                        <div class="mt-auto subject-actions-row">
                            <a href="@Url.Action("ExploreTeachers", "Student", new { subjectId = item.id })" class="btn-action-discover">
                                <span>اكتشف الأساتذة</span>
                                <i class="bi bi-person-badge"></i>
                            </a>
                            
                            <a href="@Url.Action("SubjectDetails", "Student", new { subjectId = item.id })" class="btn-action-details" title="عرض تفاصيل ومحتوى المادة">
                                <span>المحتوى</span>
                                <i class="bi bi-folder2-open"></i>
                            </a>
                        </div>

                    </div>
                </div>
            }
        </div>
    </div>
</div>