@model IEnumerable<EduPsych_Web.Models.Class>

@{
    ViewData["Title"] = "المسار التعليمي - اختيار الصف";
    Layout = "_Layout";
    
    // جلب الاسم من السيشن للهيدر
    var fullName = Context.Session.GetString("UserName") ?? "تلميذنا العزيز";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

<style>
    :root {
        --primary-teal: #1eb2a6;
        --dark-teal: #114b4d;
        --glass-white: rgba(255, 255, 255, 0.85);
    }

    body {
        background-color: #f0f7f7;
        font-family: 'Cairo', 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    /* إخفاء الهيدر الافتراضي */
    nav, .sidebar, header:not(.edu-header) {
        display: none !important;
    }

    /* --- الهيدر العائم (الكبسولة) الموحد --- */
    .edu-header {
        background: var(--glass-white);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(30, 178, 166, 0.15);
        padding: 12px 30px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        position: sticky;
        top: 15px;
        margin: 10px 20px 30px;
        z-index: 1050;
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.05);
        border-radius: 50px;
    }

    .edu-header .btn {
        border-radius: 50px !important;
        font-weight: 600;
        font-size: 0.85rem;
        transition: 0.3s;
    }

    /* عنوان الصفحة */
    .page-title {
        color: var(--dark-teal);
        font-weight: 800;
        position: relative;
        display: inline-block;
    }

    /* تصميم الكروت */
    .class-card {
        background: white;
        border: none;
        border-radius: 35px;
        transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        overflow: hidden;
    }

    .class-card:hover {
        transform: translateY(-15px);
        box-shadow: 0 25px 50px rgba(30, 178, 166, 0.12) !important;
    }

    .icon-wrapper {
        width: 80px;
        height: 80px;
        background: #f0fdfc;
        border-radius: 25px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 20px;
        transition: 0.3s;
    }

    .class-card:hover .icon-wrapper {
        background: var(--primary-teal);
        transform: rotate(-10deg);
    }

    .icon-wrapper i {
        font-size: 2.2rem;
        color: var(--primary-teal);
        transition: 0.3s;
    }

    .class-card:hover .icon-wrapper i {
        color: white;
    }

    .btn-action {
        background: var(--primary-teal);
        color: white !important;
        border: none;
        border-radius: 20px;
        padding: 12px 25px;
        font-weight: 700;
        transition: 0.3s;
        text-decoration: none;
        display: inline-block;
    }

    .btn-action:hover {
        background: var(--dark-teal);
        transform: scale(1.05);
    }

    .text-turquoise { color: #1eb2a6 !important; }
    .bg-turquoise { background-color: #1eb2a6 !important; }
</style>

<div class="container-fluid p-0 text-end" dir="rtl">

    @* --- الهيدر العائم المستبدل --- *@
    <header class="edu-header">
        <div class="d-flex align-items-center">
            <div class="bg-turquoise text-white p-2 rounded-3 ms-3">
                <i class="bi bi-mortarboard-fill"></i>
            </div>
            <div class="d-flex flex-column">
                <h4 class="m-0 fw-bold text-dark">منصة <span class="text-turquoise">إبداع</span></h4>
            </div>
        </div>

        <div class="d-flex gap-2">
            <a href="@Url.Action("Index", "Student")" class="btn btn-light shadow-sm text-dark border">الرئيسية</a>
            <a href="@Url.Action("MyWallet", "Student")" class="btn btn-white shadow-sm text-dark border">محفظتي</a>
            <a href="@Url.Action("Courses", "Student")" class="btn btn-white shadow-sm text-dark border">متجر الدورات</a>
            <a href="@Url.Action("MyEducationalLessons", "Student")" class="btn btn-white shadow-sm text-dark border">حصصي التعليمية</a>
            <a href="@Url.Action("MyCounselSessions", "Student")" class="btn btn-white shadow-sm text-dark border">حصصي النفسية</a>
        </div>

        <div class="dropdown">
            <button class="btn btn-light rounded-circle shadow-sm" type="button" data-bs-toggle="dropdown">
                <i class="bi bi-person-fill text-turquoise"></i>
            </button>
            <ul class="dropdown-menu dropdown-menu-end shadow border-0 rounded-4 mt-2">
                <li><a class="dropdown-item py-3 text-danger fw-bold" href="@Url.Action("Logout", "Account")"><i class="bi bi-box-arrow-right ms-2"></i>تسجيل الخروج</a></li>
            </ul>
        </div>
    </header>

    <div class="container py-4">
        <div class="text-center mb-5">
            <h1 class="page-title mb-3">اختر مستواك الدراسي</h1>
            <p class="text-muted fs-5">مرحباً بك يا @fullName، اختر سنتك الدراسية لنبدأ الرحلة</p>
        </div>

        <div class="row g-4 justify-content-center">
            @if (Model != null && Model.Any())
            {
                @foreach (var item in Model)
                {
                    <div class="col-lg-4 col-md-6 text-center">
                        <div class="card h-100 shadow-sm class-card">
                            <div class="card-body p-5">
                                <div class="icon-wrapper">
                                    <i class="bi bi-mortarboard"></i>
                                </div>
                                
                                <h3 class="fw-bold mb-3 text-dark">@item.name</h3>
                                
                                <p class="text-muted mb-4 px-3 small">
                                    اكتشف الشعب المتاحة، الدروس المسجلة، والتمارين التفاعلية لهذا المستوى.
                                </p>
                                
                                <a href="@Url.Action("SelectStream", "Student", new { classId = item.id })"
                                   class="btn-action w-100">
                                    <i class="bi bi-rocket-takeoff-fill ms-2"></i> انطلق الآن
                                </a>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="col-12">
                    <div class="bg-white rounded-5 p-5 shadow-sm text-center">
                        <i class="bi bi-folder-x text-muted" style="font-size: 5rem; opacity: 0.3;"></i>
                        <h3 class="mt-4 fw-bold text-secondary">عذراً، الجداول قيد التحديث</h3>
                        <a href="@Url.Action("Index", "Student")" class="btn-action px-5 mt-3">العودة للرئيسية</a>
                    </div>
                </div>
            }
        </div>
    </div>
</div>