@model IEnumerable<EduPsych_Web.Models.Lesson>
@{
    ViewData["Title"] = "الأساتذة المتاحون - إبداع";
    Layout = "~/Views/Shared/_StudentLayout.cshtml";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

<style>
    body {
        background-color: #f4fdfc;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    /* الهيدر العائم المتناسق */
    .edu-header {
        background: rgba(255, 255, 255, 0.9);
        backdrop-filter: blur(15px);
        border: 1px solid rgba(30, 178, 166, 0.1);
        padding: 12px 30px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        position: sticky;
        top: 15px;
        margin: 10px 20px;
        z-index: 1000;
        box-shadow: 0 8px 32px rgba(0,0,0,0.05);
        border-radius: 50px;
    }

    .text-turquoise { color: #1eb2a6 !important; }
    .bg-turquoise { background-color: #1eb2a6 !important; }

    /* تصميم بطاقة الأستاذ الاحترافية */
    .teacher-card {
        background: white;
        border: none;
        border-radius: 40px;
        padding: 35px 25px;
        transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        text-align: center;
        position: relative;
        overflow: hidden;
        border: 1px solid rgba(30, 178, 166, 0.05);
    }

    .teacher-card:hover {
        transform: translateY(-15px);
        box-shadow: 0 30px 60px rgba(30, 178, 166, 0.15) !important;
        border-color: rgba(30, 178, 166, 0.2);
    }

    /* إطار صورة الأستاذ */
    .teacher-avatar-wrapper {
        width: 120px;
        height: 120px;
        margin: 0 auto 20px;
        padding: 8px;
        background: linear-gradient(135deg, #1eb2a6 0%, #114b4d 100%);
        border-radius: 50%;
        position: relative;
    }

    .teacher-avatar-wrapper img {
        width: 100%;
        height: 100%;
        border-radius: 50%;
        object-fit: cover;
        background: white;
        border: 4px solid white;
    }

    /* شارة "متاح" أونلاين */
    .status-badge {
        position: absolute;
        bottom: 10px;
        right: 10px;
        width: 20px;
        height: 20px;
        background: #2ecc71;
        border: 3px solid white;
        border-radius: 50%;
    }

    /* الأزرار */
    .btn-profile {
        background: linear-gradient(135deg, #1eb2a6 0%, #15938a 100%);
        color: white;
        border-radius: 20px;
        padding: 12px 25px;
        font-weight: 700;
        border: none;
        transition: 0.3s;
        width: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
    }

    .btn-profile:hover {
        box-shadow: 0 10px 20px rgba(30, 178, 166, 0.3);
        transform: scale(1.02);
        color: white;
    }

    .specialty-tag {
        background: rgba(30, 178, 166, 0.08);
        color: #114b4d;
        padding: 5px 15px;
        border-radius: 50px;
        font-size: 0.85rem;
        font-weight: 600;
        display: inline-block;
        margin-bottom: 20px;
    }

    .hero-title {
        padding: 60px 0 40px;
        text-align: center;
    }

    .hero-title h1 {
        font-weight: 800;
        color: #2c3e50;
    }
</style>

<div class="container-fluid p-0 text-end" dir="rtl">

    

    <div class="container">
        <div class="hero-title">
            <h1 class="mb-2">نخبة الأساتذة</h1>
            <p class="text-muted fs-5">استكشف طاقم التدريس لمادة <span class="text-turquoise fw-bold">@ViewBag.SubjectName</span></p>
        </div>

        <div class="row g-4 pb-5">
            @if (Model != null && Model.Any())
            {
                var uniqueTeachers = Model.GroupBy(l => l.teacher_id).Select(g => g.First());

                foreach (var item in uniqueTeachers)
                {
                    <div class="col-md-6 col-lg-4">
                        <div class="teacher-card shadow-sm h-100">
                            <div class="teacher-avatar-wrapper shadow-sm">
                                <img src="https://ui-avatars.com/api/?name=@(item.Teacher?.User?.first_name)+@(item.Teacher?.User?.last_name)&background=f0fdfc&color=1eb2a6&size=128"
                                     alt="أستاذ">
                                <div class="status-badge"></div>
                            </div>

                            <h3 class="fw-bold text-dark mb-1">أ. @item.Teacher?.User?.first_name @item.Teacher?.User?.last_name</h3>
                            <div class="specialty-tag">متخصص في @ViewBag.SubjectName</div>
                            
                            <p class="text-muted small mb-4 px-3">
                                متخصص في تقديم شرح مبسط وحل تمارين تفاعلية لضمان تفوقك الدراسي.
                            </p>

                            <div class="border-top pt-4">
                                <a href="@Url.Action("TeacherProfile", "Student", new { teacherId = item.teacher_id, subjectId = item.subject_id })"
                                   class="btn btn-profile">
                                    <span>الملف الشخصي والحجز</span>
                                    <i class="bi bi-arrow-left-circle"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="col-12 text-center py-5">
                    <div class="p-5 bg-white rounded-5 shadow-sm border border-dashed d-inline-block">
                        <i class="bi bi-person-exclamation text-turquoise display-1 mb-3"></i>
                        <h4 class="text-dark fw-bold">نعتذر، لا يوجد أساتذة متاحون حالياً</h4>
                        <p class="text-muted">سيتم إضافة طاقم التدريس لهذه المادة قريباً جداً.</p>
                        <a href="/Student/SelectSubject" class="btn btn-turquoise rounded-pill px-5 mt-3">العودة للمواد</a>
                    </div>
                </div>
            }
        </div>
    </div>
</div>