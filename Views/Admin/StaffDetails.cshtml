@model EduPsych_Web.Models.User

@{

    Layout = "_AdminLayout";

    ViewData["Title"] = "ملف العضو المالي";

    var eduSessions = ViewBag.EduSessions as List<EduPsych_Web.Models.EducationalSession>;

    var psychSessions = ViewBag.PsychSessions as List<EduPsych_Web.Models.CounselSession>;

}



<style>

    :root {
        --brand-teal: #1eb2a6;
        --brand-dark: #0f172a;
    }



    /* كارت الموظف الأساسي */

    .staff-hero-card {
        background: var(--brand-dark);
        border-radius: 24px;
        color: white;
        border: none;
        position: relative;
        overflow: hidden;
    }



        .staff-hero-card::before {
            content: "";
            position: absolute;
            top: 0;
            right: 0;
            width: 100%;
            height: 100%;
            background: radial-gradient(circle at top right, rgba(30, 178, 166, 0.15), transparent);
        }



    /* كروت المحفظة المالية */

    .wallet-card {
        background: var(--brand-teal);
        border-radius: 20px;
        color: white;
        transition: 0.3s;
    }

    

        .wallet-card:hover {
            transform: translateY(-5px);
        }



    .stat-mini-card {
        background: white;
        border-radius: 20px;
        border: 1px solid #f1f5f9;
        transition: 0.3s;
    }



    /* التبويبات الحديثة */

    .nav-pills-modern {
        background: #f1f5f9;
        padding: 5px;
        border-radius: 15px;
        display: inline-flex;
    }

        .nav-pills-modern .nav-link {
            border-radius: 12px;
            padding: 10px 25px;
            color: #64748b;
            font-weight: 700;
            transition: 0.3s;
        }

            .nav-pills-modern .nav-link.active {
                background: white !important;
                color: var(--brand-teal) !important;
                box-shadow: 0 4px 10px rgba(0,0,0,0.05);
            }



    /* الجداول */

    .sessions-table thead th {
        background: #f8fafc;
        border: none;
        font-size: 0.75rem;
        font-weight: 800;
        color: #475569;
        padding: 1rem;
    }



    .status-badge {
        font-size: 0.7rem;
        padding: 6px 12px;
        border-radius: 8px;
        font-weight: 700;
    }

</style>



<div class="container-fluid py-4" dir="rtl">

    

    <div class="row g-4 mb-4">

        <div class="col-lg-7">

            <div class="card staff-hero-card shadow-lg h-100">

                <div class="card-body p-4 d-flex flex-column justify-content-center">

                    <div class="d-flex align-items-center mb-3">

                        <img src="https://ui-avatars.com/api/?name=@Model.first_name+@Model.last_name&background=1eb2a6&color=fff&bold=true&size=100"
                             class="rounded-3 border border-3 border-white shadow-sm" width="70">

                        <div class="ms-3">

                            <h2 class="fw-900 mb-0">@Model.first_name @Model.last_name</h2>

                            <p class="text-white-50 mb-0 fw-bold small">

                                <i class="bi bi-shield-check me-1 text-teal"></i>

                                @(Model.Role?.name ?? "عضو الطاقم") | الرقم الوظيفي: #STAFF-@Model.id

                            </p>

                        </div>

                    </div>

                    <div class="d-flex gap-3 mt-2">

                        <span class="badge bg-white bg-opacity-10 rounded-pill px-3 py-2 small"><i class="bi bi-envelope me-1"></i> @Model.email</span>

                        <span class="badge bg-white bg-opacity-10 rounded-pill px-3 py-2 small"><i class="bi bi-telephone me-1"></i> متصل</span>

                    </div>

                </div>

            </div>

        </div>



        <div class="col-lg-5">

            <div class="card wallet-card border-0 shadow-lg h-100">

                <div class="card-body p-4 d-flex flex-column justify-content-between">

                    <div class="d-flex justify-content-between align-items-start">

                        <div>

                            <h6 class="fw-bold opacity-75 mb-1 small text-uppercase">مستحقات الموظف (50%)</h6>
                            <h1 class="fw-900 mb-0">@ViewBag.StaffEarnings.ToString("N0") <small class="fs-6">دج</small></h1>

                        </div>

                        <i class="bi bi-wallet2 fs-1 opacity-25"></i>

                    </div>

                    <div class="mt-4 pt-3 border-top border-white border-opacity-10">

                        <div class="d-flex justify-content-between align-items-center small">

                            <span>الحالة المالية للطلب:</span>

                            <span class="stat-mini-card text-teal fw-900">جاهز للسحب</span>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>



    <div class="row g-3 mb-4">

        <div class="col-md-6">

            <div class="card stat-mini-card shadow-sm p-3">

                <div class="d-flex align-items-center">

                    <div class="icon-box bg-success-subtle text-success rounded-3 p-3 me-3">

                        <i class="bi bi-graph-up-arrow fs-5"></i>

                    </div>

                    <div>

                        <p class="text-muted small fw-bold mb-0">إجمالي ربح الحصص الكلي</p>

                        <h5 class="fw-900 mb-0 text-dark">@ViewBag.TotalSales.ToString("N0") دج</h5>

                    </div>

                </div>

            </div>

        </div>

        <div class="col-md-6">

            <div class="card stat-mini-card shadow-sm p-3">

                <div class="d-flex align-items-center">

                    <div class="icon-box bg-warning-subtle text-warning rounded-3 p-3 me-3">

                        <i class="bi bi-percent fs-5"></i>

                    </div>

                    <div>

                        <p class="text-muted small fw-bold mb-0">حصة المنصة (50%)</p>

                        <h5 class="fw-900 mb-0 text-dark">@ViewBag.NetProfit.ToString("N0") دج</h5>

                    </div>

                </div>

            </div>

        </div>

    </div>



    <div class="card border-0 shadow-sm rounded-4">

        <div class="card-header bg-white py-4 px-4 border-0">

            <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">

                <div class="nav nav-pills-modern" id="pills-tab" role="tablist">

                    <button class="nav-link active" data-bs-toggle="pill" data-bs-target="#pills-history">سجل الجلسات</button>

                    <button class="nav-link" data-bs-toggle="pill" data-bs-target="#pills-stats">ملخص الأداء</button>

                </div>

                <div class="d-flex gap-2">

                    <a asp-action="StaffList" class="btn btn-sm btn-teal-light text-teal rounded-pill px-3 fw-bold" style="background:#f0fdfa">العودة للطاقم</a>

                </div>

            </div>

        </div>



        <div class="card-body p-0">

            <div class="tab-content">

                <div class="tab-pane fade show active" id="pills-history">

                    <div class="table-responsive">

                        <table class="table table-hover sessions-table align-middle text-end mb-0">

                            <thead>

                                <tr>

                                    <th class="px-4">نوع الجلسة</th>

                                    <th>التلميذ</th>

                                    <th>الموضوع</th>

                                    <th>التاريخ والوقت</th>

                                    <th class="text-center">الحالة</th>

                                </tr>

                            </thead>

                            <tbody>

                                @* عرض جلسات الأساتذة *@

                                @if (eduSessions != null)

                                {

                                    foreach (var s in eduSessions)

                                    {

                                        <tr>

                                            <td class="px-4"><span class="badge rounded-pill bg-info-subtle text-info px-3">تعليمية</span></td>

                                            <td class="fw-bold small text-dark">@s.Student?.User?.first_name @s.Student?.User?.last_name</td>

                                            <td class="small text-muted">@s.Lesson?.title</td>

                                            <td class="small">@s.scheduled_at.ToString("yyyy-MM-dd | HH:mm")</td>

                                            <td class="text-center">

                                                <span class="status-badge @(s.status == "Completed" ? "bg-success-subtle text-success" : "bg-warning-subtle text-warning")">

                                                    <i class="bi @(s.status == "Completed" ? "bi-check-circle-fill" : "bi-clock-history") me-1"></i> @s.status

                                                </span>

                                            </td>

                                        </tr>

                                    }

                                }

                                

                                @* عرض جلسات المرشدين *@

                                @if (psychSessions != null)

                                {

                                    foreach (var p in psychSessions)

                                    {

                                        <tr>

                                            <td class="px-4"><span class="badge rounded-pill px-3 text-white" style="background-color: #7c3aed;">نفسية</span></td>

                                            <td class="fw-bold small text-dark">@p.Student?.User?.first_name @p.Student?.User?.last_name</td>

                                            <td class="small text-muted">جلسة إرشاد خاصة</td>

                                            <td class="small">@p.scheduled_at.ToString("yyyy-MM-dd | HH:mm")</td>

                                            <td class="text-center">

                                                <span class="status-badge @(p.status == "Completed" || p.status == "Confirmed" ? "bg-success-subtle text-success" : "bg-warning-subtle text-warning")">

                                                    <i class="bi @(p.status == "Completed" || p.status == "Confirmed" ? "bi-check-circle-fill" : "bi-clock-history") me-1"></i> @p.status

                                                </span>

                                            </td>

                                        </tr>

                                    }

                                }

                            </tbody>

                        </table>

                    </div>

                </div>



                <div class="tab-pane fade" id="pills-stats">

                    <div class="text-center py-5">

                        <i class="bi bi-activity fs-1 text-teal opacity-25"></i>

                        <h6 class="mt-3 text-muted">إحصائيات الأداء البيانية قيد المعالجة..</h6>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>