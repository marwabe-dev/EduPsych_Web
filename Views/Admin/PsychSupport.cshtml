@using EduPsych_Web.Models
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "مركز الدعم النفسي";
    var counselors = ViewBag.CounselorsStats as IEnumerable<dynamic>;
    decimal totalDepartmentRevenue = counselors?.Sum(x => (decimal)x.Revenue) ?? 0;
    int totalSessions = counselors?.Sum(x => (int)x.SessionCount) ?? 0;
}

<style>
    :root {
        --brand-teal: #1eb2a6;
        --brand-dark: #0f172a;
        --brand-purple: #7c3aed;
    }

    /* الكروت العلوية */
    .stat-card-modern {
        border: none;
        border-radius: 20px;
        background: white;
        transition: 0.3s;
    }
    .stat-card-modern:hover { transform: translateY(-5px); box-shadow: 0 10px 25px rgba(0,0,0,0.05) !important; }

    .icon-circle {
        width: 50px; height: 50px;
        border-radius: 14px;
        display: flex; align-items: center; justify-content: center;
        color: white;
    }

    /* جدول التقييم */
    .ranking-table thead th {
        background: #f8fafc;
        border: none;
        color: #64748b;
        font-size: 0.75rem;
        text-transform: uppercase;
        padding: 1.25rem 1rem;
    }

    .progress-custom {
        height: 7px;
        border-radius: 10px;
        background: #f1f5f9;
        overflow: hidden;
    }

    .badge-top-seller {
        background: rgba(30, 178, 166, 0.1);
        color: var(--brand-teal);
        border: 1px solid rgba(30, 178, 166, 0.2);
        font-weight: 700;
        font-size: 0.7rem;
    }

    .badge-active {
        background: rgba(124, 58, 237, 0.1);
        color: var(--brand-purple);
        border: 1px solid rgba(124, 58, 237, 0.2);
    }
</style>

<div class="container-fluid py-4" dir="rtl">
    
    <div class="row mb-4 align-items-center">
        <div class="col-md-7">
            <h3 class="fw-900 text-dark mb-1">مركز الدعم النفسي</h3>
            <p class="text-muted small">متابعة الأداء المالي وجودة الجلسات الإرشادية.</p>
        </div>
        <div class="col-md-5 text-start">
            <a asp-action="DownloadReport" asp-controller="Admin" class="btn btn-dark rounded-pill px-4 shadow-sm fw-bold btn-sm">
                <i class="bi bi-file-earmark-excel me-1"></i> تحميل التقرير الشامل
            </a>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-xl-4 col-md-6">
            <div class="card stat-card-modern shadow-sm p-3">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <p class="text-muted small fw-bold mb-1">إجمالي المبيعات</p>
                        <h4 class="fw-900 mb-0">@totalDepartmentRevenue.ToString("N0") <small class="fs-6">دج</small></h4>
                    </div>
                    <div class="icon-circle shadow-lg" style="background: linear-gradient(135deg, #1eb2a6 0%, #149187 100%);">
                        <i class="bi bi-currency-exchange fs-4"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-4 col-md-6">
            <div class="card stat-card-modern shadow-sm p-3">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <p class="text-muted small fw-bold mb-1">إجمالي الجلسات</p>
                        <h4 class="fw-900 mb-0">@totalSessions <small class="fs-6 opacity-50">جلسة</small></h4>
                    </div>
                    <div class="icon-circle shadow-lg" style="background: linear-gradient(135deg, #7c3aed 0%, #5b21b6 100%);">
                        <i class="bi bi-chat-heart fs-4"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-4 col-md-12">
            <div class="card stat-card-modern shadow-sm p-3 border-start border-warning border-4">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <p class="text-muted small fw-bold mb-1">متوسط العائد/الجلسة</p>
                        <h4 class="fw-900 mb-0 text-warning">
                            @(totalSessions > 0 ? (totalDepartmentRevenue / totalSessions).ToString("N0") : "0") <small class="fs-6 text-dark">دج</small>
                        </h4>
                    </div>
                    <div class="icon-circle bg-light text-warning">
                        <i class="bi bi-graph-up-arrow fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card rounded-4 border-0 shadow-sm overflow-hidden">
        <div class="card-header bg-white border-0 py-4 px-4 d-flex justify-content-between align-items-center">
            <h6 class="fw-900 mb-0"><i class="bi bi-trophy-fill text-warning me-2"></i> تصنيف أداء المرشدين</h6>
            <div class="dropdown">
                <button class="btn btn-light btn-sm rounded-pill px-3 dropdown-toggle small" type="button" data-bs-toggle="dropdown">
                    ترتيب حسب المبيعات
                </button>
            </div>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 ranking-table text-end">
                <thead>
                    <tr>
                        <th class="px-4">المرشد</th>
                        <th>عدد الجلسات</th>
                        <th>الأرباح المحققة</th>
                        <th style="width: 200px;">قوة الأداء (Score)</th>
                        <th class="text-center">الوضعية</th>
                    </tr>
                </thead>
                <tbody>
                    @if (counselors != null && counselors.Any())
                    {
                        foreach (var c in counselors)
                        {
                            <tr>
                                <td class="px-4">
                                    <div class="d-flex align-items-center">
                                        <img src="https://ui-avatars.com/api/?name=@c.FullName&background=f1f5f9&color=0f172a&bold=true" 
                                             class="rounded-circle ms-3 border" width="35">
                                        <div>
                                            <h6 class="mb-0 small fw-900">@c.FullName</h6>
                                            <span class="text-muted" style="font-size: 0.65rem;">مستشار نفسي معتمد</span>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <span class="fw-bold text-dark small">@c.SessionCount</span>
                                </td>
                                <td>
                                    <span class="fw-900 text-teal small">@c.Revenue.ToString("N0") دج</span>
                                </td>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <div class="progress progress-custom w-100 ms-2">
                                            <div class="progress-bar" role="progressbar" 
                                                 style="width: @(Math.Min(100, (double)c.FinalScore))%; background-color: var(--brand-teal);"></div>
                                        </div>
                                        <span class="small fw-bold text-muted">@(Math.Min(100, (double)c.FinalScore).ToString("F0"))%</span>
                                    </div>
                                </td>
                                <td class="text-center">
                                    @if (c.Revenue > 5000 || c.SessionCount > 15)
                                    {
                                        <span class="badge rounded-pill badge-top-seller px-3 py-2">
                                            <i class="bi bi-star-fill me-1"></i> الأكثر مبيعاً
                                        </span>
                                    }
                                    else if (c.SessionCount > 0)
                                    {
                                        <span class="badge rounded-pill badge-active px-3 py-2">
                                            نشط
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge rounded-pill bg-light text-muted border px-3 py-2">
                                            منضم حديثاً
                                        </span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center py-5">
                                <i class="bi bi-clipboard-x fs-1 text-muted opacity-25"></i>
                                <p class="text-muted mt-2 small">لا توجد بيانات للمرشدين في الفترة الحالية.</p>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>